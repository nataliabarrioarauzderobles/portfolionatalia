---
// EL DIBUJO QUE SE LLENA + LO QUE HAGO (home, debajo del retrato). Inspirado en el scroll de ottoobjects.com.
// Al bajar, el dibujo de línea se queda fijo y sus manchas se van rellenando una a una, de arriba abajo
// (cabeza, espalda, brazo, cuerpo, bota) hasta la versión de contraste, en gris carbón.
// A la vez, el dibujo se aparta a la izquierda y a la derecha aparece, línea a línea, lo que hago,
// con un enlace claro a cada sección: diseño (identidades), encargos (cuadros) y arte para espacios (con Pablo).
// En el móvil, el dibujo se hace pequeño y sube, y el texto aparece debajo.
import { getImage } from 'astro:assets';
import type { Idioma } from '../i18n/textos';
import { rutaIdioma } from '../utils/enlaces';
import { imagen } from '../utils/imagenes';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;

const tx = {
  es: {
    entrada: 'Pinto y diseño. Esto es lo que puedo hacer por ti:',
    lineas: [
      { titulo: 'Identidad para marcas', texto: 'Logotipo, packaging y todo lo que hace reconocible a una marca.', enlace: rutaIdioma(idioma, 'diseno') },
      { titulo: 'Cuadros por encargo', texto: 'Una pieza única, pintada a mano, pensada para tu espacio.', enlace: rutaIdioma(idioma, 'encargos') },
      { titulo: 'Arte para espacios', texto: 'Junto a Pablo Barrio, pintor y escultor: propuestas para hoteles, restaurantes e inmobiliarias.', enlace: rutaIdioma(idioma, 'colaboremos') },
    ],
  },
  en: {
    entrada: 'I paint and design. This is what I can do for you:',
    lineas: [
      { titulo: 'Brand identity', texto: 'Logo, packaging and everything that makes a brand recognisable.', enlace: rutaIdioma(idioma, 'diseno') },
      { titulo: 'Commissioned paintings', texto: 'A one-off piece, painted by hand, made for your space.', enlace: rutaIdioma(idioma, 'encargos') },
      { titulo: 'Art for spaces', texto: 'With painter and sculptor Pablo Barrio: proposals for hotels, restaurants and real estate.', enlace: rutaIdioma(idioma, 'colaboremos') },
    ],
  },
}[idioma];

const linea = imagen('inicio/dibujo-linea.jpg');
// posición de cada mancha en % del dibujo, de arriba abajo
const cajas = [
  { x: 35.242, y: 0, w: 20.088, h: 13.35 },
  { x: 43.26, y: 12.45, w: 23.877, h: 18.6 },
  { x: 0, y: 25.5, w: 25.639, h: 13.25 },
  { x: 48.458, y: 38.2, w: 44.67, h: 31.95 },
  { x: 22.643, y: 81.9, w: 29.956, h: 15.6 },
];
const ancho = 1100; // px de la imagen servida
const fondo = await getImage({ src: linea, width: ancho, format: 'webp' });
const manchas = await Promise.all(cajas.map(async (c, i) => {
  const img = imagen(`inicio/dibujo-mancha-${i + 1}.png`);
  const src = (await getImage({ src: img, width: Math.round((ancho * c.w) / 100), format: 'webp' })).src;
  return { ...c, src };
}));
---

<section class="dibujo" data-dibujo>
  <div class="escena">
    <div class="mover">
      <figure class="lienzo" style={`aspect-ratio:${linea.width} / ${linea.height}`}>
        <img class="linea" src={fondo.src} alt="Dibujo de dos figuras, de Natalia Barrio" loading="lazy" decoding="async" />
        {manchas.map((m) => (
          <img class="mancha" src={m.src} alt="" loading="lazy" decoding="async" style={`left:${m.x}%;top:${m.y}%;width:${m.w}%;height:${m.h}%`} data-mancha />
        ))}
      </figure>
    </div>

    <div class="oferta">
      <p class="entrada" data-aparece-lo>{tx.entrada}</p>
      <ul>
        {tx.lineas.map((l) => (
          <li data-aparece-lo>
            <a href={l.enlace} target={l.fuera ? '_blank' : undefined} rel={l.fuera ? 'noopener' : undefined}>
              <strong>{l.titulo} <span class="flecha" aria-hidden="true">{l.fuera ? '↗' : '→'}</span></strong>
              <span class="texto">{l.texto}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* el dibujo se queda fijo mientras se baja unas tres pantallas y media */
  .dibujo { position: relative; height: 360svh; --m: 0; }
  .escena { position: sticky; top: 0; height: 100svh; display: grid; place-items: center; padding-top: 72px; box-sizing: border-box; overflow: hidden; }
  /* el dibujo se aparta a la izquierda según --m (0 → 1) */
  .mover { transform: translateX(calc(var(--m) * -19vw)); will-change: transform; }
  .lienzo { position: relative; margin: 0; width: min(88vw, calc((100svh - 130px) * 0.5675), 510px); }
  .linea { display: block; width: 100%; height: 100%; }
  /* cada mancha se llena de arriba abajo con un borde suave, según --t (0 → 1) */
  .mancha {
    position: absolute;
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(var(--t, 0) * 140% - 40%), transparent calc(var(--t, 0) * 140%));
    mask-image: linear-gradient(to bottom, #000 calc(var(--t, 0) * 140% - 40%), transparent calc(var(--t, 0) * 140%));
  }

  /* LO QUE HAGO, a la derecha */
  .oferta { position: absolute; left: 53vw; top: 50%; width: min(34vw, 430px); transform: translateY(-40%); }
  .entrada { margin: 0 0 1.8rem; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.02em; color: var(--texto-tenue); }
  .oferta ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.3rem; }
  .oferta a { display: grid; gap: 0.3rem; color: var(--texto); }
  .oferta strong { font-weight: 400; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.02em; line-height: 1.3; }
  .flecha { display: inline-block; font-weight: 400; transition: transform 0.3s ease; }
  .texto { font-size: 0.86rem; line-height: 1.6; color: var(--texto-tenue); }
  .oferta a strong { transition: color 0.25s ease; }
  .oferta a:hover strong, .oferta a:focus-visible strong { color: var(--texto-tenue); }
  .oferta a:hover .flecha { transform: translateX(4px); }
  /* aparecen línea a línea (lo controla el script); sin JavaScript se ven directamente */
  :global(.js) [data-aparece-lo] { opacity: 0; transform: translateY(12px); transition: opacity 0.6s ease, transform 0.6s ease; }
  :global(.js) [data-aparece-lo].visto { opacity: 1; transform: none; }

  /* MÓVIL: el dibujo se encoge y sube; el texto, debajo */
  @media (max-width: 760px) {
    .escena { padding-top: 110px; place-items: start center; }
    .mover { transform: scale(calc(1 - var(--m) * 0.32)); transform-origin: top center; }
    .lienzo { width: min(80vw, calc((100svh - 160px) * 0.5675)); }
    .oferta { left: var(--margen); right: var(--margen); width: auto; top: auto; bottom: 4svh; transform: none; }
    .entrada { margin-bottom: 1rem; }
    .oferta ul { gap: 0.9rem; }
    .texto { font-size: 0.78rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mover { transform: none !important; }
    :global(.js) [data-aparece-lo] { transform: none; }
  }
</style>

<script>
  const seccion = document.querySelector<HTMLElement>('[data-dibujo]');
  if (seccion) {
    const manchas = [...seccion.querySelectorAll<HTMLElement>('[data-mancha]')];
    const textos = [...seccion.querySelectorAll<HTMLElement>('[data-aparece-lo]')];
    const tramo = (x: number, a: number, b: number) => Math.min(1, Math.max(0, (x - a) / (b - a)));
    const suave = (x: number) => x * x * (3 - 2 * x);
    let pendiente = false;
    const pintar = () => {
      pendiente = false;
      const r = seccion.getBoundingClientRect();
      const recorrido = r.height - window.innerHeight; // lo que dura el dibujo fijo
      const p = Math.min(1, Math.max(0, -r.top / recorrido));
      // las manchas: cada una tiene su turno, solapándose un poco con la siguiente
      manchas.forEach((m, i) => {
        const inicio = 0.04 + i * 0.12;
        m.style.setProperty('--t', tramo(p, inicio, inicio + 0.18).toFixed(4));
      });
      // el dibujo se aparta mientras se llena
      seccion.style.setProperty('--m', suave(tramo(p, 0.06, 0.4)).toFixed(4));
      // el texto, línea a línea; al volver a subir, desaparece
      textos.forEach((t, i) => t.classList.toggle('visto', p > 0.2 + i * 0.09));
    };
    const pedir = () => { if (!pendiente) { pendiente = true; requestAnimationFrame(pintar); } };
    window.addEventListener('scroll', pedir, { passive: true });
    window.addEventListener('resize', pedir);
    pintar();
  }
</script>
