---
// "CREA TU PIEZA": diseño personalizado en tres pasos, pensado para que se entienda a la primera.
//  0. Presentación: "Ahora puedes hacer tu propio diseño" y los 3 pasos.
//  1. Escoge un modelo (tus dibujos, o dibuja tu propia silueta).
//  2. Píntalo: tocas un color y después la zona. Sin recuadros: la pieza sola sobre blanco.
//  3. Tu pieza: un prototipo 3D en madera (como las piezas reales) que se puede girar,
//     y el envío por WhatsApp con la medida y tu idea.
import { coloresPieza } from '../data/proyectos';
import type { Idioma } from '../i18n/textos';
import { contacto } from '../utils/enlaces';
import { imagen } from '../utils/imagenes';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;

const tx = {
  es: {
    etiqueta: 'Diseño personalizado',
    titulo: 'Ahora puedes crear tu propia pieza',
    intro: 'Piezas de madera pintadas a mano, como las que ves en esta página. Diséñala tú en tres pasos y te la hago.',
    pasos: [
      { titulo: 'Escoge un modelo', texto: 'Ojos, labios… o dibuja tu propia forma.' },
      { titulo: 'Píntala', texto: 'Toca un color y después la zona que quieras pintar.' },
      { titulo: 'Mándame tu idea', texto: 'Mira cómo quedaría en madera y envíamela por WhatsApp.' },
    ],
    empezar: 'Empezar',
    modelo: 'Modelo', color: 'Color', pieza: 'Tu pieza',
    silueta: 'Dibuja la tuya',
    ayudaPintar: 'Toca un color y después una zona del dibujo.',
    ayudaDibujar: 'Dibuja el contorno con el dedo o el ratón. Cierra bien las formas y después píntalas.',
    sorprendeme: 'Sorpréndeme', deshacer: 'Deshacer', reiniciar: 'Empezar de nuevo',
    verPieza: 'Ver mi pieza en madera',
    asiQuedaria: 'Así quedaría tu pieza',
    girar: 'Gírala con el ratón o con el dedo.',
    cargando: 'Preparando tu pieza…',
    medida: 'Medida', idea: 'Tu idea (opcional)', placeholder: 'Para qué espacio es, si es un regalo…',
    enviar: 'Enviar mi diseño por WhatsApp', volver: 'Volver a pintar', descargar: 'Descargar imagen',
    ayudaEnvio: 'En el móvil se comparte la imagen; en el ordenador se descarga para que la adjuntes en WhatsApp.',
    saludo: 'Hola Natalia, he diseñado mi pieza en tu web:', colores: 'Colores', sinColores: 'sin pintar',
    adjunto: 'Te envío la imagen de mi pieza.',
  },
  en: {
    etiqueta: 'Custom design',
    titulo: 'Now you can create your own piece',
    intro: 'Hand-painted wooden pieces, like the ones on this page. Design yours in three steps and I will make it.',
    pasos: [
      { titulo: 'Choose a model', texto: 'Eyes, lips… or draw your own shape.' },
      { titulo: 'Paint it', texto: 'Tap a colour, then the area you want to paint.' },
      { titulo: 'Send me your idea', texto: 'See how it would look in wood and send it to me on WhatsApp.' },
    ],
    empezar: 'Start',
    modelo: 'Model', color: 'Colour', pieza: 'Your piece',
    silueta: 'Draw your own',
    ayudaPintar: 'Tap a colour, then an area of the drawing.',
    ayudaDibujar: 'Draw the outline with your finger or mouse. Close the shapes, then paint them.',
    sorprendeme: 'Surprise me', deshacer: 'Undo', reiniciar: 'Start again',
    verPieza: 'See my piece in wood',
    asiQuedaria: 'This is how your piece would look',
    girar: 'Turn it with your mouse or finger.',
    cargando: 'Preparing your piece…',
    medida: 'Size', idea: 'Your idea (optional)', placeholder: 'The space it is for, if it is a gift…',
    enviar: 'Send my design on WhatsApp', volver: 'Back to painting', descargar: 'Download image',
    ayudaEnvio: 'On mobile the image is shared; on a computer it is downloaded so you can attach it on WhatsApp.',
    saludo: 'Hi Natalia, I designed my piece on your website:', colores: 'Colours', sinColores: 'not painted',
    adjunto: 'I am sending you the image of my piece.',
  },
}[idioma];

// tus dibujos (src/assets/diseno/personaliza, preparados a 1200 × 900 con la línea engordada)
const dibujos = [
  { id: 'ojo-pestanas', archivo: 'diseno/personaliza/ojo-pestanas.png', nombre: { es: 'Ojo de pestañas', en: 'Lash eye' } },
  { id: 'ojo-ondas', archivo: 'diseno/personaliza/ojo-ondas.png', nombre: { es: 'Ojo de ondas', en: 'Wave eye' } },
  { id: 'labios-sonrisa', archivo: 'diseno/personaliza/labios-sonrisa.png', nombre: { es: 'Labios', en: 'Lips' } },
  { id: 'ojo-rayos', archivo: 'diseno/personaliza/ojo-rayos.png', nombre: { es: 'Ojo de rayos', en: 'Ray eye' } },
  { id: 'ojo-ventanas', archivo: 'diseno/personaliza/ojo-ventanas.png', nombre: { es: 'Ojo de ventanas', en: 'Window eye' } },
  { id: 'ojo-petalos', archivo: 'diseno/personaliza/ojo-petalos.png', nombre: { es: 'Ojo de pétalos', en: 'Petal eye' } },
  { id: 'ojo-nube', archivo: 'diseno/personaliza/ojo-nube.png', nombre: { es: 'Ojo de nube', en: 'Cloud eye' } },
  { id: 'ojo-laberinto', archivo: 'diseno/personaliza/ojo-laberinto.png', nombre: { es: 'Ojo laberinto', en: 'Maze eye' } },
  { id: 'labios', archivo: 'diseno/personaliza/labios.png', nombre: { es: 'Labios cerrados', en: 'Closed lips' } },
];
const modelos = dibujos.map((m) => ({ id: m.id, src: imagen(m.archivo).src, nombre: m.nombre[idioma] }));
const colores = coloresPieza.map((c) => ({ hex: c.hex, nombre: c.nombre[idioma] }));
const medidas = [30, 50, 80];
---

<section class="personaliza" data-personaliza data-numero={contacto.whatsapp} data-textos={JSON.stringify(tx)} data-colores={JSON.stringify(colores)}>

  <!-- 0. PRESENTACIÓN -->
  <div class="etapa presentacion" data-etapa="presentacion">
    <p class="mono etiqueta">{tx.etiqueta}</p>
    <h2>{tx.titulo}</h2>
    <p class="intro">{tx.intro}</p>
    <ol class="tres-pasos">
      {tx.pasos.map((p, i) => (
        <li style={`--i:${i}`}>
          <span class="mono">{String(i + 1).padStart(2, '0')}</span>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </li>
      ))}
    </ol>
    <button type="button" class="boton boton-principal" data-ir="editor">{tx.empezar} →</button>
  </div>

  <!-- 1 y 2. MODELO Y COLOR -->
  <div class="etapa editor" data-etapa="editor" hidden>
    <ol class="progreso mono" aria-hidden="true">
      <li class="hecho">01 {tx.modelo}</li><li class="hecho">02 {tx.color}</li><li>03 {tx.pieza}</li>
    </ol>

    <ul class="modelos" role="group" aria-label={tx.modelo}>
      {modelos.map((m, i) => (
        <li>
          <button type="button" data-modelo={m.id} data-src={m.src} data-nombre={m.nombre} aria-pressed={i === 0 ? 'true' : 'false'}>
            <img src={m.src} alt="" width="120" height="90" loading="lazy" />
            <span>{m.nombre}</span>
          </button>
        </li>
      ))}
      <li>
        <button type="button" data-modelo="silueta" data-nombre={tx.silueta} aria-pressed="false">
          <svg viewBox="0 0 40 30" aria-hidden="true"><path d="M7 21c2-9 8-14 14-13s10 6 9 10-6 5-11 3-8-1-12 0" fill="none" stroke="currentColor" stroke-width="1.1" stroke-dasharray="2 2.2" /></svg>
          <span>{tx.silueta}</span>
        </button>
      </li>
    </ul>

    <!-- el dibujo, sin recuadro -->
    <canvas width="1200" height="900" data-lienzo aria-label={tx.pieza}></canvas>
    <p class="ayuda" data-ayuda>{tx.ayudaPintar}</p>

    <!-- colores: muestras grandes, fáciles de tocar -->
    <div class="colores" role="group" aria-label={tx.color}>
      {colores.map((c, i) => (
        <button type="button" class="muestra" data-color={c.hex} data-nombre={c.nombre} style={`--c:${c.hex}`} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={c.nombre} title={c.nombre}></button>
      ))}
    </div>
    <p class="nombre-color mono" data-nombre-color>{colores[0].nombre}</p>

    <div class="acciones-editor mono">
      <button type="button" data-sorprendeme>✦ {tx.sorprendeme}</button>
      <button type="button" data-deshacer>{tx.deshacer}</button>
      <button type="button" data-reiniciar>{tx.reiniciar}</button>
    </div>

    <button type="button" class="boton boton-principal ver-pieza" data-ir="pieza">{tx.verPieza} →</button>
  </div>

  <!-- 3. TU PIEZA EN 3D Y ENVÍO -->
  <div class="etapa pieza" data-etapa="pieza" hidden>
    <ol class="progreso mono" aria-hidden="true">
      <li class="hecho">01 {tx.modelo}</li><li class="hecho">02 {tx.color}</li><li class="hecho">03 {tx.pieza}</li>
    </ol>
    <div class="pieza-cuerpo">
      <div class="vista-3d">
        <div class="escena-3d" data-escena3d><p class="cargando mono" data-cargando>{tx.cargando}</p></div>
        <p class="ayuda">{tx.girar}</p>
      </div>
      <div class="envio">
        <h3>{tx.asiQuedaria}</h3>
        <p class="mono etiqueta-campo">{tx.medida}</p>
        <div class="medidas" role="group" aria-label={tx.medida}>
          {medidas.map((m, i) => <button type="button" data-medida={m} aria-pressed={i === 1 ? 'true' : 'false'}>{m} cm</button>)}
        </div>
        <label class="campo">
          <span class="mono etiqueta-campo">{tx.idea}</span>
          <textarea rows="2" placeholder={tx.placeholder} data-idea></textarea>
        </label>
        <a class="boton boton-principal" href={`https://wa.me/${contacto.whatsapp}`} target="_blank" rel="noopener" data-enviar>{tx.enviar} →</a>
        <div class="acciones-pieza mono">
          <button type="button" data-ir="editor">← {tx.volver}</button>
          <button type="button" data-descargar>{tx.descargar}</button>
        </div>
        <p class="ayuda">{tx.ayudaEnvio}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .personaliza { max-width: 1100px; margin: 0 auto; }
  .etapa { animation: aparecerEtapa 0.5s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .etapa[hidden] { display: none; }
  @keyframes aparecerEtapa { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  .etiqueta { color: var(--texto-suave); margin: 0 0 0.9rem; }

  /* 0. PRESENTACIÓN */
  .presentacion { max-width: 760px; margin: clamp(1rem, 6vh, 4rem) auto 0; text-align: center; }
  .presentacion h2 { font-family: var(--fuente-titulos); font-weight: 400; font-size: clamp(1.8rem, 4vw, 3rem); letter-spacing: -0.02em; line-height: 1.05; margin: 0 0 1rem; }
  .intro { margin: 0 auto 3rem; max-width: 46ch; color: var(--texto-suave); font-size: 0.92rem; line-height: 1.7; }
  .tres-pasos { list-style: none; margin: 0 0 3rem; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 3vw, 2.5rem); text-align: left; }
  .tres-pasos li { border-top: 1px solid var(--texto); padding-top: 1rem; animation: aparecerEtapa 0.6s backwards; animation-delay: calc(150ms + var(--i) * 120ms); }
  .tres-pasos .mono { color: var(--texto-tenue); }
  .tres-pasos h3 { font-family: var(--fuente-titulos); font-weight: 400; font-size: 1.15rem; margin: 0.7rem 0 0.4rem; }
  .tres-pasos p { margin: 0; font-size: 0.84rem; line-height: 1.65; color: var(--texto-suave); }
  @media (max-width: 700px) { .tres-pasos { grid-template-columns: 1fr; gap: 1.4rem; } }

  /* progreso 01 · 02 · 03 */
  .progreso { list-style: none; display: flex; justify-content: center; gap: 1.6rem; margin: 0 0 1.6rem; padding: 0; color: var(--texto-tenue); }
  .progreso li.hecho { color: var(--texto); }

  /* 1. MODELOS: miniaturas de línea, en fila (se deslizan en el móvil) */
  .modelos { list-style: none; margin: 0 0 0.5rem; padding: 0 0 0.4rem; display: flex; gap: 0.6rem; justify-content: center; overflow-x: auto; scrollbar-width: none; }
  .modelos::-webkit-scrollbar { display: none; }
  .modelos li { flex: none; }
  .modelos button { display: grid; justify-items: center; gap: 0.35rem; width: 92px; padding: 0.4rem 0.2rem 0.5rem; border: 0; border-bottom: 1px solid transparent; background: none; cursor: pointer; color: var(--texto-suave); opacity: 0.5; transition: opacity 0.25s, border-color 0.25s; }
  .modelos button:hover { opacity: 1; }
  .modelos button[aria-pressed='true'] { opacity: 1; color: var(--texto); border-color: var(--texto); }
  .modelos img, .modelos svg { width: 72px; height: 54px; object-fit: contain; }
  .modelos span { font-size: 0.7rem; white-space: nowrap; }

  /* 2. EL DIBUJO: sin recuadro */
  canvas { display: block; width: min(100%, 760px); height: auto; aspect-ratio: 4 / 3; margin: 0 auto; touch-action: none; }
  .ayuda { margin: 0.4rem 0 0; text-align: center; font-size: 0.78rem; color: var(--texto-tenue); }

  /* COLORES: círculos grandes */
  .colores { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.7rem; margin: 1.6rem auto 0; max-width: 620px; }
  .muestra {
    width: 40px; height: 40px; border-radius: 50%; border: 0; padding: 0; cursor: pointer;
    background: var(--c); box-shadow: inset 0 0 0 1px rgba(0,0,0,0.1);
    outline: 1.5px solid transparent; outline-offset: 3px;
    transition: transform 0.2s ease, outline-color 0.2s;
  }
  .muestra:hover { transform: scale(1.1); }
  .muestra[aria-pressed='true'] { outline-color: var(--texto); transform: scale(1.1); }
  .nombre-color { text-align: center; margin: 0.8rem 0 0; color: var(--texto-suave); }
  @media (max-width: 700px) {
    /* en el móvil, una fila que se desliza con el dedo */
    .colores { flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; padding: 0.5rem 0.4rem; margin-top: 1rem; scrollbar-width: none; }
    .colores::-webkit-scrollbar { display: none; }
    .muestra { flex: none; width: 46px; height: 46px; }
  }

  .acciones-editor, .acciones-pieza { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem 1.4rem; margin-top: 1.4rem; }
  .acciones-editor button, .acciones-pieza button { padding: 0.2rem 0; border: 0; border-bottom: 1px solid transparent; background: none; font: inherit; color: var(--texto-suave); cursor: pointer; }
  .acciones-editor button:hover, .acciones-pieza button:hover { color: var(--texto); border-color: var(--texto); }
  .ver-pieza { display: block; margin: 2rem auto 0; }

  /* 3. TU PIEZA */
  .pieza-cuerpo { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(260px, 1fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: center; }
  @media (max-width: 800px) { .pieza-cuerpo { grid-template-columns: 1fr; } }
  .escena-3d { position: relative; width: 100%; aspect-ratio: 4 / 3; cursor: grab; touch-action: none; }
  .escena-3d:active { cursor: grabbing; }
  .escena-3d :global(canvas) { display: block; width: 100%; height: 100%; }
  .cargando { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; color: var(--texto-tenue); }
  .envio h3 { font-family: var(--fuente-titulos); font-weight: 400; font-size: clamp(1.4rem, 2.6vw, 2rem); letter-spacing: -0.02em; margin: 0 0 1.6rem; }
  .etiqueta-campo { display: block; color: var(--texto-suave); margin: 0 0 0.6rem; }
  .medidas { display: flex; gap: 0.4rem; margin-bottom: 1.4rem; }
  .medidas button { padding: 0.5rem 0.9rem; border: 1px solid var(--linea); border-radius: 999px; background: none; font: inherit; font-size: 0.84rem; color: var(--texto-suave); cursor: pointer; }
  .medidas button[aria-pressed='true'] { border-color: var(--texto); color: var(--texto); }
  .campo { display: block; margin-bottom: 1.6rem; }
  textarea { width: 100%; padding: 0.5rem 0; font: inherit; font-size: 0.88rem; resize: vertical; background: transparent; color: var(--texto); border: 0; border-bottom: 1px solid var(--linea); }
  textarea:focus { outline: none; border-color: var(--texto); }
  .envio .acciones-pieza { justify-content: flex-start; }
  .envio .ayuda { text-align: left; }
</style>

<script>
  // ─────────────────────────────────────────────────────────────
  // EL DIBUJO PARA COLOREAR
  //  · capa de líneas = dibujo del modelo (+ trazos a mano en "Dibuja la tuya")
  //  · cada zona cerrada de la capa de líneas recibe un número
  //  · los colores se guardan como "semilla" (el punto donde se tocó) + color
  // ─────────────────────────────────────────────────────────────
  type RGB = [number, number, number];
  type Relleno = { x: number; y: number; c: string };
  type Accion = { tipo: 'relleno' | 'trazo' | 'lote'; antes?: Relleno[] };

  const ANCHO = 1200, ALTO = 900, UMBRAL = 150, GROSOR = 5;
  const SIN_PINTAR = '#f4efe6'; // madera imprimada
  // combinaciones para "Sorpréndeme", inspiradas en las piezas reales:
  // la zona más grande (el blanco del ojo) en blanco, el borde de color, el iris y la pupila oscura
  const COMBINACIONES = [
    ['#ffffff', '#f2c94c', '#2e5aa8', '#1c1b1a'],
    ['#ffffff', '#2bb3c0', '#3fa9e0', '#1c1b1a'],
    ['#ffffff', '#3fa9e0', '#f2c94c', '#1f2d4f'],
    ['#ffffff', '#7b52ab', '#8fd1c2', '#1c1b1a'],
    ['#ffffff', '#d2402f', '#1c1b1a', '#f2c94c'],
    ['#ffffff', '#eeb4b7', '#3e8e5e', '#1c1b1a'],
    ['#ffffff', '#e9853b', '#2bb3c0', '#1c1b1a'],
  ];

  document.querySelectorAll<HTMLElement>('[data-personaliza]').forEach((raiz) => {
    const tx = JSON.parse(raiz.dataset.textos!);
    const paleta: { hex: string; nombre: string }[] = JSON.parse(raiz.dataset.colores!);
    const lienzo = raiz.querySelector<HTMLCanvasElement>('[data-lienzo]')!;
    const ctx = lienzo.getContext('2d')!;
    const ayuda = raiz.querySelector<HTMLElement>('[data-ayuda]')!;

    const capaLineas = Object.assign(document.createElement('canvas'), { width: ANCHO, height: ALTO });
    const cLineas = capaLineas.getContext('2d', { willReadFrequently: true })!;
    const capaPieza = Object.assign(document.createElement('canvas'), { width: ANCHO, height: ALTO });
    const cPieza = capaPieza.getContext('2d')!;
    const datosPieza = cPieza.createImageData(ANCHO, ALTO);
    let lineasPx = new Uint8ClampedArray(ANCHO * ALTO * 4);

    // ── estado ──
    let base: HTMLImageElement | null = null;
    let modelo = { id: '', nombre: '' };
    let trazos: [number, number][][] = [];
    let rellenos: Relleno[] = [];
    let historial: Accion[] = [];
    let dibujando = false;   // solo en "Dibuja la tuya"
    let color = paleta[0].hex;
    let medida = 50;
    let puntero: [number, number] | null = null;

    let zonas = new Int32Array(ANCHO * ALTO);
    let zonaFondo = -1;
    let areas: number[] = [];
    let semillas: [number, number][] = [];

    const hexARgb = (hex: string): RGB => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16)) as RGB;
    const nombreDe = (hex: string) => paleta.find((c) => c.hex.toLowerCase() === hex.toLowerCase())?.nombre ?? hex;

    // ── capa de líneas y zonas ──
    function reconstruirLineas() {
      cLineas.fillStyle = '#fff';
      cLineas.fillRect(0, 0, ANCHO, ALTO);
      if (base) cLineas.drawImage(base, 0, 0, ANCHO, ALTO);
      cLineas.strokeStyle = '#111';
      cLineas.lineWidth = GROSOR + 1;
      cLineas.lineCap = cLineas.lineJoin = 'round';
      for (const t of trazos) {
        cLineas.beginPath();
        t.forEach(([x, y], i) => (i ? cLineas.lineTo(x, y) : cLineas.moveTo(x, y)));
        if (t.length === 1) cLineas.lineTo(t[0][0] + 0.1, t[0][1]);
        cLineas.stroke();
      }
      lineasPx = cLineas.getImageData(0, 0, ANCHO, ALTO).data;
      calcularZonas();
    }

    function calcularZonas() {
      const px = lineasPx, N = ANCHO * ALTO;
      zonas = new Int32Array(N).fill(-2);
      for (let i = 0; i < N; i++) if (0.3 * px[i * 4] + 0.59 * px[i * 4 + 1] + 0.11 * px[i * 4 + 2] < UMBRAL) zonas[i] = -1;
      const pila = new Int32Array(N);
      areas = []; semillas = [];
      let n = 0;
      for (let inicio = 0; inicio < N; inicio++) {
        if (zonas[inicio] !== -2) continue;
        let tope = 0, area = 0;
        pila[tope++] = inicio; zonas[inicio] = n;
        while (tope) {
          const p = pila[--tope]; area++;
          const x = p % ANCHO;
          if (x > 0 && zonas[p - 1] === -2) { zonas[p - 1] = n; pila[tope++] = p - 1; }
          if (x < ANCHO - 1 && zonas[p + 1] === -2) { zonas[p + 1] = n; pila[tope++] = p + 1; }
          if (p >= ANCHO && zonas[p - ANCHO] === -2) { zonas[p - ANCHO] = n; pila[tope++] = p - ANCHO; }
          if (p < N - ANCHO && zonas[p + ANCHO] === -2) { zonas[p + ANCHO] = n; pila[tope++] = p + ANCHO; }
        }
        areas.push(area);
        semillas.push([(inicio % ANCHO) + 0.5, Math.floor(inicio / ANCHO) + 0.5]);
        n++;
      }
      zonaFondo = zonas[0]; // la zona que toca la esquina es el fondo: no se pinta
    }

    function zonaEn(x: number, y: number): number {
      const xi = Math.floor(x), yi = Math.floor(y);
      if (xi < 0 || yi < 0 || xi >= ANCHO || yi >= ALTO) return -1;
      let z = zonas[yi * ANCHO + xi];
      for (let r = 1; r < 9 && z === -1; r++) {
        for (const [dx, dy] of [[r, 0], [-r, 0], [0, r], [0, -r], [r, r], [-r, -r], [r, -r], [-r, r]]) {
          const xx = xi + dx, yy = yi + dy;
          if (xx < 0 || yy < 0 || xx >= ANCHO || yy >= ALTO) continue;
          const v = zonas[yy * ANCHO + xx];
          if (v >= 0) { z = v; break; }
        }
      }
      return z;
    }

    // colores por zona (el último relleno de cada zona manda)
    function coloresPorZona(vista?: Relleno) {
      const porZona = new Map<number, string>();
      for (const r of vista ? [...rellenos, vista] : rellenos) {
        const z = zonaEn(r.x, r.y);
        if (z >= 0 && z !== zonaFondo) porZona.set(z, r.c);
      }
      return porZona;
    }

    // la pieza: colores + líneas, con el fondo transparente
    function componerPieza(vista?: Relleno) {
      const porZona = coloresPorZona(vista);
      const rgb = new Map<number, RGB>();
      porZona.forEach((c, z) => rgb.set(z, hexARgb(c)));
      const madera = hexARgb(SIN_PINTAR);
      const d = datosPieza.data, l = lineasPx;
      for (let i = 0; i < ANCHO * ALTO; i++) {
        const z = zonas[i];
        const luz = (0.3 * l[i * 4] + 0.59 * l[i * 4 + 1] + 0.11 * l[i * 4 + 2]) / 255;
        if (z === zonaFondo) {
          d[i * 4] = d[i * 4 + 1] = d[i * 4 + 2] = 20; d[i * 4 + 3] = Math.round((1 - luz) * 255);
        } else {
          const c = (z >= 0 && rgb.get(z)) || madera;
          const k = Math.max(luz, 0.08);
          d[i * 4] = c[0] * k; d[i * 4 + 1] = c[1] * k; d[i * 4 + 2] = c[2] * k; d[i * 4 + 3] = 255;
        }
      }
      cPieza.putImageData(datosPieza, 0, 0);
    }

    function pintar(vista?: Relleno) {
      componerPieza(vista);
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, ANCHO, ALTO);
      ctx.save();
      ctx.shadowColor = 'rgba(0,0,0,0.10)';
      ctx.shadowBlur = 26;
      ctx.shadowOffsetY = 12;
      ctx.drawImage(capaPieza, 0, 0);
      ctx.restore();
    }
    let pendiente = false;
    function pintarPronto() {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        pendiente = false;
        const z = puntero ? zonaEn(puntero[0], puntero[1]) : -1;
        pintar(!dibujando && puntero && z >= 0 && z !== zonaFondo ? { x: puntero[0], y: puntero[1], c: color } : undefined);
      });
    }

    function cursor() {
      const svg = `<svg xmlns='http://www.w3.org/2000/svg' width='26' height='26'><circle cx='13' cy='13' r='8' fill='${color}' stroke='white' stroke-width='2'/><circle cx='13' cy='13' r='11' fill='none' stroke='%23111' stroke-width='1'/></svg>`.replace(/#/g, '%23').replace(/%2323/g, '%23');
      lienzo.style.cursor = dibujando ? 'crosshair' : `url("data:image/svg+xml,${svg}") 13 13, pointer`;
      ayuda.textContent = dibujando ? tx.ayudaDibujar : tx.ayudaPintar;
    }

    function cargarModelo(boton: HTMLButtonElement) {
      raiz.querySelectorAll('[data-modelo]').forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));
      modelo = { id: boton.dataset.modelo!, nombre: boton.dataset.nombre! };
      trazos = []; rellenos = []; historial = [];
      dibujando = modelo.id === 'silueta';
      cursor();
      if (dibujando) { base = null; reconstruirLineas(); pintar(); return; }
      const img = new Image();
      img.onload = () => { base = img; reconstruirLineas(); pintar(); };
      img.src = boton.dataset.src!;
    }

    // ── tocar y dibujar ──
    const posicion = (e: PointerEvent): [number, number] => {
      const r = lienzo.getBoundingClientRect();
      return [((e.clientX - r.left) / r.width) * ANCHO, ((e.clientY - r.top) / r.height) * ALTO];
    };
    let trazoActual: [number, number][] | null = null;
    lienzo.addEventListener('pointerdown', (e) => {
      const [x, y] = posicion(e);
      // en "Dibuja la tuya", si se toca dentro de una zona ya cerrada se pinta; si no, se dibuja
      const z = zonaEn(x, y);
      if (!dibujando || (z >= 0 && z !== zonaFondo && trazos.length > 0)) {
        if (z < 0 || z === zonaFondo) return;
        rellenos.push({ x, y, c: color });
        historial.push({ tipo: 'relleno' });
        return pintarPronto();
      }
      lienzo.setPointerCapture(e.pointerId);
      trazoActual = [[x, y]];
      trazos.push(trazoActual);
    });
    lienzo.addEventListener('pointermove', (e) => {
      puntero = e.pointerType === 'mouse' ? posicion(e) : null;
      if (trazoActual) {
        trazoActual.push(posicion(e));
        ctx.strokeStyle = '#111';
        ctx.lineWidth = GROSOR + 1;
        ctx.lineCap = 'round';
        const t = trazoActual, a = t[t.length - 2], b = t[t.length - 1];
        ctx.beginPath(); ctx.moveTo(a[0], a[1]); ctx.lineTo(b[0], b[1]); ctx.stroke();
        return;
      }
      pintarPronto();
    });
    lienzo.addEventListener('pointerleave', () => { puntero = null; pintarPronto(); });
    const terminarTrazo = () => {
      if (!trazoActual) return;
      trazoActual = null;
      historial.push({ tipo: 'trazo' });
      reconstruirLineas();
      pintarPronto();
    };
    lienzo.addEventListener('pointerup', terminarTrazo);
    lienzo.addEventListener('pointercancel', terminarTrazo);

    // ── controles ──
    raiz.querySelectorAll<HTMLButtonElement>('[data-modelo]').forEach((b) => b.addEventListener('click', () => cargarModelo(b)));
    const nombreColor = raiz.querySelector<HTMLElement>('[data-nombre-color]')!;
    raiz.querySelectorAll<HTMLButtonElement>('[data-color]').forEach((b) =>
      b.addEventListener('click', () => {
        color = b.dataset.color!;
        raiz.querySelectorAll('[data-color]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        nombreColor.textContent = b.dataset.nombre!;
        cursor();
      }),
    );
    raiz.querySelector('[data-sorprendeme]')!.addEventListener('click', () => {
      const combo = COMBINACIONES[Math.floor(Math.random() * COMBINACIONES.length)];
      const orden = areas.map((a, i) => ({ a, i })).filter((z) => z.i !== zonaFondo && z.a > 120).sort((p, q) => q.a - p.a);
      historial.push({ tipo: 'lote', antes: rellenos.slice() });
      const [blanco, principal, iris, oscuro] = combo;
      // qué color va en cada zona, de la más grande a la más pequeña
      const colorPara = (k: number) => modelo.id === 'labios'
        ? principal                                                       // labios cerrados: los dos labios de color
        : modelo.id.includes('labios')
        ? (k === 0 ? principal : k === 1 ? oscuro : blanco)              // labios, boca y dientes
        : ([blanco, principal, iris, oscuro][k] ?? principal);           // ojo, borde, iris y pupila
      rellenos = orden.map((z, k) => ({ x: semillas[z.i][0], y: semillas[z.i][1], c: colorPara(k) }));
      pintarPronto();
    });
    raiz.querySelector('[data-deshacer]')!.addEventListener('click', () => {
      const a = historial.pop();
      if (!a) return;
      if (a.tipo === 'lote') rellenos = a.antes ?? [];
      else if (a.tipo === 'relleno') rellenos.pop();
      else { trazos.pop(); reconstruirLineas(); }
      pintarPronto();
    });
    raiz.querySelector('[data-reiniciar]')!.addEventListener('click', () => {
      const actual = raiz.querySelector<HTMLButtonElement>('[data-modelo][aria-pressed="true"]');
      if (actual) cargarModelo(actual);
    });

    // ── etapas ──
    let prototipo: { imagen: () => string; destruir: () => void } | null = null;
    const escena3d = raiz.querySelector<HTMLElement>('[data-escena3d]')!;
    const cargando = raiz.querySelector<HTMLElement>('[data-cargando]')!;

    // color de los cantos: el más repetido justo por dentro del contorno de la pieza
    function colorDelCanto(): string {
      const porZona = coloresPorZona();
      let x0 = ANCHO, y0 = ALTO, x1 = 0, y1 = 0;
      for (let i = 0; i < ANCHO * ALTO; i += 7) if (zonas[i] !== zonaFondo) { const x = i % ANCHO, y = (i - x) / ANCHO; x0 = Math.min(x0, x); x1 = Math.max(x1, x); y0 = Math.min(y0, y); y1 = Math.max(y1, y); }
      const cx = (x0 + x1) / 2, cy = (y0 + y1) / 2;
      const cuenta = new Map<string, number>();
      for (let i = ANCHO; i < ANCHO * (ALTO - 1); i += 3) {
        if (zonas[i] !== -1 || (zonas[i - 1] !== zonaFondo && zonas[i + 1] !== zonaFondo && zonas[i - ANCHO] !== zonaFondo && zonas[i + ANCHO] !== zonaFondo)) continue;
        const x = i % ANCHO, y = (i - x) / ANCHO;
        const dx = cx - x, dy = cy - y, l = Math.hypot(dx, dy) || 1;
        for (let paso = 6; paso < 30; paso += 3) {
          const z = zonas[Math.round(y + (dy / l) * paso) * ANCHO + Math.round(x + (dx / l) * paso)];
          if (z >= 0 && z !== zonaFondo) { const c = porZona.get(z) ?? SIN_PINTAR; cuenta.set(c, (cuenta.get(c) ?? 0) + 1); break; }
        }
      }
      let mejor = SIN_PINTAR, n = 0;
      cuenta.forEach((v, c) => { if (v > n) { n = v; mejor = c; } });
      return mejor;
    }

    async function verPieza() {
      componerPieza();
      prototipo?.destruir();
      cargando.hidden = false;
      const dentro = new Uint8Array(ANCHO * ALTO);
      for (let i = 0; i < ANCHO * ALTO; i++) dentro[i] = zonas[i] !== zonaFondo ? 1 : 0;
      const imagenPieza = Object.assign(document.createElement('canvas'), { width: ANCHO, height: ALTO });
      imagenPieza.getContext('2d')!.drawImage(capaPieza, 0, 0);
      // la librería 3D solo se descarga cuando hace falta
      const { mostrarPieza3D } = await import('../utils/pieza3d');
      cargando.hidden = true;
      prototipo = mostrarPieza3D(escena3d, { imagen: imagenPieza, dentro, ancho: ANCHO, alto: ALTO, colorCanto: colorDelCanto() });
      actualizarEnvio();
    }

    function irA(etapa: string) {
      raiz.querySelectorAll<HTMLElement>('[data-etapa]').forEach((e) => (e.hidden = e.dataset.etapa !== etapa));
      raiz.closest('dialog')?.scrollTo({ top: 0, behavior: 'smooth' });
      if (etapa === 'editor' && !modelo.id) cargarModelo(raiz.querySelector<HTMLButtonElement>('[data-modelo]')!);
      if (etapa === 'pieza') verPieza();
    }
    raiz.querySelectorAll<HTMLButtonElement>('[data-ir]').forEach((b) => b.addEventListener('click', () => irA(b.dataset.ir!)));
    // al cerrar el diálogo se vuelve a la presentación
    raiz.closest('dialog')?.addEventListener('close', () => { prototipo?.destruir(); prototipo = null; irA('presentacion'); });

    // ── envío ──
    const idea = raiz.querySelector<HTMLTextAreaElement>('[data-idea]')!;
    const enviar = raiz.querySelector<HTMLAnchorElement>('[data-enviar]')!;
    raiz.querySelectorAll<HTMLButtonElement>('[data-medida]').forEach((b) =>
      b.addEventListener('click', () => {
        medida = Number(b.dataset.medida);
        raiz.querySelectorAll('[data-medida]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        actualizarEnvio();
      }),
    );
    function mensaje() {
      const usados = [...new Set([...coloresPorZona().values()])].map(nombreDe);
      const lineas = [
        tx.saludo,
        `• ${tx.modelo}: ${modelo.nombre}`,
        `• ${tx.colores}: ${usados.length ? usados.join(', ') : tx.sinColores}`,
        `• ${tx.medida}: ${medida} cm`,
      ];
      if (idea.value.trim()) lineas.push(`• ${tx.idea.replace(/ \(.*\)$/, '')}: ${idea.value.trim()}`);
      lineas.push('', tx.adjunto);
      return lineas.join('\n');
    }
    function actualizarEnvio() { enviar.href = `https://wa.me/${raiz.dataset.numero}?text=${encodeURIComponent(mensaje())}`; }
    idea.addEventListener('input', actualizarEnvio);

    // la imagen que se envía es el prototipo 3D (o el dibujo, si aún no se ha visto en 3D)
    const imagenDiseno = async () => {
      const url = prototipo ? prototipo.imagen() : lienzo.toDataURL('image/png');
      return (await fetch(url)).blob();
    };
    const descargar = async () => {
      const url = URL.createObjectURL(await imagenDiseno());
      Object.assign(document.createElement('a'), { href: url, download: 'mi-pieza-natalia-barrio.png' }).click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    };
    raiz.querySelector('[data-descargar]')!.addEventListener('click', descargar);
    const prueba = new File([''], 'prueba.png', { type: 'image/png' });
    const puedeCompartir = !!navigator.canShare?.({ files: [prueba] }) && matchMedia('(pointer: coarse)').matches;
    enviar.addEventListener('click', async (e) => {
      if (!puedeCompartir) { descargar(); return; }
      e.preventDefault();
      const archivo = new File([await imagenDiseno()], 'mi-pieza-natalia-barrio.png', { type: 'image/png' });
      try { await navigator.share({ files: [archivo], text: mensaje() }); } catch { /* cancelado */ }
    });

    cursor();
  });
</script>
