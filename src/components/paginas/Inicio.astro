---
// HOME: de momento, tu nombre en grande sobre fondo blanco.
import Base from '../../layouts/Base.astro';
import type { Idioma } from '../../i18n/textos';
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
---

<Base idioma={idioma} pagina="">
  <section class="portada">
    <h1>Natalia Barrio<br />Araúz de Robles</h1>
  </section>
</Base>

<style>
  .portada {
    min-height: calc(100vh - 160px);
    display: grid;
    place-items: center;
    padding: 2rem var(--margen);
    text-align: center;
  }
  h1 {
    /* nombre en mayúsculas finas y muy espaciadas */
    font-size: clamp(1.3rem, 3.4vw, 2.6rem);
    font-weight: 300;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    line-height: 1.5;
  }
</style>
