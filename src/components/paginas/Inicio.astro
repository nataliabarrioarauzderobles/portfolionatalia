---
// HOME: de momento, tu nombre en grande sobre el blanco roto.
import Base from '../../layouts/Base.astro';
import type { Idioma } from '../../i18n/textos';
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
---

<Base idioma={idioma} pagina="">
  <section class="portada">
    <h1>Natalia Barrio<br />Araúz de Robles</h1>
  </section>
</Base>

<style>
  .portada {
    min-height: calc(100vh - 160px);
    display: grid;
    place-items: center;
    padding: 2rem var(--margen);
    text-align: center;
  }
  h1 {
    font-size: clamp(2.6rem, 8vw, 6.5rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.05;
  }
</style>
