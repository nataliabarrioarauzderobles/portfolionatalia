---
// HOME (inspirada en la intro de Brandon Yasin: blanco, limpio, una sola imagen)
// Al entrar, los rasgos dibujados con rotulador (cejas y ojos, y boca) llegan muy grandes
// y se van haciendo pequeños hasta colocarse en su sitio sobre la foto de carnet.
// Al final se ve la foto intervenida original (yo1) y aparece el nombre.
// Capas: foto sin dibujo (tenue al principio) → trazos que se animan → foto original encima al final.
import Base from '../../layouts/Base.astro';
import type { Idioma } from '../../i18n/textos';
import { imagen } from '../../utils/imagenes';
interface Props { idioma: Idioma }
const { idioma } = Astro.props;

const final = imagen('inicio/foto-final.jpg');
const base = imagen('inicio/foto-base.jpg');
// posición de cada trazo en % de la foto (calculada al separar el dibujo de la foto)
const trazos = [
  { img: imagen('inicio/trazo-izquierda.png'), x: 6.466, y: 33.875, w: 44.655, h: 26.313, desde: [-38, -12, -9] },
  { img: imagen('inicio/trazo-derecha.png'), x: 49.655, y: 36.313, w: 32.759, h: 20.625, desde: [40, -18, 8] },
  { img: imagen('inicio/trazo-boca.png'), x: 27.5, y: 59.563, w: 30.603, h: 12, desde: [6, 46, -6] },
];
---

<Base idioma={idioma} pagina="">
  <section class="portada" data-portada>
    <figure class="retrato" style={`aspect-ratio:${final.width} / ${final.height}`}>
      <img class="capa base" src={base.src} alt="" width={base.width} height={base.height} data-base />
      {trazos.map((t) => (
        <img
          class="capa trazo"
          src={t.img.src}
          alt=""
          style={`left:${t.x}%;top:${t.y}%;width:${t.w}%;height:${t.h}%`}
          data-trazo={t.desde.join(',')}
        />
      ))}
      <img class="capa final" src={final.src} alt="Natalia Barrio Araúz de Robles" width={final.width} height={final.height} data-final />
    </figure>
    <h1 class="nombre" data-nombre>Natalia Barrio Araúz de Robles</h1>
  </section>
</Base>

<style>
  .portada {
    min-height: calc(100vh - 90px);
    display: grid;
    place-items: center;
    align-content: center;
    gap: clamp(1.4rem, 3vw, 2.2rem);
    padding: 1rem var(--margen) 3rem;
    text-align: center;
  }
  .retrato { position: relative; margin: 0; height: min(62vh, 600px); max-width: 90vw; }
  .capa { position: absolute; display: block; }
  .base, .final { inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .trazo { transform-origin: center; will-change: transform, opacity; }

  .nombre {
    font-size: clamp(0.85rem, 1.4vw, 1.1rem);
    font-weight: 300;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    line-height: 1.6;
    margin: 0;
  }

  /* Estado inicial cuando hay JavaScript: solo el blanco. Sin JavaScript se ve la foto final directamente. */
  :global(.js) .base, :global(.js) .trazo, :global(.js) .final, :global(.js) .nombre { opacity: 0; }
  /* la cabecera aparece al final de la intro */
  :global(body.intro .cabecera) { opacity: 0; }
  :global(body .cabecera) { transition: opacity 1s ease; }
</style>

<script>
  const base = document.querySelector<HTMLImageElement>('[data-base]');
  const final = document.querySelector<HTMLImageElement>('[data-final]');
  const nombre = document.querySelector<HTMLElement>('[data-nombre]');
  const trazos = [...document.querySelectorAll<HTMLImageElement>('[data-trazo]')];
  const portada = document.querySelector<HTMLElement>('[data-portada]');

  if (base && final && nombre && portada) {
    const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fin = { opacity: 1 };
    const curva = 'cubic-bezier(.16, 1, .3, 1)';
    const animaciones: Animation[] = [];
    const mostrarTodo = () => {
      animaciones.forEach((a) => a.finish());
      [final, nombre].forEach((el) => (el.style.opacity = '1'));
      document.body.classList.remove('intro');
    };

    // espera a que las imágenes estén cargadas para que la intro no empiece a medias
    const cargadas = [base, final, ...trazos].map((img) => (img.complete ? Promise.resolve() : new Promise((ok) => (img.onload = img.onerror = ok))));

    if (sinMovimiento) {
      mostrarTodo();
    } else {
      document.body.classList.add('intro');
      Promise.all(cargadas).then(() => {
        // 1. la foto aparece muy tenue
        animaciones.push(base.animate([{ opacity: 0, transform: 'scale(1.03)' }, { opacity: 0.32, transform: 'scale(1)' }], { duration: 1200, easing: 'ease-out', fill: 'forwards' }));
        // 2. cada rasgo llega grande desde fuera y se hace pequeño hasta su sitio
        trazos.forEach((trazo, i) => {
          const [dx, dy, giro] = trazo.dataset.trazo!.split(',').map(Number);
          animaciones.push(trazo.animate(
            [
              { opacity: 0, transform: `translate(${dx}%, ${dy}%) scale(3.6) rotate(${giro}deg)` },
              { opacity: 1, offset: 0.25 },
              { opacity: 1, transform: 'translate(0, 0) scale(1) rotate(0deg)' },
            ],
            { duration: 1700, delay: 450 + i * 380, easing: curva, fill: 'both' },
          ));
        });
        const aterriza = 450 + (trazos.length - 1) * 380 + 1700;
        // 3. la foto se completa y se funde con la imagen original intervenida
        animaciones.push(base.animate([{ opacity: 0.32 }, fin], { duration: 500, delay: aterriza - 300, fill: 'forwards' }));
        animaciones.push(final.animate([{ opacity: 0 }, fin], { duration: 800, delay: aterriza, easing: 'ease', fill: 'forwards' }));
        // 4. aparece el nombre y después la cabecera
        animaciones.push(nombre.animate(
          [{ opacity: 0, letterSpacing: '0.6em', transform: 'translateY(8px)' }, { opacity: 1, letterSpacing: '0.32em', transform: 'none' }],
          { duration: 1400, delay: aterriza + 400, easing: curva, fill: 'forwards' },
        ));
        setTimeout(() => document.body.classList.remove('intro'), aterriza + 900);
      });
      // un clic durante la intro la salta
      portada.addEventListener('click', mostrarTodo, { once: true });
    }
  }
</script>
