---
// CONTACTO: primero cómo escribirte; después, en pequeño, quién eres (inspirado en avea.studio)
//  · Arriba, las formas de contacto como un índice: una línea cada una, en letra grande, con su etiqueta.
//  · Debajo, "Sobre mí": una sola foto pequeña y tranquila (no un carrusel) y los dos párrafos en columnas.
//  · En el móvil, todo apilado.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import LogoAnimado from '../LogoAnimado.astro';
import { textos, type Idioma } from '../../i18n/textos';
import { contacto, enlaceWhatsApp, url } from '../../utils/enlaces';
import { imagen } from '../../utils/imagenes';
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = textos[idioma];

// la foto de "Sobre mí": una sola, pequeña
const foto = imagen('sobre-mi/fotos/foto-01.jpg');

// las formas de contacto, una por línea
const lineas = [
  { etiqueta: t.email, texto: contacto.email, enlace: `mailto:${contacto.email}` },
  { etiqueta: t.instagram, texto: `@${contacto.instagram}`, enlace: `https://instagram.com/${contacto.instagram}`, fuera: true },
  { etiqueta: 'WhatsApp', texto: t.escribemeWhatsApp, enlace: enlaceWhatsApp(t.mensajeContacto), fuera: true },
  { etiqueta: t.telefono, texto: contacto.telefono, enlace: `tel:${contacto.telefono.replace(/\s/g, '')}` },
];

// Texto del cuadernillo (CUADERNILLO_VENEZUELA); el inglés es traducción.
const sobreMi = {
  es: [
    'Soy artista visual y diseñadora, y mi práctica se desarrolla principalmente a través de la pintura. Investigo la relación entre forma, materia y gesto, explorando cómo una imagen puede transformarse, perder sus límites y adquirir nuevas formas de presencia.',
    'Mi trabajo parte de la abstracción para acercarse a lo humano, creando composiciones en las que la figura aparece, se transforma y finalmente se deshace. A través de la pintura busco generar un diálogo entre lo reconocible y lo ambiguo, entre lo que toma forma y lo que está en proceso de desaparecer.',
  ],
  en: [
    'I am a visual artist and designer, and my practice is mainly developed through painting. I research the relationship between form, matter and gesture, exploring how an image can transform, lose its limits and take on new forms of presence.',
    'My work starts from abstraction to come closer to the human, creating compositions in which the figure appears, transforms and finally comes undone. Through painting I seek a dialogue between the recognisable and the ambiguous, between what takes shape and what is in the process of disappearing.',
  ],
}[idioma];
---

<Base idioma={idioma} pagina="contacto" titulo={t.contactoTitulo}>
  <section class="contacto">
    <h1 class="etiqueta">{t.contactoTitulo}</h1>
    <ul class="lineas">
      {lineas.map((l) => (
        <li>
          <span class="etiqueta">{l.etiqueta}</span>
          <a href={l.enlace} target={l.fuera ? '_blank' : undefined} rel={l.fuera ? 'noopener' : undefined}>{l.texto}</a>
          <span class="flecha" aria-hidden="true">→</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="sobre-mi">
    <h2 class="etiqueta">{t.sobreMi}</h2>
    <figure class="foto">
      <Image src={foto} alt={contacto.nombre} widths={[300, 600]} sizes="(max-width: 760px) 40vw, 180px" loading="lazy" />
    </figure>
    {sobreMi.map((p) => <p class="texto" lang={idioma}>{p}</p>)}
    <a class="cv" href={url('cv-natalia-barrio.pdf')} download>{t.descargarCV} →</a>
  </section>

  <!-- cierre de la página: el personaje se dibuja como una firma -->
  <section class="firma-animada">
    <LogoAnimado />
  </section>
</Base>

<style>
  .contacto, .sobre-mi { padding: 0 var(--margen); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.01em; }
  .etiqueta { margin: 0; color: var(--texto-tenue); font-size: 0.72rem; font-weight: 400; }

  /* LAS FORMAS DE CONTACTO: un índice, una línea cada una */
  .contacto { padding-top: clamp(1.5rem, 5vh, 3.5rem); }
  .contacto > .etiqueta { margin-bottom: 1rem; }
  .lineas { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--linea); }
  .lineas li {
    position: relative; display: grid; grid-template-columns: minmax(7rem, 1fr) 3fr auto; align-items: baseline; gap: 1rem;
    padding: clamp(0.9rem, 2.2vh, 1.4rem) 0; border-bottom: 1px solid var(--linea);
  }
  .lineas a {
    color: var(--texto); text-transform: none; font-size: clamp(1.1rem, 2.6vw, 2.3rem); line-height: 1.1; letter-spacing: -0.01em;
    overflow-wrap: anywhere; transition: opacity 0.25s;
  }
  /* toda la línea se puede pulsar */
  .lineas a::after { content: ''; position: absolute; inset: 0; }
  .flecha { font-size: clamp(1rem, 2vw, 1.6rem); color: var(--texto-tenue); transition: transform 0.3s ease, color 0.3s; }
  .lineas li:hover a { opacity: 0.6; }
  .lineas li:hover .flecha { transform: translateX(0.4rem); color: var(--texto); }

  /* SOBRE MÍ: foto pequeña y dos columnas de texto */
  .sobre-mi {
    display: grid; grid-template-columns: minmax(7rem, 1fr) 180px repeat(2, minmax(0, 1.4fr)); gap: 1.2rem clamp(1.2rem, 3vw, 2.5rem);
    align-items: start; margin-top: clamp(4rem, 12vh, 8rem);
  }
  .foto { margin: 0; }
  .foto :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .texto { margin: 0; text-transform: none; font-size: 0.84rem; line-height: 1.6; color: var(--texto-suave); }
  .cv { grid-column: 3; color: var(--texto); padding-bottom: 0.15rem; border-bottom: 1px solid var(--texto); justify-self: start; transition: opacity 0.2s; }
  .cv:hover { opacity: 0.55; }

  @media (max-width: 900px) {
    .sobre-mi { grid-template-columns: 140px minmax(0, 1fr); }
    .sobre-mi .etiqueta { grid-column: 1 / -1; }
    .foto { grid-row: span 3; }
    .cv { grid-column: 2; }
  }
  @media (max-width: 560px) {
    .lineas li { grid-template-columns: minmax(0, 1fr) auto; gap: 0.3rem 1rem; }
    .lineas .etiqueta { grid-column: 1 / -1; }
    .sobre-mi { grid-template-columns: 1fr; }
    .foto { grid-row: auto; width: 46%; }
    .cv { grid-column: 1; }
  }

  .firma-animada { margin: clamp(3rem, 8vw, 6rem) 0 0; }
</style>
