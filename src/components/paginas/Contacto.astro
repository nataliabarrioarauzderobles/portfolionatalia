---
// CONTACTO: una página limpia; tu oficio y tu nombre, como titular, en Cascadia Code, y el resto en Archivo
//  · En el centro, una foto en color de tamaño medio, con tu oficio encima y tu nombre debajo, como en un catálogo.
//  · Debajo, quién eres, en un párrafo breve, y tus exposiciones y trayectoria (del CV).
//  · Y los contactos, solo con tipografía: WhatsApp, llamar, Gmail, Instagram y CV. Al pasar el cursor, el texto se aclara.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { textos, type Idioma } from '../../i18n/textos';
import { contacto, url, enlaceWhatsApp } from '../../utils/enlaces';
import { imagen } from '../../utils/imagenes';
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = textos[idioma];

const foto = imagen('sobre-mi/contacto-color.jpg');

const tx = {
  es: {
    oficio: 'Pintora y diseñadora — Madrid',
    breve: 'Soy Natalia, pintora y diseñadora. Me interesa el impulso creativo, el juego con el subconsciente y la pareidolia: empezar sin saber muy bien adónde va la pieza, dejar que la forma se construya sola y ver cómo siempre acaba apareciendo un gesto humano.',
    llamar: 'Llamar',
    cv: 'CV',
    mensaje: 'Hola Natalia, he visto tu web y me gustaría hablar contigo.',
    exposiciones: 'Exposiciones',
    trayectoria: 'Trayectoria',
    mural: 'Mural en',
    macarron: 'Asistente en el estudio de Rafael Macarrón',
    grattin: 'Asistente de galería en Grattin',
    nuba: 'Diseñadora en NUBA, agencia de viajes',
    nuevaYork: 'Nueva York',
  },
  en: {
    oficio: 'Painter and designer — Madrid',
    breve: "I'm Natalia, a painter and designer. I'm interested in creative impulse, in playing with the subconscious and with pareidolia: starting without quite knowing where the piece is going, letting the form build itself, and watching how a human gesture always ends up appearing.",
    llamar: 'Call',
    cv: 'CV',
    mensaje: "Hi Natalia, I've seen your website and I'd like to talk to you.",
    exposiciones: 'Exhibitions',
    trayectoria: 'Experience',
    mural: 'Mural at',
    macarron: "Assistant at Rafael Macarrón's studio",
    grattin: 'Gallery assistant at Grattin',
    nuba: 'Designer at NUBA, travel agency',
    nuevaYork: 'New York',
  },
}[idioma];

// EXPOSICIONES Y TRAYECTORIA (sacadas del CV): para añadir una nueva, ponla arriba de la lista
const exposiciones = [
  { lugar: 'La Torre, Caracas', año: 2026 },
  { lugar: 'Casa Maiko, Madrid', año: 2026 },
  { lugar: 'Pintor El Greco, Toledo', año: 2026 },
  { lugar: 'Artist 360, Madrid', año: 2026 },
  { lugar: 'Café DOPA, Madrid', año: 2026 },
  { lugar: 'Zielo Shopping Centre, Madrid', año: 2024 },
  { lugar: 'Anica, Madrid', año: 2022 },
  { lugar: `${tx.mural} La Cabezona, Madrid`, año: 2019 },
  { lugar: `${tx.mural} R.A.C.E., Madrid`, año: 2018 },
];
// en la trayectoria, la ciudad va en negrita
const trayectoria = [
  { lugar: tx.grattin, ciudad: tx.nuevaYork, año: 2026 },
  { lugar: tx.macarron, ciudad: 'Madrid', año: 2025 },
  { lugar: tx.nuba, ciudad: 'Madrid', año: 2023 },
];

const enlaces = [
  { texto: 'WhatsApp', enlace: enlaceWhatsApp(tx.mensaje), fuera: true },
  { texto: tx.llamar, enlace: `tel:${contacto.telefono.replace(/\s/g, '')}` },
  { texto: 'Gmail', enlace: `mailto:${contacto.email}` },
  { texto: 'Instagram', enlace: `https://instagram.com/${contacto.instagram}`, fuera: true },
  { texto: tx.cv, enlace: url('cv-natalia-barrio.pdf'), descarga: true },
];
---

<Base idioma={idioma} pagina="contacto" titulo={t.contactoTitulo}>
  <section class="contacto">
    <h1 class="solo-lector">{t.contactoTitulo}</h1>

    <figure class="foto">
      <figcaption class="arriba">{tx.oficio}</figcaption>
      <Image src={foto} alt={contacto.nombre} widths={[600, 1000, 1400]} sizes="(max-width: 760px) 90vw, 520px" loading="eager" />
      <figcaption class="abajo"><span>{contacto.nombre}</span></figcaption>
    </figure>

    <p class="breve" lang={idioma}>{tx.breve}</p>

    <div class="listas" id="exposiciones">
      {[{ titulo: tx.exposiciones, filas: exposiciones }, { titulo: tx.trayectoria, filas: trayectoria }].map((l) => (
        <section>
          <h2>{l.titulo}</h2>
          <ul>
            {l.filas.map((f) => <li><span>{f.lugar}{'ciudad' in f && <>, <strong>{f.ciudad}</strong></>}</span><span class="año">{f.año}</span></li>)}
          </ul>
        </section>
      ))}
    </div>

    <ul class="enlaces">
      {enlaces.map((e) => (
        <li>
          <a href={e.enlace} target={e.fuera ? '_blank' : undefined} rel={e.fuera ? 'noopener' : undefined} download={e.descarga ? '' : undefined}>{e.texto}</a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .contacto {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    min-height: calc(100svh - 62px); padding: clamp(2rem, 6vh, 4rem) var(--margen) clamp(3rem, 8vh, 5rem);
    font-size: 0.74rem; line-height: 1.5; text-transform: uppercase; letter-spacing: 0.02em; color: #444;
  }
  .contacto > * { width: min(520px, 100%); }

  /* LA FOTO, con sus anotaciones */
  .foto { margin: 0; }
  .foto :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
  .arriba, .abajo { font-family: var(--fuente-titulos); }
  .arriba { margin-bottom: 0.45rem; text-align: right; }
  .abajo { margin-top: 0.45rem; text-align: right; }

  /* QUIÉN SOY */
  .breve { margin: clamp(2.2rem, 6vh, 3.5rem) 0 0; text-transform: none; letter-spacing: 0; line-height: 1.7; }

  /* EXPOSICIONES Y TRAYECTORIA: lugar a la izquierda, año a la derecha, sin adornos */
  .listas { display: grid; gap: clamp(1.6rem, 4vh, 2.2rem); margin-top: clamp(2.2rem, 6vh, 3.5rem); scroll-margin-top: 6rem; }
  .listas h2 { margin: 0 0 0.7rem; font: inherit; color: var(--texto-tenue); }
  .listas ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .listas li { display: flex; justify-content: space-between; gap: 1.5rem; color: #222; }
  .año { flex: none; font-variant-numeric: tabular-nums; color: #444; }
  .listas strong { font-weight: 600; color: var(--texto); }

  /* LOS CONTACTOS: solo tipografía; al pasar el cursor se aclara */
  .enlaces { list-style: none; margin: clamp(1.8rem, 5vh, 2.8rem) 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.6rem 1.5rem; }
  .enlaces a { color: #222; transition: color 0.25s ease; }
  .enlaces a:hover, .enlaces a:focus-visible { color: #aaa; }
</style>
