---
// CONTACTO: una página limpia, con la tipografía Cascadia Code (monoespaciada)
//  · En el centro, una foto en color de tamaño medio, con pequeñas anotaciones alrededor, como en un catálogo.
//  · Debajo, quién eres, en un párrafo breve.
//  · Y los contactos, solo con tipografía: llamar, Gmail, Instagram y CV. Al pasar el cursor, el texto se aclara.
import '@fontsource/cascadia-code/400.css';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { textos, type Idioma } from '../../i18n/textos';
import { contacto, url } from '../../utils/enlaces';
import { imagen } from '../../utils/imagenes';
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = textos[idioma];

const foto = imagen('sobre-mi/contacto-color.jpg');

const tx = {
  es: {
    oficio: 'Pintora y diseñadora — Madrid',
    breve: 'Soy Natalia, pintora y diseñadora. Me interesa explorar el subconsciente creativo: empezar un cuadro o un diseño sin saber muy bien adónde va y dejar que la forma se construya por sí misma. Y siempre, de alguna manera, acaba apareciendo un gesto humano.',
    llamar: 'Llamar',
    cv: 'CV',
  },
  en: {
    oficio: 'Painter and designer — Madrid',
    breve: "I'm Natalia, a painter and designer. I'm interested in exploring the creative subconscious: starting a painting or a design without quite knowing where it's going, and letting the form build itself. And somehow, a human gesture always ends up appearing.",
    llamar: 'Call',
    cv: 'CV',
  },
}[idioma];

const enlaces = [
  { texto: tx.llamar, enlace: `tel:${contacto.telefono.replace(/\s/g, '')}` },
  { texto: 'Gmail', enlace: `mailto:${contacto.email}` },
  { texto: 'Instagram', enlace: `https://instagram.com/${contacto.instagram}`, fuera: true },
  { texto: tx.cv, enlace: url('cv-natalia-barrio.pdf'), descarga: true },
];
---

<Base idioma={idioma} pagina="contacto" titulo={t.contactoTitulo}>
  <section class="contacto">
    <h1 class="solo-lector">{t.contactoTitulo}</h1>

    <figure class="foto">
      <figcaption class="arriba">{tx.oficio}</figcaption>
      <Image src={foto} alt={contacto.nombre} widths={[600, 1000, 1400]} sizes="(max-width: 760px) 90vw, 520px" loading="eager" />
      <figcaption class="abajo"><span>2026</span><span>{contacto.nombre}</span></figcaption>
    </figure>

    <p class="breve" lang={idioma}>{tx.breve}</p>

    <ul class="enlaces">
      {enlaces.map((e) => (
        <li>
          <a href={e.enlace} target={e.fuera ? '_blank' : undefined} rel={e.fuera ? 'noopener' : undefined} download={e.descarga ? '' : undefined}>{e.texto}</a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .contacto {
    --mono: 'Cascadia Code', ui-monospace, monospace;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    min-height: calc(100svh - 62px); padding: clamp(2rem, 6vh, 4rem) var(--margen) clamp(3rem, 8vh, 5rem);
    font-family: var(--mono); font-size: 0.74rem; line-height: 1.5; text-transform: uppercase; letter-spacing: 0.02em; color: #444;
  }
  .contacto > * { width: min(520px, 100%); }

  /* LA FOTO, con sus anotaciones */
  .foto { margin: 0; }
  .foto :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
  .arriba { margin-bottom: 0.45rem; text-align: right; }
  .abajo { display: flex; justify-content: space-between; gap: 1rem; margin-top: 0.45rem; }

  /* QUIÉN SOY */
  .breve { margin: clamp(2.2rem, 6vh, 3.5rem) 0 0; text-transform: none; letter-spacing: 0; line-height: 1.7; }

  /* LOS CONTACTOS: solo tipografía; al pasar el cursor se aclara */
  .enlaces { list-style: none; margin: clamp(1.8rem, 5vh, 2.8rem) 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.6rem 1.5rem; }
  .enlaces a { color: #222; transition: color 0.25s ease; }
  .enlaces a:hover, .enlaces a:focus-visible { color: #aaa; }
</style>
