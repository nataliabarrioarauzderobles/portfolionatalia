---
// CONTACTO: una composición editorial alrededor de tus fotos (inspirada en avea.studio)
//  · En el centro de la pantalla, de lado a lado, la "hoja de contactos": tus fotos en blanco y negro
//    en una tira que avanza despacio y sin fin (se detiene al pasar el cursor).
//  · Arriba a la izquierda, "Sobre mí" y el primer párrafo; arriba a la derecha, tus datos.
//  · Abajo a la derecha, el segundo párrafo; abajo a la izquierda, WhatsApp y CV.
//    Se lee en diagonal, con las fotos en medio. En el móvil, todo apilado.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import LogoAnimado from '../LogoAnimado.astro';
import { textos, type Idioma } from '../../i18n/textos';
import { contacto, enlaceWhatsApp, url } from '../../utils/enlaces';
import { imagenesDe } from '../../utils/imagenes';
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = textos[idioma];
const fotos = imagenesDe('sobre-mi/fotos');

// Texto del cuadernillo (CUADERNILLO_VENEZUELA); el inglés es traducción
const sobreMi = {
  es: [
    'Soy artista visual y diseñadora, y mi práctica se desarrolla principalmente a través de la pintura. Investigo la relación entre forma, materia y gesto, explorando cómo una imagen puede transformarse, perder sus límites y adquirir nuevas formas de presencia.',
    'Mi trabajo parte de la abstracción para acercarse a lo humano, creando composiciones en las que la figura aparece, se transforma y finalmente se deshace. A través de la pintura busco generar un diálogo entre lo reconocible y lo ambiguo, entre lo que toma forma y lo que está en proceso de desaparecer.',
  ],
  en: [
    'I am a visual artist and designer, and my practice is mainly developed through painting. I research the relationship between form, matter and gesture, exploring how an image can transform, lose its limits and take on new forms of presence.',
    'My work starts from abstraction to come closer to the human, creating compositions in which the figure appears, transforms and finally comes undone. Through painting I seek a dialogue between the recognisable and the ambiguous, between what takes shape and what is in the process of disappearing.',
  ],
}[idioma];
---

<Base idioma={idioma} pagina="contacto" titulo={t.contactoTitulo}>
  <section class="escena">
    <!-- arriba a la izquierda: sobre mí -->
    <div class="bloque sobre">
      <h1 class="etiqueta">{t.sobreMi}</h1>
      <p class="texto" lang={idioma}>{sobreMi[0]}</p>
    </div>

    <!-- arriba a la derecha: datos -->
    <dl class="bloque datos">
      <div><dt>{t.email}</dt><dd><a href={`mailto:${contacto.email}`}>{contacto.email}</a></dd></div>
      <div><dt>{t.instagram}</dt><dd><a href={`https://instagram.com/${contacto.instagram}`} target="_blank" rel="noopener">@{contacto.instagram}</a></dd></div>
      <div><dt>{t.telefono}</dt><dd><a href={`tel:${contacto.telefono.replace(/s/g, "")}`}>{contacto.telefono}</a></dd></div>
    </dl>

    <!-- en el centro: la hoja de contactos, que avanza sin fin -->
    <div class="tira-fotos" aria-label={t.sobreMi}>
      <div class="pista">
        {[0, 1].map((copia) => (
          <ul aria-hidden={copia === 1 ? "true" : undefined}>
            {fotos.map((img, i) => (
              <li>
                <Image src={img} alt={copia === 0 && i === 0 ? contacto.nombre : ""} widths={[260, 520]} sizes="(max-width: 700px) 140px, 220px" loading={i < 8 ? "eager" : "lazy"} />
                <span>{String(i + 1).padStart(2, "0")}</span>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>

    <!-- abajo a la izquierda: escribir y CV -->
    <div class="bloque acciones">
      <a href={enlaceWhatsApp(t.mensajeContacto)} target="_blank" rel="noopener">{t.escribemeWhatsApp} →</a>
      <a href={url("cv-natalia-barrio.pdf")} download>{t.descargarCV} →</a>
    </div>

    <!-- abajo a la derecha: el segundo párrafo -->
    <p class="bloque texto segundo" lang={idioma}>{sobreMi[1]}</p>
  </section>

  <!-- cierre de la página: el personaje se dibuja como una firma -->
  <section class="firma-animada">
    <LogoAnimado />
  </section>
</Base>

<style>
  /* LA ESCENA: ocupa la pantalla; la tira cruza por el centro y los textos ocupan las esquinas */
  .escena {
    min-height: calc(100svh - 62px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: 1fr auto 1fr;
    grid-template-areas: "sobre datos" "tira tira" "acciones segundo";
    gap: clamp(1.5rem, 4vh, 3rem) var(--margen);
    padding: clamp(1.5rem, 4vh, 3rem) var(--margen);
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.01em;
  }
  .bloque { max-width: 36ch; }
  .sobre { grid-area: sobre; align-self: end; }
  .datos { grid-area: datos; align-self: end; justify-self: end; margin: 0; display: grid; gap: 0.7rem; text-align: right; }
  .acciones { grid-area: acciones; align-self: start; display: grid; gap: 0.5rem; justify-items: start; }
  .segundo { grid-area: segundo; align-self: start; justify-self: end; }

  .etiqueta { margin: 0 0 1rem; color: var(--texto-tenue); font-size: inherit; }
  .texto { margin: 0; text-transform: none; font-size: 0.84rem; line-height: 1.6; color: var(--texto-suave); }
  .datos dt { color: var(--texto-tenue); }
  .datos dd { margin: 0; text-transform: none; word-break: break-word; }
  .datos a, .acciones a { color: var(--texto); transition: opacity 0.2s; }
  .datos a:hover, .acciones a:hover { opacity: 0.55; }
  .acciones a { padding-bottom: 0.15rem; border-bottom: 1px solid var(--texto); }

  /* HOJA DE CONTACTOS: de lado a lado de la pantalla */
  .tira-fotos {
    grid-area: tira;
    --alto: clamp(150px, 27vh, 280px);
    margin: 0 calc(var(--margen) * -1);
    overflow: hidden;
    /* los extremos se funden con el blanco */
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .pista { display: flex; width: max-content; animation: avanzar 70s linear infinite; }
  .tira-fotos:hover .pista { animation-play-state: paused; }
  .pista ul { display: flex; gap: clamp(0.8rem, 1.6vw, 1.4rem); margin: 0; padding: 0 clamp(0.4rem, 0.8vw, 0.7rem); list-style: none; }
  .pista li { display: grid; gap: 0.5rem; width: calc(var(--alto) * 0.8); transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .pista li :global(img) { display: block; width: 100%; aspect-ratio: 4 / 5; height: auto; object-fit: cover; }
  .pista li span { color: var(--texto-tenue); }
  /* al pasar: la foto crece un poco y las demás se apagan */
  .pista:hover li { opacity: 0.35; }
  .pista li:hover { opacity: 1; transform: scale(1.06); }
  @keyframes avanzar { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .pista { animation: none; } .tira-fotos { overflow-x: auto; } }

  /* MÓVIL: todo apilado */
  @media (max-width: 760px) {
    .escena { grid-template-columns: 1fr; grid-template-rows: none; grid-template-areas: "sobre" "tira" "segundo" "datos" "acciones"; min-height: 0; }
    .datos, .segundo { justify-self: start; text-align: left; }
    .tira-fotos { --alto: 210px; }
  }

  .firma-animada { margin: clamp(3rem, 8vw, 6rem) 0 0; }
</style>

