---
// CONTACTO
// Arriba, en el centro, una foto tuya pequeña. Cada pocos segundos la siguiente aparece detrás
// y la que estaba se agranda por la pantalla hasta desaparecer, dejando la nueva en su sitio.
// Fotos: src/assets/sobre-mi/cartas (todas del mismo tamaño). Sin bordes.
// Debajo, el texto "Sobre mí", centrado y justificado, y después los datos y botones de contacto.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import LogoAnimado from '../LogoAnimado.astro';
import { textos, type Idioma } from '../../i18n/textos';
import { contacto, enlaceWhatsApp, url } from '../../utils/enlaces';
import { imagenesDe } from '../../utils/imagenes';
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = textos[idioma];
const fotos = imagenesDe('sobre-mi/cartas');

// Texto del cuadernillo (CUADERNILLO_VENEZUELA); el inglés es traducción
const sobreMi = {
  es: [
    'Soy artista visual y diseñadora, y mi práctica se desarrolla principalmente a través de la pintura. Investigo la relación entre forma, materia y gesto, explorando cómo una imagen puede transformarse, perder sus límites y adquirir nuevas formas de presencia.',
    'Mi trabajo parte de la abstracción para acercarse a lo humano, creando composiciones en las que la figura aparece, se transforma y finalmente se deshace. A través de la pintura busco generar un diálogo entre lo reconocible y lo ambiguo, entre lo que toma forma y lo que está en proceso de desaparecer.',
  ],
  en: [
    'I am a visual artist and designer, and my practice is mainly developed through painting. I research the relationship between form, matter and gesture, exploring how an image can transform, lose its limits and take on new forms of presence.',
    'My work starts from abstraction to come closer to the human, creating compositions in which the figure appears, transforms and finally comes undone. Through painting I seek a dialogue between the recognisable and the ambiguous, between what takes shape and what is in the process of disappearing.',
  ],
}[idioma];
---

<Base idioma={idioma} pagina="contacto" titulo={t.contactoTitulo}>
  <!-- la foto del centro: se van relevando -->
  <section class="galeria" aria-label={t.sobreMi}>
    <div class="marco" data-relevo>
      {fotos.map((img, i) => (
        <Image src={img} alt={i === 0 ? contacto.nombre : ''} widths={[320, 640]} sizes="(max-width: 700px) 50vw, 260px" loading="eager" class:list={['foto', { actual: i === 0 }]} />
      ))}
    </div>
  </section>

  <div class="contenedor columna">
    <h1 class="mono etiqueta">{t.sobreMi}</h1>
    {sobreMi.map((p) => <p class="texto" lang={idioma}>{p}</p>)}

    <dl class="datos">
      <div>
        <dt>{t.email}</dt>
        <dd><a href={`mailto:${contacto.email}`}>{contacto.email}</a></dd>
      </div>
      <div>
        <dt>{t.instagram}</dt>
        <dd><a href={`https://instagram.com/${contacto.instagram}`} target="_blank" rel="noopener">@{contacto.instagram}</a></dd>
      </div>
      <div>
        <dt>{t.telefono}</dt>
        <dd><a href={`tel:${contacto.telefono.replace(/\s/g, '')}`}>{contacto.telefono}</a></dd>
      </div>
    </dl>
    <div class="botones">
      <a class="boton boton-principal" href={enlaceWhatsApp(t.mensajeContacto)} target="_blank" rel="noopener">{t.escribemeWhatsApp}</a>
      <a class="boton" href={url('cv-natalia-barrio.pdf')} download>{t.descargarCV}</a>
    </div>
  </div>

  <!-- cierre de la página: el personaje se dibuja como una firma -->
  <section class="firma-animada">
    <LogoAnimado />
  </section>
</Base>

<style>
  /* FOTO DEL CENTRO */
  .galeria { display: grid; place-items: center; padding: clamp(3rem, 9vh, 6rem) 0 clamp(3rem, 7vh, 5rem); }
  .marco { position: relative; width: clamp(160px, 19vw, 260px); aspect-ratio: 4 / 5; }
  .marco :global(.foto) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;
    opacity: 0; pointer-events: none; transform-origin: center;
  }
  .marco :global(.foto.actual) { opacity: 1; z-index: 2; }
  .marco :global(.foto.siguiente) { opacity: 1; z-index: 1; }

  /* TEXTO Y CONTACTO */
  .columna { max-width: 460px; text-align: center; }
  .etiqueta { color: var(--texto-suave); margin: 0 0 1.4rem; font-weight: 400; }
  .texto { margin: 0 0 1rem; font-size: 0.9rem; line-height: 1.85; text-align: justify; text-align-last: center; hyphens: auto; }

  .datos { display: grid; gap: 1.1rem; margin: 2.8rem 0 2rem; padding-top: 2.4rem; border-top: 1px solid var(--linea); }
  .datos dt { font-family: var(--fuente-mono); font-size: 0.62rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--texto-suave); margin-bottom: 0.25rem; }
  .datos dd { margin: 0; font-size: 1rem; font-weight: 300; word-break: break-word; }
  .datos a { color: var(--texto); transition: color 0.2s; }
  .datos a:hover { color: var(--texto-suave); }
  .botones { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.7rem; }

  .firma-animada { margin: clamp(4rem, 10vw, 7rem) 0 0; }
</style>

<script>
  const marco = document.querySelector<HTMLElement>('[data-relevo]');
  if (marco) {
    const fotos = [...marco.querySelectorAll<HTMLImageElement>('.foto')];
    const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let actual = 0;
    const PAUSA = 2600, CRECER = 1300;

    const preparar = () => {
      const siguiente = (actual + 1) % fotos.length;
      fotos.forEach((f, i) => {
        f.classList.toggle('actual', i === actual);
        f.classList.toggle('siguiente', i === siguiente);
      });
    };

    // la foto de delante crece por la pantalla y se desvanece; la de detrás se queda
    const relevar = () => {
      const sale = fotos[actual];
      actual = (actual + 1) % fotos.length;
      const animacion = sinMovimiento
        ? sale.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 600, easing: 'ease' })
        : sale.animate(
            [
              { transform: 'scale(1)', opacity: 1 },
              { transform: 'scale(1.9)', opacity: 0.55, offset: 0.45 },
              { transform: 'scale(4.2)', opacity: 0 },
            ],
            { duration: CRECER, easing: 'cubic-bezier(.55,0,.35,1)' },
          );
      // durante el relevo, la que sale va por encima de todo
      sale.style.zIndex = '3';
      animacion.onfinish = () => { sale.style.zIndex = ''; };
      preparar();
    };

    preparar();
    // empieza cuando la primera foto está cargada
    const empezar = () => setInterval(relevar, PAUSA + CRECER);
    if (fotos[0].complete) empezar(); else fotos[0].addEventListener('load', empezar, { once: true });
  }
</script>
