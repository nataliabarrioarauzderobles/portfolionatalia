---
// CONTACTO: una sola columna centrada → foto, texto breve justificado, datos y botones.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { textos, type Idioma } from '../../i18n/textos';
import { contacto, enlaceWhatsApp, url } from '../../utils/enlaces';
import { imagen } from '../../utils/imagenes';
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = textos[idioma];

// Texto PROVISIONAL: sustitúyelo por el tuyo
const sobreMi = {
  es: 'Soy Natalia Barrio Araúz de Robles, Tali. Trabajo entre la pintura y el diseño. En mi pintura las formas se abrazan, se encajan y se desbordan: cuerpos y rostros que se convierten en volumen, color y estructura. En el diseño llevo ese mismo lenguaje al objeto, al mobiliario, a la moda y a la identidad de marca.',
  en: "I'm Natalia Barrio Araúz de Robles, Tali. I work between painting and design. In my paintings, forms embrace, interlock and overflow: bodies and faces turned into volume, colour and structure. In design I take that same language into objects, furniture, fashion and brand identity.",
}[idioma];
---

<Base idioma={idioma} pagina="contacto" titulo={t.contactoTitulo}>
  <div class="contenedor columna">
    <h1 class="titulo-pagina">{t.contactoTitulo}</h1>

    <section class="sobre-mi" aria-labelledby="titulo-sobre-mi">
      <Image src={imagen('sobre-mi/retrato.jpg')} alt={contacto.nombre} widths={[360, 720]} sizes="360px" class="retrato" />
      <h2 id="titulo-sobre-mi" class="etiqueta">{t.sobreMi}</h2>
      <p class="texto" lang={idioma}>{sobreMi}</p>
    </section>

    <hr />

    <section class="datos" aria-label={t.contactoTitulo}>
      <dl>
        <div>
          <dt>{t.email}</dt>
          <dd><a href={`mailto:${contacto.email}`}>{contacto.email}</a></dd>
        </div>
        <div>
          <dt>{t.instagram}</dt>
          <dd><a href={`https://instagram.com/${contacto.instagram}`} target="_blank" rel="noopener">@{contacto.instagram}</a></dd>
        </div>
        <div>
          <dt>{t.telefono}</dt>
          <dd><a href={`tel:${contacto.telefono.replace(/\s/g, '')}`}>{contacto.telefono}</a></dd>
        </div>
      </dl>
      <div class="botones">
        <a class="boton boton-whatsapp" href={enlaceWhatsApp(t.mensajeContacto)} target="_blank" rel="noopener">{t.escribemeWhatsApp}</a>
        <a class="boton" href={url('cv-natalia-barrio.pdf')} download>{t.descargarCV}</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .columna { max-width: 640px; text-align: center; }
  .columna .titulo-pagina { margin-bottom: clamp(2rem, 5vw, 3.5rem); }

  .sobre-mi { display: flex; flex-direction: column; align-items: center; }
  .retrato { width: min(100%, 340px); height: auto; margin-bottom: 2.5rem; }
  .sobre-mi .etiqueta { font-family: var(--fuente-texto); font-weight: 400; margin-bottom: 1.2rem; }
  /* Texto breve, justificado y centrado en la página */
  .texto {
    max-width: 480px;
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.8;
    text-align: justify;
    text-align-last: center;
    hyphens: auto;
  }

  hr { width: 48px; margin: clamp(2.5rem, 6vw, 4rem) auto; border: 0; border-top: 1px solid var(--texto); }

  /* Datos: etiqueta pequeña en mayúsculas y el dato en un tipo firme y sobrio */
  dl { display: grid; gap: 1.6rem; margin: 0 0 3rem; }
  dt { font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--texto-suave); margin-bottom: 0.35rem; }
  dd {
    margin: 0;
    font-family: var(--fuente-titulos);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    word-break: break-word;
  }
  dd a { transition: color 0.2s; }
  dd a:hover { color: var(--texto-suave); }

  .botones { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; }
</style>
