---
// OBRAS POR ENCARGO (dentro de Colaboremos): sencillo y sin carga de texto.
//  · El título, la foto en el centro y una frase.
//  · Dos botones: "Preguntas frecuentes" (se despliegan ahí mismo) y "Contacta conmigo" (abre WhatsApp).
// Las respuestas de las preguntas frecuentes se cambian aquí abajo, en "dudas".
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { type Idioma } from '../../i18n/textos';
import { enlaceWhatsApp } from '../../utils/enlaces';
import { imagen } from '../../utils/imagenes';
interface Props { idioma: Idioma }
const { idioma } = Astro.props;

const tx = {
  es: {
    titulo: 'Obras por encargo',
    frase: 'Pinto piezas únicas por encargo, pensadas para tu espacio.',
    preguntas: 'Preguntas frecuentes',
    contactar: 'Contacta conmigo',
    mensaje: 'Hola Natalia, me gustaría encargarte un cuadro.',
    dudas: [
      { p: '¿Cuánto cuesta?', r: 'Depende sobre todo del tamaño. Como referencia, un cuadro de 60 × 60 cm está en 900 € y uno de 130 × 90 cm en 2.000 €. Te doy un presupuesto cerrado antes de empezar.' },
      { p: '¿En qué puede estar inspirado?', r: 'En cualquiera de mis series (DE-formando, Open, Interfaces) o en algo nuevo. Mándame un par de cuadros míos que te gusten y una foto del espacio.' },
      { p: '¿Cómo funciona?', r: 'Me cuentas tu idea, te envío un boceto con medidas, precio y plazo, y al aprobarlo se abona una señal del 50 %. El resto, con el cuadro terminado.' },
      { p: '¿Cuánto tarda?', r: 'Te indico el plazo en la propuesta. Si tienes una fecha concreta (un regalo, una inauguración), dímela desde el principio.' },
      { p: '¿Haces envíos?', r: 'Sí. El cuadro viaja embalado y protegido; el envío va incluido en el presupuesto.' },
    ],
  },
  en: {
    titulo: 'Commissioned works',
    frase: 'I paint one-off pieces on commission, made for your space.',
    preguntas: 'Frequently asked questions',
    contactar: 'Contact me',
    mensaje: "Hi Natalia, I'd like to commission a painting.",
    dudas: [
      { p: 'How much does it cost?', r: 'It mainly depends on size. As a reference, a 60 × 60 cm painting is €900 and a 130 × 90 cm one is €2,000. I give you a fixed quote before starting.' },
      { p: 'What can it be inspired by?', r: 'Any of my series (DE-formando, Open, Interfaces) or something new. Send me a couple of my paintings you like and a photo of the space.' },
      { p: 'How does it work?', r: 'You tell me your idea, I send you a sketch with size, price and timing, and once approved a 50% deposit is paid. The rest when the painting is finished.' },
      { p: 'How long does it take?', r: 'The timeline is in the proposal. If you have a specific date (a gift, an opening), tell me from the start.' },
      { p: 'Do you ship?', r: 'Yes. The painting travels packed and protected; shipping is included in the quote.' },
    ],
  },
}[idioma];
---

<Base idioma={idioma} pagina="encargos" titulo={tx.titulo}>
  <section class="encargo">
    <h1>{tx.titulo}</h1>
    <figure class="foto">
      <Image src={imagen('encargos/encargos.jpg')} alt="" widths={[500, 800, 1100]} sizes="(max-width: 760px) 80vw, 380px" loading="eager" />
    </figure>
    <p class="frase">{tx.frase}</p>
    <p class="botones">
      <button type="button" class="accion" data-abrir-dudas aria-expanded="false" aria-controls="dudas">{tx.preguntas} ↓</button>
      <a class="accion" href={enlaceWhatsApp(tx.mensaje)} target="_blank" rel="noopener">{tx.contactar} →</a>
    </p>

    <div class="dudas" id="dudas" hidden>
      {tx.dudas.map((d, i) => (
        <details open={i === 0}>
          <summary>{d.p}<span aria-hidden="true">+</span></summary>
          <p>{d.r}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .encargo { width: min(560px, 100%); margin: 0 auto; padding: clamp(2.5rem, 8vh, 5rem) var(--margen) clamp(4rem, 10vh, 7rem); display: grid; justify-items: center; text-align: center; }
  h1 { margin: 0 0 clamp(1.4rem, 4vh, 2.4rem); font-size: clamp(2rem, 5vw, 3.2rem); letter-spacing: -0.03em; }
  .foto { margin: 0; }
  .foto :global(img) { display: block; height: min(46svh, 440px); width: auto; max-width: 80vw; object-fit: cover; }
  .frase { margin: 1.8rem 0 1.6rem; font-size: 0.95rem; line-height: 1.6; color: #444; }
  .botones { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem 2.4rem; margin: 0; }
  .accion { padding: 0; border: 0; background: none; font: inherit; cursor: pointer; font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.02em; color: var(--texto); transition: color 0.25s ease; }
  .accion:hover, .accion:focus-visible { color: var(--texto-tenue); }

  /* PREGUNTAS FRECUENTES: se despliegan al pulsar */
  .dudas { width: 100%; margin-top: clamp(2.5rem, 6vh, 3.5rem); text-align: left; border-top: 1px solid var(--linea); scroll-margin-top: 6rem; animation: aparecer 0.4s ease; }
  @keyframes aparecer { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  details { border-bottom: 1px solid var(--linea); }
  summary { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 0; cursor: pointer; list-style: none; font-size: 0.9rem; }
  summary::-webkit-details-marker { display: none; }
  summary span { color: var(--texto-tenue); transition: transform 0.3s; }
  details[open] summary span { transform: rotate(45deg); }
  details p { margin: 0 0 1.1rem; font-size: 0.86rem; line-height: 1.65; color: #555; }
</style>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-abrir-dudas]');
  const dudas = document.getElementById('dudas');
  if (boton && dudas) {
    const abrir = (abierto: boolean) => {
      dudas.hidden = !abierto;
      boton.setAttribute('aria-expanded', String(abierto));
    };
    boton.addEventListener('click', () => {
      const abierto = dudas.hidden;
      abrir(abierto);
      if (abierto) dudas.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    if (location.hash === '#dudas') abrir(true);
  }
</script>
