---
// COLABOREMOS: dos caminos, sin más.
//  · Obras por encargo → lleva a su página (foto, una frase, preguntas frecuentes y WhatsApp).
//  · Colaboración para inmobiliarias, hoteles y restaurantes → al pulsar se despliega aquí mismo
//    un texto corto y el botón para pedir una propuesta.
// La foto de la colaboración es provisional (el local de La Cabezona) hasta tener la definitiva.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { textos, type Idioma } from '../../i18n/textos';
import { contacto, enlaceWhatsApp, rutaIdioma } from '../../utils/enlaces';
import { imagen } from '../../utils/imagenes';
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = textos[idioma];

const fotoEncargo = imagen('encargos/encargos.jpg');
const fotoEspacios = imagen('diseno/la-cabezona/02-local.jpg'); // provisional

const tx = {
  es: {
    encargo: 'Obras por encargo',
    espacios: 'Colaboración para inmobiliarias, hoteles y restaurantes',
    texto: 'Decoro tu espacio con obra original, en una propuesta personalizada según la vivienda, el hotel o el local: qué piezas, de qué tamaño y dónde van.',
    aval: 'He pintado murales para La Cabezona y R.A.C.E., y mi obra se ha expuesto en Café DOPA y Zielo Shopping Centre.',
    pedir: 'Pedir una propuesta',
    mensaje: 'Hola Natalia, me gustaría una propuesta de decoración con arte para un espacio.',
    asunto: 'Propuesta de arte para un espacio',
    email: 'Escribir un email',
  },
  en: {
    encargo: 'Commissioned works',
    espacios: 'Collaborations for real estate, hotels and restaurants',
    texto: 'I dress your space with original work, in a proposal tailored to the home, the hotel or the venue: which pieces, what size and where they go.',
    aval: 'I have painted murals for La Cabezona and R.A.C.E., and my work has been shown at Café DOPA and Zielo Shopping Centre.',
    pedir: 'Ask for a proposal',
    mensaje: 'Hi Natalia, I would like an art proposal for a space.',
    asunto: 'Art proposal for a space',
    email: 'Send an email',
  },
}[idioma];
---

<Base idioma={idioma} pagina="colaboremos" titulo={t.colaboremosTitulo}>
  <section class="colaboremos">
    <h1>{t.colaboremosTitulo}</h1>

    <ul class="caminos">
      <li>
        <a class="camino" href={rutaIdioma(idioma, 'encargos')}>
          <Image src={fotoEncargo} alt="" widths={[500, 900, 1300]} sizes="(max-width: 760px) 100vw, 45vw" loading="eager" />
          <strong>{tx.encargo} →</strong>
        </a>
      </li>
      <li>
        <button type="button" class="camino" data-abrir-espacios aria-expanded="false" aria-controls="espacios">
          <Image src={fotoEspacios} alt="" widths={[500, 900, 1300]} sizes="(max-width: 760px) 100vw, 45vw" loading="eager" />
          <strong>{tx.espacios} <span class="flecha" aria-hidden="true">↓</span></strong>
        </button>
      </li>
    </ul>

    <!-- al pulsar la colaboración: un texto corto y cómo pedir la propuesta -->
    <div class="espacios" id="espacios" hidden>
      <p>{tx.texto}</p>
      <p class="aval">{tx.aval}</p>
      <p class="botones">
        <a class="accion" href={enlaceWhatsApp(tx.mensaje)} target="_blank" rel="noopener">{tx.pedir} →</a>
        <a class="accion" href={`mailto:${contacto.email}?subject=${encodeURIComponent(tx.asunto)}`}>{tx.email} →</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .colaboremos { width: min(1100px, 100%); margin: 0 auto; padding: clamp(2.5rem, 8vh, 5rem) var(--margen) clamp(4rem, 10vh, 7rem); }
  h1 { margin: 0 0 clamp(2rem, 6vh, 3.5rem); text-align: center; font-size: clamp(2rem, 5vw, 3.2rem); letter-spacing: -0.03em; }

  /* LOS DOS CAMINOS */
  .caminos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem clamp(1.5rem, 4vw, 3rem); align-items: start; }
  .camino { display: grid; gap: 1rem; width: 100%; padding: 0; border: 0; background: none; font: inherit; text-align: left; cursor: pointer; color: var(--texto); }
  .camino :global(img) { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: opacity 0.3s ease; }
  .camino strong { font-weight: 400; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.02em; line-height: 1.4; transition: color 0.25s ease; }
  .camino:hover :global(img) { opacity: 0.85; }
  .camino:hover strong, .camino:focus-visible strong { color: var(--texto-tenue); }
  .flecha { display: inline-block; transition: transform 0.3s ease; }
  [aria-expanded='true'] .flecha { transform: rotate(180deg); }

  /* EL TEXTO DE LA COLABORACIÓN, desplegado */
  .espacios { max-width: 560px; margin: clamp(2.5rem, 6vh, 3.5rem) auto 0; text-align: center; scroll-margin-top: 6rem; animation: aparecer 0.4s ease; }
  @keyframes aparecer { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .espacios p { margin: 0; font-size: 0.95rem; line-height: 1.65; color: #444; }
  .espacios .aval { margin-top: 0.9rem; font-size: 0.82rem; color: var(--texto-suave); }
  .espacios .botones { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem 2.2rem; margin-top: 1.6rem; }
  .accion { font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.02em; color: var(--texto); transition: color 0.25s ease; }
  .accion:hover, .accion:focus-visible { color: var(--texto-tenue); }

  @media (max-width: 760px) { .caminos { grid-template-columns: 1fr; } }
</style>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-abrir-espacios]');
  const panel = document.getElementById('espacios');
  if (boton && panel) {
    const abrir = (abierto: boolean) => {
      panel.hidden = !abierto;
      boton.setAttribute('aria-expanded', String(abierto));
    };
    boton.addEventListener('click', () => {
      const abierto = panel.hidden;
      abrir(abierto);
      if (abierto) panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
    if (location.hash === '#espacios') abrir(true);
  }
</script>
