---
// "DISEÑA TU PIEZA": el cliente elige modelo, colores y tamaño,
// y al pulsar el botón se abre WhatsApp con el encargo ya redactado.
import { Image } from 'astro:assets';
import { coloresPieza, modelosPieza, tamanosPieza } from '../data/proyectos';
import type { Idioma } from '../i18n/textos';
import { contacto, enlaceWhatsApp } from '../utils/enlaces';
import { imagen } from '../utils/imagenes';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;

const tx = {
  es: {
    titulo: 'Diseña tu pieza',
    intro: 'Elige un modelo de partida, los colores y el tamaño. Al pulsar el botón se abrirá WhatsApp con tu encargo ya escrito para que me lo envíes.',
    modelo: '1. Modelo', libre: 'Diseño libre', colorPrincipal: '2. Color principal', colorSecundario: '3. Color secundario',
    tamano: '4. Tamaño', comentarios: '5. Cuéntame tu idea (opcional)', placeholder: 'Forma, detalles, para qué espacio es…',
    boton: 'Enviar mi encargo por WhatsApp',
    saludo: 'Hola Natalia, me gustaría encargar una pieza personalizada:',
    etiquetas: { modelo: 'Modelo', principal: 'Color principal', secundario: 'Color secundario', tamano: 'Tamaño', comentarios: 'Comentarios' },
    sinElegir: 'sin elegir',
  },
  en: {
    titulo: 'Design your piece',
    intro: 'Choose a starting model, the colours and the size. When you press the button, WhatsApp will open with your request already written, ready to send to me.',
    modelo: '1. Model', libre: 'Free design', colorPrincipal: '2. Main colour', colorSecundario: '3. Second colour',
    tamano: '4. Size', comentarios: '5. Tell me your idea (optional)', placeholder: 'Shape, details, the space it is for…',
    boton: 'Send my request on WhatsApp',
    saludo: 'Hi Natalia, I would like to commission a custom piece:',
    etiquetas: { modelo: 'Model', principal: 'Main colour', secundario: 'Second colour', tamano: 'Size', comentarios: 'Comments' },
    sinElegir: 'not chosen',
  },
}[idioma];
---

<section class="pieza" id="disena-tu-pieza">
  <h3>{tx.titulo}</h3>
  <p class="intro">{tx.intro}</p>

  <form
    data-pieza
    data-numero={contacto.whatsapp}
    data-saludo={tx.saludo}
    data-etiquetas={JSON.stringify(tx.etiquetas)}
    data-sin-elegir={tx.sinElegir}
  >
    <fieldset>
      <legend>{tx.modelo}</legend>
      <div class="modelos">
        {modelosPieza.map((m, i) => (
          <label class="modelo">
            <input type="radio" name="modelo" value={m.nombre[idioma]} checked={i === 0} />
            <Image src={imagen(m.imagen)} alt="" width={240} />
            <span>{m.nombre[idioma]}</span>
          </label>
        ))}
        <label class="modelo libre">
          <input type="radio" name="modelo" value={tx.libre} />
          <span class="libre-icono" aria-hidden="true">✎</span>
          <span>{tx.libre}</span>
        </label>
      </div>
    </fieldset>

    {[['principal', tx.colorPrincipal], ['secundario', tx.colorSecundario]].map(([campo, leyenda]) => (
      <fieldset>
        <legend>{leyenda}</legend>
        <div class="colores">
          {coloresPieza.map((c) => (
            <label class="color" title={c.nombre[idioma]}>
              <input type="radio" name={campo} value={c.nombre[idioma]} />
              <span class="muestra" style={`background:${c.hex}`}></span>
              <span class="solo-lector">{c.nombre[idioma]}</span>
            </label>
          ))}
        </div>
      </fieldset>
    ))}

    <fieldset>
      <legend>{tx.tamano}</legend>
      <select name="tamano">
        {tamanosPieza.map((s) => <option value={s.nombre[idioma]}>{s.nombre[idioma]}</option>)}
      </select>
    </fieldset>

    <fieldset>
      <legend>{tx.comentarios}</legend>
      <textarea name="comentarios" rows="3" placeholder={tx.placeholder}></textarea>
    </fieldset>

    <a class="boton boton-whatsapp enviar" href={enlaceWhatsApp(tx.saludo)} target="_blank" rel="noopener" data-enviar>
      {tx.boton}
    </a>
  </form>
</section>

<style>
  .pieza {
    margin-top: 3rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--fondo-suave);
    border: 1px solid var(--linea);
  }
  .pieza h3 { font-size: clamp(1.6rem, 3vw, 2.1rem); }
  .intro { max-width: 620px; color: var(--texto-suave); }
  fieldset { border: 0; padding: 0; margin: 1.8rem 0 0; }
  legend { font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--texto-suave); margin-bottom: 0.8rem; }

  .modelos { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 0.8rem; }
  .modelo {
    display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
    padding: 0.5rem; border: 1px solid var(--linea); cursor: pointer; text-align: center; font-size: 0.85rem;
  }
  .modelo img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .modelo input { position: absolute; opacity: 0; }
  .modelo:has(input:checked) { border-color: var(--texto); background: var(--fondo); }
  .modelo:has(input:focus-visible) { outline: 2px solid var(--acento-oscuro); }
  .libre-icono { display: grid; place-items: center; width: 100%; aspect-ratio: 1; font-size: 2rem; color: var(--texto-suave); background: var(--fondo); }

  .colores { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .color input { position: absolute; opacity: 0; }
  .muestra {
    display: block; width: 2.2rem; height: 2.2rem; border-radius: 50%;
    border: 1px solid var(--linea); cursor: pointer; transition: transform 0.15s;
  }
  .color:has(input:checked) .muestra { outline: 2px solid var(--texto); outline-offset: 3px; }
  .color:has(input:focus-visible) .muestra { outline: 2px solid var(--acento-oscuro); outline-offset: 3px; }
  .muestra:hover { transform: scale(1.08); }

  select, textarea {
    width: 100%; max-width: 480px; padding: 0.7rem; font: inherit;
    background: var(--fondo); color: var(--texto); border: 1px solid var(--linea);
  }
  .enviar { margin-top: 2rem; }
</style>

<script>
  // Cada vez que cambia algo en el formulario, actualizamos el enlace de WhatsApp
  document.querySelectorAll<HTMLFormElement>('form[data-pieza]').forEach((form) => {
    const enviar = form.querySelector<HTMLAnchorElement>('[data-enviar]')!;
    const et = JSON.parse(form.dataset.etiquetas!);
    const sinElegir = form.dataset.sinElegir!;
    const actualizar = () => {
      const datos = new FormData(form);
      const valor = (campo: string) => String(datos.get(campo) ?? '').trim() || sinElegir;
      const lineas = [
        form.dataset.saludo,
        `• ${et.modelo}: ${valor('modelo')}`,
        `• ${et.principal}: ${valor('principal')}`,
        `• ${et.secundario}: ${valor('secundario')}`,
        `• ${et.tamano}: ${valor('tamano')}`,
      ];
      const comentarios = String(datos.get('comentarios') ?? '').trim();
      if (comentarios) lineas.push(`• ${et.comentarios}: ${comentarios}`);
      enviar.href = `https://wa.me/${form.dataset.numero}?text=${encodeURIComponent(lineas.join('\n'))}`;
    };
    form.addEventListener('input', actualizar);
    form.addEventListener('change', actualizar);
    actualizar();
  });
</script>
