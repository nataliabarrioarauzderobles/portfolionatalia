---
// VISOR COMPARTIDO: un único <dialog> que muestra en grande cualquier imagen
// con el atributo data-ampliar="url-de-la-imagen-grande".
import { textos, type Idioma } from '../i18n/textos';
interface Props { idioma: Idioma }
const t = textos[Astro.props.idioma];
---

<dialog class="visor-imagen" id="visor-imagen">
  <button class="cerrar" type="button" aria-label={t.cerrar}>×</button>
  <img alt="" />
</dialog>

<style>
  .visor-imagen {
    max-width: 94vw;
    max-height: 92vh;
    padding: clamp(0.5rem, 2vw, 1.5rem);
    border: 0;
    background: var(--fondo);
  }
  .visor-imagen::backdrop { background: rgba(255, 255, 255, 0.94); }
  .visor-imagen img { max-width: 88vw; max-height: 84vh; width: auto; margin: 0 auto; object-fit: contain; }
  .cerrar {
    position: absolute; top: 0.2rem; right: 0.6rem;
    border: 0; background: none; font-size: 2.2rem; line-height: 1; cursor: pointer; color: var(--texto);
  }
</style>

<script>
  const visor = document.getElementById('visor-imagen') as HTMLDialogElement;
  const img = visor.querySelector('img')!;
  document.querySelectorAll<HTMLButtonElement>('[data-ampliar]').forEach((boton) => {
    boton.addEventListener('click', () => {
      img.src = boton.dataset.ampliar!;
      img.alt = boton.querySelector('img')?.alt ?? '';
      visor.showModal();
    });
  });
  visor.querySelector('.cerrar')!.addEventListener('click', () => visor.close());
  visor.addEventListener('click', (e) => { if (e.target === visor || e.target === img) visor.close(); });
</script>
