---
// CABECERA: menú a la izquierda, tu firma en el centro y el cambio de idioma a la derecha.
import { Image } from 'astro:assets';
import { textos, type Idioma } from '../i18n/textos';
import { rutaIdioma } from '../utils/enlaces';
import { imagen } from '../utils/imagenes';

interface Props { idioma: Idioma; pagina: string }
const { idioma, pagina } = Astro.props;
const t = textos[idioma];
const enlaces = [
  { pagina: 'pintura', texto: t.menuPintura },
  { pagina: 'diseno', texto: t.menuDiseno },
  { pagina: 'contacto', texto: t.menuContacto },
];
---

<header class="cabecera">
  <div class="contenedor fila">
    <!-- Tres zonas: menú a la izquierda, firma en el centro, idioma a la derecha -->
    <nav class="menu" aria-label="Menú">
      <ul>
        {enlaces.map((e) => (
          <li>
            <a href={rutaIdioma(idioma, e.pagina)} aria-current={pagina === e.pagina ? 'page' : undefined}>{e.texto}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a href={rutaIdioma(idioma)} class="firma" aria-label={t.inicio}>
      <Image src={imagen('marca/firma.png')} alt="Tali" width={240} />
    </a>
    <div class="idiomas">
      <a href={rutaIdioma('es', pagina)} aria-current={idioma === 'es' ? 'true' : undefined} lang="es">ES</a>
      <span aria-hidden="true">/</span>
      <a href={rutaIdioma('en', pagina)} aria-current={idioma === 'en' ? 'true' : undefined} lang="en">EN</a>
    </div>
  </div>
</header>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--fondo) 94%, transparent);
    backdrop-filter: blur(6px);
  }
  .fila {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
  }
  .firma img { height: 40px; width: auto; }
  .menu ul {
    display: flex;
    gap: clamp(0.9rem, 2.5vw, 1.8rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu { font-size: 0.82rem; font-weight: 300; }
  .idiomas { font-family: var(--fuente-mono); font-size: 0.66rem; letter-spacing: 0.06em; }
  .idiomas { display: flex; justify-content: flex-end; gap: 0.35rem; color: var(--texto-tenue); }
  .menu a[aria-current='page'] { color: var(--texto); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  a { color: var(--texto-suave); transition: color 0.2s; }
  a:hover, a[aria-current] { color: var(--texto); }

  /* En el móvil: firma arriba en el centro; menú e idioma debajo, en una línea */
  @media (max-width: 640px) {
    .fila { grid-template-columns: 1fr auto; row-gap: 0.6rem; padding-top: 0.8rem; padding-bottom: 0.8rem; }
    .firma { grid-column: 1 / -1; grid-row: 1; justify-self: center; }
    .firma img { height: 32px; }
    .menu { grid-row: 2; }
    .idiomas { grid-row: 2; }
    .menu ul { gap: 0.9rem; }
  }
</style>
