---
// CABECERA: tu firma a la izquierda, el menú y el cambio de idioma a la derecha.
import { Image } from 'astro:assets';
import { textos, type Idioma } from '../i18n/textos';
import { rutaIdioma } from '../utils/enlaces';
import { imagen } from '../utils/imagenes';

interface Props { idioma: Idioma; pagina: string }
const { idioma, pagina } = Astro.props;
const t = textos[idioma];
const enlaces = [
  { pagina: 'pintura', texto: t.menuPintura },
  { pagina: 'diseno', texto: t.menuDiseno },
  { pagina: 'contacto', texto: t.menuContacto },
];
---

<header class="cabecera">
  <div class="contenedor fila">
    <a href={rutaIdioma(idioma)} class="firma" aria-label={t.inicio}>
      <Image src={imagen('marca/firma.png')} alt="Tali" width={240} />
    </a>
    <nav aria-label="Menú">
      <ul>
        {enlaces.map((e) => (
          <li>
            <a href={rutaIdioma(idioma, e.pagina)} aria-current={pagina === e.pagina ? 'page' : undefined}>{e.texto}</a>
          </li>
        ))}
        <li class="idiomas">
          <a href={rutaIdioma('es', pagina)} aria-current={idioma === 'es' ? 'true' : undefined} lang="es">ES</a>
          <span aria-hidden="true">|</span>
          <a href={rutaIdioma('en', pagina)} aria-current={idioma === 'en' ? 'true' : undefined} lang="en">EN</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--fondo) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--linea);
  }
  .fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }
  .firma img { height: 42px; width: auto; }
  ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.2rem);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  a { color: var(--texto-suave); transition: color 0.2s; }
  a:hover, a[aria-current] { color: var(--texto); }
  nav a[aria-current='page'] { border-bottom: 1px solid var(--acento); padding-bottom: 2px; }
  .idiomas { display: flex; gap: 0.4rem; color: var(--linea); }
  /* En el móvil: firma arriba y menú centrado debajo, más compacto */
  @media (max-width: 560px) {
    .fila { justify-content: center; padding-top: 0.6rem; padding-bottom: 0.6rem; gap: 0.4rem; }
    .firma img { height: 34px; }
    ul { flex-wrap: wrap; justify-content: center; gap: 0.5rem 1rem; font-size: 0.68rem; letter-spacing: 0.1em; }
  }
</style>
