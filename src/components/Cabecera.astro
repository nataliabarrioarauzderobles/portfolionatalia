---
// CABECERA
//  · En la home: tu firma en el centro y, justo debajo, las secciones en letra fina
//    (crecen un poco y se oscurecen al pasar el cursor). Aparecen a la vez que la imagen.
//  · En las demás páginas: la sección en la que estás a la izquierda, la firma en el centro
//    y a la derecha el idioma y el menú hamburguesa. Al pulsarlo, las secciones aparecen
//    debajo, a la derecha, como botones.
import { Image } from 'astro:assets';
import { textos, type Idioma } from '../i18n/textos';
import { rutaIdioma } from '../utils/enlaces';
import { imagen } from '../utils/imagenes';

interface Props { idioma: Idioma; pagina: string }
const { idioma, pagina } = Astro.props;
const t = textos[idioma];
const enlaces = [
  { pagina: 'pintura', texto: t.menuPintura },
  { pagina: 'diseno', texto: t.menuDiseno },
  { pagina: 'encargos', texto: t.menuEncargos },
  { pagina: 'contacto', texto: t.menuContacto },
];
const enHome = pagina === '';
const actual = enlaces.find((e) => e.pagina === pagina);
---

<header class:list={['cabecera', { 'en-home': enHome }]}>
  <div class="contenedor fila">
    <span class="donde mono">{actual?.texto}</span>
    <div class="centro">
      <a href={rutaIdioma(idioma)} class="firma" aria-label={t.inicio}>
        <Image src={imagen('marca/firma.png')} alt="Tali" width={240} />
      </a>
      {enHome && (
        <nav class="secciones" aria-label={t.menu}>
          {enlaces.map((e) => <a href={rutaIdioma(idioma, e.pagina)}>{e.texto}</a>)}
        </nav>
      )}
    </div>
    <div class="derecha">
      <div class="idiomas">
        <a href={rutaIdioma('es', pagina)} aria-current={idioma === 'es' ? 'true' : undefined} lang="es">ES</a>
        <span aria-hidden="true">/</span>
        <a href={rutaIdioma('en', pagina)} aria-current={idioma === 'en' ? 'true' : undefined} lang="en">EN</a>
      </div>
      {!enHome && (
        <div class="menu">
          <button type="button" class="abrir-menu" data-abrir-menu aria-expanded="false" aria-controls="menu-secciones" aria-label={t.menu}>
            <span class="lineas" aria-hidden="true"><i></i><i></i><i></i></span>
          </button>
          <!-- las secciones, como botones, debajo del menú -->
          <nav class="botones-menu" id="menu-secciones" aria-label={t.menu} hidden>
            <a href={rutaIdioma(idioma)} style="--i:0">{t.inicio}</a>
            {enlaces.map((e, i) => (
              <a href={rutaIdioma(idioma, e.pagina)} aria-current={pagina === e.pagina ? 'page' : undefined} style={`--i:${i + 1}`}>{e.texto}</a>
            ))}
          </nav>
        </div>
      )}
    </div>
  </div>
</header>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--fondo) 94%, transparent);
    backdrop-filter: blur(6px);
  }
  .fila {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
  }
  .centro { display: grid; justify-items: center; gap: 0.7rem; }
  .firma img { height: 40px; width: auto; }
  a { color: var(--texto-suave); transition: color 0.2s; }
  a:hover, a[aria-current] { color: var(--texto); }
  .donde { color: var(--texto-suave); }

  /* HOME: firma y, debajo, las secciones en letra fina */
  .en-home .fila { align-items: start; padding-top: 1.4rem; }
  .en-home .derecha { padding-top: 0.8rem; }
  .secciones { display: flex; gap: clamp(1.1rem, 2.4vw, 2rem); }
  .secciones a {
    display: inline-block;
    font-size: 0.82rem; font-weight: 300; letter-spacing: 0.02em;
    color: var(--texto-suave);
    transition: transform 0.3s ease, color 0.3s ease;
  }
  .secciones a:hover, .secciones a:focus-visible { transform: scale(1.12); color: var(--texto); }

  .derecha { display: flex; justify-content: flex-end; align-items: center; gap: 1.4rem; }
  .idiomas { display: flex; gap: 0.35rem; font-family: var(--fuente-mono); font-size: 0.66rem; letter-spacing: 0.06em; color: var(--texto-tenue); }

  /* MENÚ: hamburguesa y, al pulsar, botones a la derecha */
  .menu { position: relative; }
  .abrir-menu { display: grid; place-items: center; width: 36px; height: 36px; margin-right: -8px; padding: 0; border: 0; background: none; cursor: pointer; color: var(--texto); }
  .lineas { position: relative; display: block; width: 22px; height: 12px; }
  .lineas i { position: absolute; left: 0; width: 100%; height: 1px; background: currentColor; transition: transform 0.3s ease, opacity 0.3s ease, top 0.3s ease; }
  .lineas i:nth-child(1) { top: 0; }
  .lineas i:nth-child(2) { top: 50%; }
  .lineas i:nth-child(3) { top: 100%; }
  /* abierto: las líneas forman una × */
  .abrir-menu[aria-expanded='true'] .lineas i:nth-child(1) { top: 50%; transform: rotate(45deg); }
  .abrir-menu[aria-expanded='true'] .lineas i:nth-child(2) { opacity: 0; }
  .abrir-menu[aria-expanded='true'] .lineas i:nth-child(3) { top: 50%; transform: rotate(-45deg); }

  .botones-menu { position: absolute; top: calc(100% + 0.8rem); right: -0.5rem; display: grid; justify-items: end; gap: 0.45rem; }
  .botones-menu a {
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--linea); border-radius: 999px;
    background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(6px);
    font-size: 0.86rem; font-weight: 300; white-space: nowrap; color: var(--texto);
    box-shadow: 0 6px 18px -10px rgba(0, 0, 0, 0.25);
    animation: botonEntra 0.35s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
    animation-delay: calc(var(--i) * 45ms);
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }
  .botones-menu a:hover, .botones-menu a:focus-visible { background: var(--texto); border-color: var(--texto); color: var(--fondo); }
  .botones-menu a[aria-current='page'] { border-color: var(--texto); }
  @keyframes botonEntra { from { opacity: 0; transform: translateX(10px); } to { opacity: 1; transform: none; } }

  @media (max-width: 640px) {
    .fila { padding-top: 0.8rem; padding-bottom: 0.8rem; }
    .firma img { height: 32px; }
    .en-home .fila { grid-template-columns: 1fr; }
    .en-home .donde { display: none; }
    .en-home .derecha { position: absolute; top: 0.9rem; right: var(--margen); padding: 0; }
    .secciones { gap: 1rem; flex-wrap: wrap; justify-content: center; }
    .derecha { gap: 0.9rem; }
  }
</style>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-abrir-menu]');
  const menu = document.getElementById('menu-secciones');
  if (boton && menu) {
    const abrir = (si: boolean) => { menu.hidden = !si; boton.setAttribute('aria-expanded', String(si)); };
    boton.addEventListener('click', (e) => { e.stopPropagation(); abrir(menu.hidden); });
    // se cierra al pulsar fuera, con Esc o al bajar por la página
    document.addEventListener('click', (e) => { if (!menu.hidden && !menu.contains(e.target as Node)) abrir(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') abrir(false); });
    let desde = 0;
    window.addEventListener('scroll', () => {
      if (menu.hidden) { desde = window.scrollY; return; }
      if (Math.abs(window.scrollY - desde) > 120) abrir(false);
    }, { passive: true });
  }
</script>
