---
// CABECERA (inspirada en avea.studio): fija arriba, pequeña y sobria.
//  · Izquierda: tu firma (vuelve a la home).
//  · Centro: "MADRID" y la hora en directo, como detalle.
//  · Derecha: las secciones en mayúsculas pequeñas (la actual en negro, las demás en gris) y el idioma.
//  · En el móvil: arriba la firma y el idioma; debajo, las cuatro secciones siempre a la vista.
import { Image } from 'astro:assets';
import { textos, type Idioma } from '../i18n/textos';
import { rutaIdioma } from '../utils/enlaces';
import { imagen } from '../utils/imagenes';

interface Props { idioma: Idioma; pagina: string }
const { idioma, pagina } = Astro.props;
const t = textos[idioma];
const enlaces = [
  { pagina: 'pintura', texto: t.menuPintura },
  { pagina: 'diseno', texto: t.menuDiseno },
  { pagina: 'crea-tu-pieza', texto: t.menuPieza },
  { pagina: 'encargos', texto: t.menuEncargos },
  { pagina: 'contacto', texto: t.menuContacto },
];
const otroIdioma: Idioma = idioma === 'es' ? 'en' : 'es';
const cambiar = { es: 'Ver en inglés', en: 'Ver en español' }[idioma];
---

<header class="cabecera">
  <div class="fila">
    <a href={rutaIdioma(idioma)} class="firma" aria-label={t.inicio}>
      <Image src={imagen('marca/firma.png')} alt="Tali" width={200} />
    </a>
    <p class="hora" aria-hidden="true">Madrid <span data-hora></span></p>
    <nav class="secciones" aria-label={t.menu}>
      {enlaces.map((e) => (
        <a href={rutaIdioma(idioma, e.pagina)} aria-current={pagina === e.pagina ? 'page' : undefined}>{e.texto}</a>
      ))}
      <a class="idioma" href={rutaIdioma(otroIdioma, pagina)} lang={otroIdioma} hreflang={otroIdioma} title={cambiar} aria-label={cambiar}>{idioma.toUpperCase()}</a>
    </nav>
  </div>
</header>


<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--fondo) 92%, transparent);
    backdrop-filter: blur(6px);
  }
  .fila {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1rem var(--margen);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .firma { justify-self: start; }
  .firma img { height: 30px; width: auto; }
  .hora { margin: 0; color: var(--texto-tenue); font-variant-numeric: tabular-nums; }

  .secciones { justify-self: end; display: flex; align-items: center; gap: clamp(1rem, 2.2vw, 2rem); }
  .secciones a { color: var(--texto-tenue); transition: color 0.25s ease; white-space: nowrap; }
  .secciones a:hover, .secciones a:focus-visible, .secciones a[aria-current='page'] { color: var(--texto); }
  .idioma { margin-left: 0.6rem; padding-left: 1.2rem; border-left: 1px solid var(--linea); }


  /* MÓVIL: firma e idioma arriba; las secciones debajo, repartidas a lo ancho */
  @media (max-width: 760px) {
    .fila { position: relative; grid-template-columns: 1fr; row-gap: 0.75rem; padding-top: 0.8rem; padding-bottom: 0.7rem; }
    .hora { display: none; }
    .firma img { height: 26px; }
    .secciones { justify-self: stretch; justify-content: space-between; gap: 0.5rem; }
    .idioma { position: absolute; top: 0.95rem; right: var(--margen); margin: 0; padding: 0; border: 0; color: var(--texto); }
  }
</style>

<script>
  // la hora de Madrid, en directo
  const reloj = document.querySelector<HTMLElement>('[data-hora]');
  if (reloj) {
    const formato = new Intl.DateTimeFormat('es-ES', { timeZone: 'Europe/Madrid', hour: '2-digit', minute: '2-digit', second: '2-digit' });
    const poner = () => (reloj.textContent = formato.format(new Date()));
    poner();
    setInterval(poner, 1000);
  }

</script>
