---
// CABECERA (igual en todas las páginas)
//  · Tu firma en el centro y, justo debajo, las secciones en letra fina, siempre a mano:
//    al pasar el cursor crecen un poco y se oscurecen; la sección en la que estás va subrayada.
//  · A la derecha, un solo botón de idioma: muestra el idioma actual (ES o EN) y al pulsarlo
//    cambia directamente al otro.
import { Image } from 'astro:assets';
import { textos, type Idioma } from '../i18n/textos';
import { rutaIdioma } from '../utils/enlaces';
import { imagen } from '../utils/imagenes';

interface Props { idioma: Idioma; pagina: string }
const { idioma, pagina } = Astro.props;
const t = textos[idioma];
const enlaces = [
  { pagina: 'pintura', texto: t.menuPintura },
  { pagina: 'diseno', texto: t.menuDiseno },
  { pagina: 'encargos', texto: t.menuEncargos },
  { pagina: 'contacto', texto: t.menuContacto },
];
const otroIdioma: Idioma = idioma === 'es' ? 'en' : 'es';
const cambiar = { es: 'Ver en inglés', en: 'Ver en español' }[idioma];
---

<header class="cabecera">
  <div class="contenedor fila">
    <span aria-hidden="true"></span>
    <div class="centro">
      <a href={rutaIdioma(idioma)} class="firma" aria-label={t.inicio}>
        <Image src={imagen('marca/firma.png')} alt="Tali" width={240} />
      </a>
      <nav class="secciones" aria-label={t.menu}>
        {enlaces.map((e) => (
          <a href={rutaIdioma(idioma, e.pagina)} aria-current={pagina === e.pagina ? 'page' : undefined}>{e.texto}</a>
        ))}
      </nav>
    </div>
    <div class="derecha">
      <a class="idioma mono" href={rutaIdioma(otroIdioma, pagina)} lang={otroIdioma} hreflang={otroIdioma} title={cambiar} aria-label={cambiar}>
        {idioma.toUpperCase()}
      </a>
    </div>
  </div>
</header>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--fondo) 94%, transparent);
    backdrop-filter: blur(6px);
  }
  .fila {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 1rem;
    padding-top: 1.2rem;
    padding-bottom: 0.9rem;
  }
  .centro { display: grid; justify-items: center; gap: 0.65rem; }
  .firma img { height: 38px; width: auto; }

  /* las secciones: letra fina; al pasar crecen un poco y se oscurecen */
  .secciones { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.3rem clamp(1.1rem, 2.4vw, 2rem); }
  .secciones a {
    display: inline-block;
    font-size: 0.82rem; font-weight: 300; letter-spacing: 0.02em;
    color: var(--texto-suave);
    text-decoration: none;
    text-underline-offset: 5px; text-decoration-thickness: 1px;
    transition: transform 0.3s ease, color 0.3s ease;
  }
  .secciones a:hover, .secciones a:focus-visible { transform: scale(1.12); color: var(--texto); }
  .secciones a[aria-current='page'] { color: var(--texto); text-decoration: underline; }

  /* un solo botón de idioma */
  .derecha { display: flex; justify-content: flex-end; padding-top: 0.5rem; }
  .idioma {
    display: grid; place-items: center; min-width: 2.3rem; height: 1.9rem; padding: 0 0.5rem;
    border: 1px solid var(--linea); border-radius: 999px;
    color: var(--texto); text-decoration: none;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }
  .idioma:hover, .idioma:focus-visible { border-color: var(--texto); background: var(--texto); color: var(--fondo); }

  @media (max-width: 640px) {
    .fila { grid-template-columns: 2.3rem 1fr 2.3rem; gap: 0.5rem; padding-top: 0.9rem; padding-bottom: 0.7rem; }
    .firma img { height: 32px; }
    .secciones { gap: 0.25rem 1rem; }
    .derecha { padding-top: 0.2rem; }
  }
</style>
