---
// CABECERA: botón "Menú" a la izquierda, tu firma en el centro y el idioma a la derecha.
// El menú se abre a pantalla completa: secciones grandes y numeradas, con una imagen
// de cada sección que aparece al pasar el ratón, y tus datos de contacto abajo.
import { Image } from 'astro:assets';
import { textos, type Idioma } from '../i18n/textos';
import { contacto, enlaceWhatsApp, rutaIdioma } from '../utils/enlaces';
import { imagen } from '../utils/imagenes';

interface Props { idioma: Idioma; pagina: string }
const { idioma, pagina } = Astro.props;
const t = textos[idioma];
const enlaces = [
  { pagina: 'pintura', texto: t.menuPintura, nota: t.notaPintura, foto: 'pintura/formas/encuentro/encuentro.jpg' },
  { pagina: 'diseno', texto: t.menuDiseno, nota: t.notaDiseno, foto: 'diseno/ojo-y-labios/ojo-pestanas-azules.jpg' },
  { pagina: 'encargos', texto: t.menuEncargos, nota: t.notaEncargos, foto: 'pintura/formas/desglose/desglose-mockup.jpg' },
  { pagina: 'contacto', texto: t.menuContacto, nota: t.notaContacto, foto: 'sobre-mi/retrato.jpg' },
];
const actual = enlaces.find((e) => e.pagina === pagina);
---

<header class="cabecera">
  <div class="contenedor fila">
    <button type="button" class="abrir-menu" data-abrir-menu aria-expanded="false" aria-controls="menu-principal">
      <span class="lineas" aria-hidden="true"><i></i><i></i></span>
      <span class="mono">{t.menu}</span>
      {actual && <span class="donde">{actual.texto}</span>}
    </button>
    <a href={rutaIdioma(idioma)} class="firma" aria-label={t.inicio}>
      <Image src={imagen('marca/firma.png')} alt="Tali" width={240} />
    </a>
    <div class="idiomas">
      <a href={rutaIdioma('es', pagina)} aria-current={idioma === 'es' ? 'true' : undefined} lang="es">ES</a>
      <span aria-hidden="true">/</span>
      <a href={rutaIdioma('en', pagina)} aria-current={idioma === 'en' ? 'true' : undefined} lang="en">EN</a>
    </div>
  </div>
</header>

<!-- Menú a pantalla completa -->
<dialog class="menu-principal" id="menu-principal" aria-label={t.menu}>
  <div class="contenedor arriba">
    <button type="button" class="cerrar-menu mono" data-cerrar-menu>{t.cerrar} ×</button>
    <a href={rutaIdioma(idioma)} class="firma" aria-label={t.inicio}>
      <Image src={imagen('marca/firma.png')} alt="Tali" width={240} />
    </a>
    <span></span>
  </div>

  <div class="contenedor cuerpo">
    <nav aria-label={t.menu}>
      <ol>
        {enlaces.map((e, i) => (
          <li style={`--i:${i}`}>
            <a href={rutaIdioma(idioma, e.pagina)} aria-current={pagina === e.pagina ? 'page' : undefined} data-vista={i}>
              <span class="mono numero">{String(i + 1).padStart(2, '0')}</span>
              <span class="nombre">{e.texto}</span>
              <span class="nota">{e.nota}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <!-- imagen de la sección sobre la que está el ratón -->
    <div class="vistas" aria-hidden="true">
      {enlaces.map((e, i) => (
        <Image src={imagen(e.foto)} alt="" widths={[500, 900]} sizes="30vw" class="vista" data-foto={i} loading="lazy" />
      ))}
    </div>
  </div>

  <div class="contenedor abajo mono">
    <a href={`mailto:${contacto.email}`}>{contacto.email}</a>
    <a href={`https://instagram.com/${contacto.instagram}`} target="_blank" rel="noopener">Instagram</a>
    <a href={enlaceWhatsApp(t.mensajeContacto)} target="_blank" rel="noopener">WhatsApp</a>
  </div>
</dialog>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--fondo) 94%, transparent);
    backdrop-filter: blur(6px);
  }
  .fila, .arriba {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
  }
  .firma img { height: 40px; width: auto; }
  a { color: var(--texto-suave); transition: color 0.2s; }
  a:hover, a[aria-current] { color: var(--texto); }

  /* Botón Menú: dos líneas que se mueven al pasar por encima + la sección en la que estás */
  .abrir-menu {
    justify-self: start; display: inline-flex; align-items: center; gap: 0.7rem;
    padding: 0.3rem 0; border: 0; background: none; cursor: pointer; color: var(--texto);
  }
  .lineas { display: grid; gap: 5px; width: 22px; }
  .lineas i { display: block; height: 1px; background: currentColor; transition: width 0.35s ease, transform 0.35s ease; }
  .lineas i:last-child { width: 60%; }
  .abrir-menu:hover .lineas i:last-child { width: 100%; }
  .abrir-menu:hover .lineas i:first-child { transform: translateX(3px); }
  .donde { font-size: 0.8rem; font-weight: 300; color: var(--texto-suave); }
  .donde::before { content: '—'; margin-right: 0.7rem; color: var(--texto-tenue); }

  .idiomas { font-family: var(--fuente-mono); font-size: 0.66rem; letter-spacing: 0.06em; }
  .idiomas { display: flex; justify-content: flex-end; gap: 0.35rem; color: var(--texto-tenue); }

  /* MENÚ A PANTALLA COMPLETA */
  .menu-principal {
    width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; padding: 0; border: 0;
    background: var(--fondo); color: var(--texto); overflow-y: auto;
  }
  .menu-principal[open] { display: grid; grid-template-rows: auto 1fr auto; animation: menuEntra 0.45s ease; }
  .menu-principal::backdrop { background: #fff; }
  .cerrar-menu { justify-self: start; padding: 0.4rem 0.8rem; border: 1px solid var(--linea); border-radius: 999px; background: none; cursor: pointer; color: var(--texto); }
  .cerrar-menu:hover { border-color: var(--texto); }

  .cuerpo { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; padding-top: 2rem; padding-bottom: 2rem; }
  ol { list-style: none; margin: 0; padding: 0; }
  li { border-top: 1px solid var(--linea); }
  li:last-child { border-bottom: 1px solid var(--linea); }
  .menu-principal[open] li { animation: lineaEntra 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) backwards; animation-delay: calc(120ms + var(--i) * 70ms); }
  li a { display: grid; grid-template-columns: 3rem 1fr auto; align-items: baseline; gap: 1rem; padding: clamp(0.8rem, 2vw, 1.3rem) 0; color: var(--texto); }
  .numero { color: var(--texto-tenue); }
  .nombre {
    font-family: var(--fuente-titulos); font-weight: 400; font-size: clamp(2.2rem, 6vw, 4.6rem); line-height: 1; letter-spacing: -0.02em;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1), color 0.3s;
  }
  .nota { font-size: 0.8rem; font-weight: 300; color: var(--texto-suave); text-align: right; max-width: 16rem; }
  /* al pasar por una sección, las demás se apagan y esa se desplaza un poco */
  ol:hover a .nombre { color: var(--texto-tenue); }
  ol:hover a:hover .nombre, li a:focus-visible .nombre { color: var(--texto); transform: translateX(0.6rem); }
  a[aria-current='page'] .numero::after { content: ' ●'; color: var(--texto); }

  .vistas { position: relative; aspect-ratio: 4 / 5; max-height: 62vh; justify-self: center; width: 100%; max-width: 420px; }
  .vista { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.04); transition: opacity 0.5s ease, transform 0.9s ease; }
  .vista.activa { opacity: 1; transform: none; }

  .abajo { display: flex; flex-wrap: wrap; gap: 0.6rem 2rem; padding-top: 1.2rem; padding-bottom: 1.6rem; font-size: 0.66rem; }

  @keyframes menuEntra { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lineaEntra { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

  @media (max-width: 760px) {
    .cuerpo { grid-template-columns: 1fr; align-items: start; }
    .vistas { display: none; }
    .nota { display: none; }
    li a { grid-template-columns: 2.4rem 1fr; }
  }
  @media (max-width: 640px) {
    .fila { padding-top: 0.8rem; padding-bottom: 0.8rem; }
    .firma img { height: 32px; }
    .donde { display: none; }
  }
</style>

<script>
  const menu = document.getElementById('menu-principal') as HTMLDialogElement;
  const boton = document.querySelector<HTMLButtonElement>('[data-abrir-menu]')!;
  const fotos = [...menu.querySelectorAll<HTMLElement>('[data-foto]')];
  const mostrar = (i: number) => fotos.forEach((f) => f.classList.toggle('activa', f.dataset.foto === String(i)));

  boton.addEventListener('click', () => {
    menu.showModal();
    boton.setAttribute('aria-expanded', 'true');
    document.documentElement.style.overflow = 'hidden';
    // al abrir se ve la imagen de la sección en la que estás (o la primera)
    const actual = menu.querySelector<HTMLElement>('a[aria-current="page"]');
    mostrar(Number(actual?.dataset.vista ?? 0));
  });
  menu.querySelector('[data-cerrar-menu]')!.addEventListener('click', () => menu.close());
  menu.addEventListener('close', () => {
    boton.setAttribute('aria-expanded', 'false');
    document.documentElement.style.overflow = '';
  });
  menu.querySelectorAll<HTMLElement>('[data-vista]').forEach((a) => {
    const i = Number(a.dataset.vista);
    a.addEventListener('mouseenter', () => mostrar(i));
    a.addEventListener('focus', () => mostrar(i));
  });
</script>
