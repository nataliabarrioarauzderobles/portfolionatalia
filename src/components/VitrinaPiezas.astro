---
// PIEZAS DECORATIVAS (ojos y labios), lo primero de la página de Diseño:
//  · Arriba y centrada, la invitación a crear tu propio diseño (se escribe sola al entrar).
//  · Debajo, las piezas ya hechas caen una tras otra de arriba abajo, en zigzag, como fichas de dominó.
//  · Al pulsarla se abre "Crea tu pieza" (Personaliza.astro) a pantalla completa.
//  · Debajo, cómo quedan en casa.
import { Image } from 'astro:assets';
import Personaliza from './Personaliza.astro';
import { modelosPieza, textoPiezas } from '../data/proyectos';
import { textos, type Idioma } from '../i18n/textos';
import { imagen } from '../utils/imagenes';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = textos[idioma];
const tx = {
  es: {
    etiqueta: 'Piezas decorativas',
    llamada: ['Pincha aquí', 'y crea tu', 'propio diseño'],
    sub: 'Elige un modelo, píntalo a tu gusto y mira cómo quedaría en madera.',
    boton: 'Crear mi pieza',
    volver: 'Volver a Diseño',
    casa: 'En casa — Caras de Mobiliario, Madrid, 2024',
  },
  en: {
    etiqueta: 'Decorative pieces',
    llamada: ['Click here', 'and create your', 'own design'],
    sub: 'Choose a model, paint it your way and see how it would look in wood.',
    boton: 'Create my piece',
    volver: 'Back to Design',
    casa: 'At home — Caras de Mobiliario, Madrid, 2024',
  },
}[idioma];
---

<section class="vitrina contenedor" id="piezas">
  <!-- la invitación, centrada arriba -->
  <div class="invitacion">
    <p class="mono etiqueta">{tx.etiqueta}</p>
    <button type="button" class="llamada" data-abrir-personaliza>
      <!-- el texto se escribe solo al entrar; mientras, cada línea guarda su sitio -->
      <span class="grande" aria-label={tx.llamada.join(" ")} data-escribir>
        {tx.llamada.map((l) => <span class="linea" data-texto={l}><span class="hueco" aria-hidden="true">{l}</span><span class="escrito" aria-hidden="true"></span></span>)}
      </span>
    </button>
    <p class="sub">{tx.sub}</p>
    <button type="button" class="boton boton-principal" data-abrir-personaliza>{tx.boton} →</button>
  </div>

  <!-- las piezas reales, cayendo en cascada de arriba abajo, en zigzag -->
  <ul class="domino">
    {modelosPieza.map((m, i) => (
      <li style={`--i:${i}`} data-ficha>
        <Image src={imagen(m.imagen)} alt={m.nombre[idioma]} widths={[400, 800]} sizes="(max-width: 860px) 80vw, 36vw" loading={i < 2 ? "eager" : "lazy"} />
      </li>
    ))}
  </ul>

  <div class="texto">
    {textoPiezas[idioma].map((p) => <p>{p}</p>)}
  </div>
</section>

<figure class="en-casa contenedor" data-aparece>
  <Image src={imagen('diseno/ojo-y-labios/piezas-estanteria.jpg')} alt={tx.casa} widths={[800, 1400, 2000]} sizes="(max-width: 860px) 100vw, 80vw" loading="lazy" />
  <figcaption class="mono">{tx.casa}</figcaption>
</figure>

<!-- en el móvil, un botón fijo abajo mientras se ven las piezas -->
<button type="button" class="boton-flotante" data-abrir-personaliza data-flotante>{tx.boton} →</button>

<!-- CREA TU PIEZA, a pantalla completa -->
<dialog class="dialogo-personaliza" id="dialogo-personaliza" aria-label={tx.boton}>
  <div class="barra-salir">
    <button type="button" class="volver mono" data-cerrar-personaliza>← {tx.volver}</button>
    <button type="button" class="cerrar" data-cerrar-personaliza aria-label={t.cerrar}>×</button>
  </div>
  <div class="contenedor">
    <Personaliza idioma={idioma} />
  </div>
</dialog>

<style>
  .vitrina { margin-top: clamp(1.5rem, 4vw, 3rem); }

  /* LA INVITACIÓN: centrada, en mayúsculas con Archivo, sobria y con mucho aire (como avea.studio) */
  .invitacion { display: grid; justify-items: center; text-align: center; padding: clamp(2rem, 10vh, 6rem) 0 clamp(2.5rem, 8vh, 5rem); }
  .etiqueta { color: var(--texto-suave); margin: 0 0 1.6rem; }
  .llamada { padding: 0; border: 0; background: none; cursor: pointer; color: var(--texto); }
  .grande {
    display: grid; justify-items: center;
    font-family: "Archivo", "Helvetica Neue", Arial, sans-serif; font-weight: 400; font-size: clamp(1.25rem, 2.3vw, 2rem);
    line-height: 1.2; letter-spacing: 0; text-transform: uppercase;
    transition: opacity 0.3s ease;
  }
  .llamada:hover .grande { opacity: 0.55; }
  /* cada línea ocupa su sitio desde el principio (texto invisible) y encima se va escribiendo */
  .linea { position: relative; display: block; }
  .hueco { visibility: hidden; }
  .escrito { position: absolute; left: 0; right: 0; top: 0; white-space: pre; text-align: left; }
  /* el cursor: una línea fina mientras escribe, que desaparece al terminar */
  .escrito.cursor::after { content: ""; display: inline-block; width: 1px; height: 0.85em; margin-left: 0.08em; vertical-align: -0.06em; background: currentColor; animation: parpadeo 0.9s steps(1) infinite; }
  @keyframes parpadeo { 50% { opacity: 0; } }
  /* sin JavaScript, el texto se ve directamente */
  :global(html:not(.js)) .hueco { visibility: visible; }
  .sub { margin: 1.4rem 0 1.8rem; max-width: 40ch; font-size: 0.86rem; line-height: 1.6; color: var(--texto-suave); }

  /* DOMINÓ: las piezas caen en cadena, de arriba abajo, alternando a un lado y a otro */
  .domino { list-style: none; margin: 0 auto; padding: 0; max-width: 1000px; perspective: 1200px; }
  .domino li { width: min(42%, 420px); transform-origin: 50% 0%; }
  .domino li + li { margin-top: clamp(-5rem, -6vw, -2rem); }
  .domino li:nth-child(4n + 1) { margin-left: 4%; }
  .domino li:nth-child(4n + 2) { margin-left: 52%; }
  .domino li:nth-child(4n + 3) { margin-left: 18%; }
  .domino li:nth-child(4n + 4) { margin-left: 44%; }
  .domino :global(img) { display: block; width: 100%; height: auto; mix-blend-mode: multiply; }
  :global(.js) .domino li:not(.cae) { opacity: 0; }
  .domino li.cae { animation: caer 0.9s cubic-bezier(0.3, 1.35, 0.5, 1) backwards; animation-delay: calc(var(--i) * 170ms); }
  @keyframes caer {
    0% { opacity: 0; transform: translateY(-50px) rotateX(-75deg); }
    60% { opacity: 1; }
    100% { opacity: 1; transform: none; }
  }

  .texto { max-width: 760px; margin: clamp(3rem, 7vw, 5rem) auto 0; columns: 2; column-gap: 2.5rem; }
  .texto p { margin: 0 0 0.8rem; font-size: 0.82rem; line-height: 1.75; color: var(--texto-suave); }

  .en-casa { margin-top: clamp(4rem, 9vw, 7rem); }
  .en-casa :global(img) { width: 100%; height: auto; }
  .en-casa figcaption { margin-top: 0.8rem; color: var(--texto-suave); }

  .boton-flotante { display: none; }

  @media (max-width: 860px) {
    .grande { font-size: clamp(1.15rem, 5.6vw, 1.6rem); }
    .domino li { width: 78%; }
    .domino li:nth-child(odd) { margin-left: 0; }
    .domino li:nth-child(even) { margin-left: 22%; }
    .domino li + li { margin-top: -1.5rem; }
    .texto { columns: 1; }
    .boton-flotante {
      position: fixed; left: 50%; bottom: 1rem; z-index: 9; transform: translateX(-50%);
      display: block; padding: 0.9rem 1.4rem; border: 0; border-radius: 999px;
      background: var(--texto); color: var(--fondo); font: inherit; font-size: 0.9rem; cursor: pointer;
      box-shadow: 0 10px 26px -10px rgba(0,0,0,0.5);
      transition: opacity 0.3s, transform 0.3s;
    }
    .boton-flotante.oculto { opacity: 0; pointer-events: none; transform: translate(-50%, 20px); }
  }

  /* Diálogo: a pantalla completa, limpio, sobre blanco */
  .dialogo-personaliza {
    width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; padding: 0 0 3rem; border: 0;
    background: var(--fondo); overflow-y: auto;
  }
  .dialogo-personaliza[open] { animation: entrarDialogo 0.45s ease; }
  .dialogo-personaliza::backdrop { background: #fff; }
  .barra-salir {
    position: sticky; top: 0; z-index: 5; display: flex; justify-content: space-between; align-items: center;
    padding: 0.9rem var(--margen);
    background: color-mix(in srgb, var(--fondo) 94%, transparent); backdrop-filter: blur(6px);
  }
  .volver { padding: 0.45rem 0.9rem; border: 1px solid var(--linea); border-radius: 999px; background: var(--fondo); cursor: pointer; color: var(--texto); transition: border-color 0.2s; }
  .volver:hover { border-color: var(--texto); }
  .barra-salir .cerrar { width: 2.2rem; height: 2.2rem; border: 0; background: none; font-size: 1.6rem; font-weight: 200; line-height: 1; cursor: pointer; color: var(--texto); }
  @keyframes entrarDialogo { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .domino li.cae { animation: none; } }
</style>

<script>
  // las piezas caen en cadena cuando la lista entra en pantalla
  const fichas = [...document.querySelectorAll<HTMLElement>('[data-ficha]')];
  const observador = new IntersectionObserver((entradas) => {
    if (entradas.some((e) => e.isIntersecting)) { fichas.forEach((f) => f.classList.add('cae')); observador.disconnect(); }
  }, { threshold: 0.05 });
  if (fichas[0]) observador.observe(fichas[0]);

  // el botón flotante del móvil se esconde al llegar a los proyectos
  const flotante = document.querySelector<HTMLElement>('[data-flotante]');
  const proyectos = document.getElementById('proyectos');
  if (flotante && proyectos) {
    new IntersectionObserver(([e]) => flotante.classList.toggle('oculto', e.isIntersecting || e.boundingClientRect.top < 0), {}).observe(proyectos);
  }

  const dialogo = document.getElementById('dialogo-personaliza') as HTMLDialogElement | null;
  if (dialogo) {
    const abrir = () => { dialogo.showModal(); document.documentElement.style.overflow = 'hidden'; };
    document.querySelectorAll('[data-abrir-personaliza]').forEach((b) => b.addEventListener('click', abrir));
    dialogo.querySelectorAll('[data-cerrar-personaliza]').forEach((b) => b.addEventListener('click', () => dialogo.close()));
    dialogo.addEventListener('close', () => { document.documentElement.style.overflow = ''; });
  }
</script>

<script>
  // MÁQUINA DE ESCRIBIR: "Pincha aquí y crea tu propio diseño" se escribe letra a letra al entrar en la sección
  const bloque = document.querySelector<HTMLElement>('[data-escribir]');
  if (bloque) {
    const lineas = [...bloque.querySelectorAll<HTMLElement>('.linea')];
    const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const escribir = async () => {
      for (let n = 0; n < lineas.length; n++) {
        const destino = lineas[n].querySelector<HTMLElement>('.escrito')!;
        const texto = lineas[n].dataset.texto ?? '';
        lineas.forEach((l) => l.querySelector('.escrito')!.classList.remove('cursor'));
        destino.classList.add('cursor');
        for (let i = 1; i <= texto.length; i++) {
          destino.textContent = texto.slice(0, i);
          // un ritmo irregular, como alguien escribiendo
          await new Promise((ok) => setTimeout(ok, 45 + Math.random() * 70));
        }
        await new Promise((ok) => setTimeout(ok, 220));
      }
      // al terminar, el cursor desaparece
      lineas.forEach((l) => l.querySelector(".escrito")!.classList.remove("cursor"));
    };
    if (sinMovimiento) lineas.forEach((l) => (l.querySelector('.escrito')!.textContent = l.dataset.texto ?? ''));
    else {
      const vigia = new IntersectionObserver((e) => { if (e[0].isIntersecting) { vigia.disconnect(); setTimeout(escribir, 350); } }, { threshold: 0.4 });
      vigia.observe(bloque);
    }
  }
</script>
