---
// ESCAPARATE (inspirado en el "showcase" de avea.studio)
// Tus obras y proyectos colocados en un anillo en 3D. Al bajar por la página el anillo gira:
// la obra de delante se ve grande y las de los lados, en perspectiva. Al pasar el cursor: "VER OBRA".
// Abajo: el título de la obra que está delante y un contador.
import { getImage } from 'astro:assets';
import { series } from '../data/obras';
import { proyectos } from '../data/proyectos';
import { revistas } from '../data/revistas';
import { textos, type Idioma } from '../i18n/textos';
import { rutaIdioma } from '../utils/enlaces';
import { imagen, imagenesDe } from '../utils/imagenes';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = textos[idioma];
const tx = {
  es: { ver: 'Ver obra', intro: 'Natalia Barrio es artista visual y diseñadora. Pinta la figura que aparece, se transforma y se deshace, y diseña piezas, espacios e identidades.', ultimo: 'Último', serie: 'Serie DE-formando, 2026', bajar: 'Baja para girar' },
  en: { ver: 'View work', intro: 'Natalia Barrio is a visual artist and designer. She paints the figure that appears, transforms and comes undone, and designs pieces, spaces and identities.', ultimo: 'Latest', serie: 'DE-formando series, 2026', bajar: 'Scroll to turn' },
}[idioma];

// obras: de cada serie, las disponibles primero; en DE-formando, el mockup
const obras = series.flatMap((s) =>
  s.obras.filter((o) => !o.vendida).slice(0, s.id === 'formas' ? 6 : 2).map((o) => {
    const imgs = imagenesDe(`pintura/${s.id}/${o.id}`);
    const foto = (s.id === 'formas' && imgs.find((i) => i.src.includes('-mockup'))) || imgs[0];
    return { titulo: o.titulo, tipo: t.series[s.id], foto, enlace: `${rutaIdioma(idioma, 'pintura')}#obra-${o.id}` };
  }),
);
const disenos = proyectos.filter((p) => revistas[p.id]).map((p) => {
  const portada = revistas[p.id].paginas[0];
  return { titulo: p.titulo[idioma], tipo: revistas[p.id].disciplina[idioma], foto: imagen('imagen' in portada ? portada.imagen : p.portada), enlace: `${rutaIdioma(idioma, 'diseno')}#revista-${p.id}` };
});
// se intercalan: unas cuantas pinturas, un diseño…
const todas: typeof obras = [];
const cada = Math.max(1, Math.floor(obras.length / disenos.length));
obras.forEach((o, i) => { todas.push(o); if ((i + 1) % cada === 0 && disenos.length) todas.push(disenos.shift()!); });
todas.push(...disenos);
const tarjetas = await Promise.all(todas.map(async (o) => ({ ...o, src: (await getImage({ src: o.foto, width: 520 })).src })));
---

<section class="escaparate" data-escaparate style={`--n:${tarjetas.length}`}>
  <div class="fijo">
    <p class="intro-texto">{tx.intro}</p>
    <div class="escena">
      <div class="anillo" data-anillo>
        {tarjetas.map((c, i) => (
          <a class="tarjeta" href={c.enlace} data-tarjeta data-titulo={c.titulo} data-tipo={c.tipo} style={`--i:${i}`}>
            <img src={c.src} alt={c.titulo} loading={i < 8 ? 'eager' : 'lazy'} draggable="false" />
            <span class="ver">{tx.ver}</span>
          </a>
        ))}
      </div>
    </div>
    <div class="pie-escaparate">
      <a class="ultimo" href={rutaIdioma(idioma, 'pintura')}><span>{tx.ultimo}</span>{tx.serie}</a>
      <p class="actual"><span data-titulo-actual>{tarjetas[0]?.titulo}</span><span class="tipo" data-tipo-actual>{tarjetas[0]?.tipo}</span></p>
      <p class="contador"><span data-numero>01</span> / {String(tarjetas.length).padStart(2, '0')}</p>
    </div>
    <p class="bajar">{tx.bajar} ↓</p>
  </div>
</section>

<style>
  /* la sección es alta: el anillo da una vuelta entera mientras se baja por ella */
  .escaparate { position: relative; height: 520vh; }
  .fijo { position: sticky; top: 0; height: 100vh; overflow: hidden; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.01em; }
  .intro-texto { position: absolute; top: 5.2rem; right: var(--margen); max-width: 30ch; margin: 0; color: var(--texto-tenue); text-transform: none; font-size: 0.78rem; line-height: 1.45; z-index: 2; }

  .escena { position: absolute; inset: 0; perspective: 1500px; perspective-origin: 50% 50%; }
  .anillo { position: absolute; left: 50%; top: 50%; width: 0; height: 0; transform-style: preserve-3d; }
  .tarjeta {
    --ancho: clamp(130px, 15vw, 250px);
    position: absolute; left: calc(var(--ancho) / -2); top: calc(var(--ancho) * -0.625);
    width: var(--ancho); aspect-ratio: 4 / 5;
    backface-visibility: hidden; will-change: transform, opacity;
  }
  .tarjeta img { width: 100%; height: 100%; object-fit: cover; display: block; background: var(--fondo-suave); transition: filter 0.4s; }
  .ver {
    position: absolute; left: 0; bottom: -1.6rem; color: var(--texto);
    opacity: 0; transform: translateY(-4px); transition: opacity 0.3s, transform 0.3s;
  }
  .tarjeta:hover .ver, .tarjeta:focus-visible .ver { opacity: 1; transform: none; }
  /* al pasar por una, las demás se apagan un poco */
  .anillo:hover .tarjeta:not(:hover) img { filter: grayscale(0.6) opacity(0.65); }

  .pie-escaparate { position: absolute; left: var(--margen); right: var(--margen); bottom: 1.2rem; display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 1rem; }
  .ultimo { justify-self: start; display: inline-flex; gap: 0.6rem; padding: 0.45rem 0.7rem; background: var(--texto); color: var(--fondo); }
  .ultimo span { opacity: 0.55; }
  .actual { margin: 0; display: grid; justify-items: center; gap: 0.15rem; }
  .actual .tipo { color: var(--texto-tenue); }
  .contador { margin: 0; justify-self: end; font-variant-numeric: tabular-nums; }
  .bajar { position: absolute; left: 50%; top: 5.2rem; transform: translateX(-50%); margin: 0; color: var(--texto-tenue); }

  @media (max-width: 760px) {
    .intro-texto { left: var(--margen); right: var(--margen); max-width: none; top: 4.6rem; }
    .bajar { display: none; }
    .pie-escaparate { grid-template-columns: 1fr auto; }
    .actual { justify-items: start; grid-column: 1 / -1; grid-row: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .escaparate { height: auto; } }
</style>

<script>
  const seccion = document.querySelector<HTMLElement>('[data-escaparate]');
  if (seccion) {
    const tarjetas = [...seccion.querySelectorAll<HTMLElement>('[data-tarjeta]')];
    const titulo = seccion.querySelector<HTMLElement>('[data-titulo-actual]')!;
    const tipo = seccion.querySelector<HTMLElement>('[data-tipo-actual]')!;
    const numero = seccion.querySelector<HTMLElement>('[data-numero]')!;
    const n = tarjetas.length;
    const paso = (Math.PI * 2) / n;
    let actual = -1;
    let angulo = 0, objetivo = 0;

    const colocar = () => {
      const ancho = tarjetas[0].offsetWidth;
      // radio: que las tarjetas quepan alrededor del anillo con un poco de aire
      const radio = Math.max(ancho * 1.6, (ancho * 1.12 * n) / (Math.PI * 2));
      let delante = 0, mejor = -2;
      tarjetas.forEach((c, i) => {
        const a = i * paso - angulo;
        const x = Math.sin(a) * radio, z = Math.cos(a) * radio - radio;
        const frente = Math.cos(a);
        c.style.transform = `translate3d(${x}px, 0, ${z}px) rotateY(${a}rad)`;
        // las de detrás se desvanecen
        c.style.opacity = String(Math.max(0, Math.min(1, (frente + 0.15) * 2)));
        c.style.zIndex = String(Math.round(frente * 100) + 100);
        c.style.pointerEvents = frente > 0.3 ? 'auto' : 'none';
        if (frente > mejor) { mejor = frente; delante = i; }
      });
      if (delante !== actual) {
        actual = delante;
        titulo.textContent = tarjetas[delante].dataset.titulo ?? '';
        tipo.textContent = tarjetas[delante].dataset.tipo ?? '';
        numero.textContent = String(delante + 1).padStart(2, '0');
      }
    };

    // el giro sigue al scroll con un poco de inercia
    const leerScroll = () => {
      const caja = seccion.getBoundingClientRect();
      const recorrido = seccion.offsetHeight - window.innerHeight;
      const progreso = Math.min(1, Math.max(0, -caja.top / Math.max(1, recorrido)));
      objetivo = progreso * Math.PI * 2;
    };
    const bucle = () => {
      angulo += (objetivo - angulo) * 0.09;
      colocar();
      requestAnimationFrame(bucle);
    };
    window.addEventListener('scroll', leerScroll, { passive: true });
    window.addEventListener('resize', colocar);
    leerScroll();
    angulo = objetivo;
    colocar();
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) requestAnimationFrame(bucle);
  }
</script>
