---
// GALERÍA DE UNA SERIE
// Muestra la foto principal de cada obra. Al pulsarla se abre un visor (<dialog>)
// con un carrusel (cuadro + mockups) y la ficha de la obra.
import { Image } from 'astro:assets';
import type { SerieObras } from '../data/obras';
import { textos, type Idioma } from '../i18n/textos';
import { enlaceWhatsApp } from '../utils/enlaces';
import { imagenesDe } from '../utils/imagenes';

interface Props { serie: SerieObras; idioma: Idioma }
const { serie, idioma } = Astro.props;
const t = textos[idioma];

// la foto principal sale primero y después los mockups
const obras = serie.obras.map((obra) => ({ ...obra, imagenes: imagenesDe(`pintura/${serie.id}/${obra.id}`) }));
---

<!--
  CARRUSEL HORIZONTAL
  En ordenador: la serie se queda fija en pantalla y, al hacer scroll hacia abajo,
  la tira de cuadros se desliza hacia la izquierda (lo hace el script de abajo).
  En móvil, o si el visitante prefiere menos movimiento: la tira se desliza con el dedo.
-->
<section class="serie" id={serie.id} data-carrusel>
  <div class="pegajoso">
    <div class="contenedor cabecera-serie">
      <h2 class="titulo-seccion">{t.series[serie.id]}</h2>
      <span class="mono contador-serie">{String(obras.length).padStart(2, '0')} {idioma === 'es' ? 'obras' : 'works'}</span>
    </div>
    <ul class="tira" data-tira>
      {obras.map((obra, i) => (
        <li>
          <p class="pie-obra mono">
            <span class="numero">{String(i + 1).padStart(2, '0')}</span>
            <span class="titulo-obra">
              {obra.titulo}
              {obra.vendida && <span class="vendida"> · {t.vendida}</span>}
            </span>
            {obra.medidas && <span class="medidas">{obra.medidas.replace(' x ', ' × ')}</span>}
          </p>
          <button class="miniatura" type="button" data-abrir={`obra-${obra.id}`} aria-label={`${t.verObra}: ${obra.titulo}`}>
            <Image src={obra.imagenes[0]} alt={obra.titulo} widths={[500, 900, 1300]} sizes="(max-width: 700px) 80vw, 45vw" loading="lazy" />
          </button>
        </li>
      ))}
    </ul>
  </div>
</section>

{obras.map((obra) => (
  <dialog class="visor" id={`obra-${obra.id}`} aria-label={obra.titulo}>
    <button class="cerrar" type="button" data-cerrar aria-label={t.cerrar}>×</button>
    <div class="visor-cuerpo">
      <div class="carrusel">
        <div class="pista" data-pista>
          {obra.imagenes.map((img, i) => (
            <figure class="diapositiva">
              <Image src={img} alt={i === 0 ? obra.titulo : `${obra.titulo} — mockup`} widths={[800, 1400]} sizes="(max-width: 900px) 100vw, 65vw" loading="lazy" />
            </figure>
          ))}
        </div>
        {obra.imagenes.length > 1 && (
          <div class="controles">
            <button type="button" data-anterior aria-label={t.anterior}>←</button>
            <span class="contador"><span data-actual>1</span> / {obra.imagenes.length}</span>
            <button type="button" data-siguiente aria-label={t.siguiente}>→</button>
          </div>
        )}
      </div>

      <div class="ficha">
        <h3>{obra.titulo}</h3>
        <dl>
          {obra.medidas && (<><dt>{t.medidas}</dt><dd>{obra.medidas} cm</dd></>)}
          {serie.tecnica && (<><dt>{t.tecnica}</dt><dd>{t.tecnicas[serie.tecnica]}</dd></>)}
          <dt>{t.precio}</dt>
          <dd>{obra.vendida ? t.vendida : t.consultarPrecio}</dd>
        </dl>
        {!obra.vendida && (
          <a class="boton boton-whatsapp" href={enlaceWhatsApp(t.mensajeObra(obra.titulo, obra.medidas))} target="_blank" rel="noopener">
            {t.botonConsultar}
          </a>
        )}
      </div>
    </div>
  </dialog>
))}

<style>
  .serie { margin-top: clamp(3rem, 8vw, 6rem); scroll-margin-top: 4rem; }

  /* Nombre de la serie: arriba del todo, pequeño y en gris; el protagonismo es de las obras */
  .cabecera-serie {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    padding-bottom: 1.2rem;
  }
  .cabecera-serie .titulo-seccion { font-size: 0.95rem; color: var(--texto-suave); margin: 0; }
  .contador-serie { color: var(--texto-tenue); }

  /* LA TIRA: todas las obras a la misma altura, una al lado de otra */
  .tira {
    --alto-obra: min(62vh, 640px);
    list-style: none;
    margin: 0;
    padding: 0.5rem var(--margen) 1.5rem;
    display: flex;
    gap: clamp(1rem, 2vw, 1.8rem);
    width: max-content;
  }
  /* cada obra mide lo que su imagen; la etiqueta se ajusta a ese ancho */
  .tira li { flex: none; width: min-content; }

  /* Sin el efecto de scroll (móvil, o si se prefiere menos movimiento): se desliza con el dedo */
  .serie:not(.activo) .tira { width: auto; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .serie:not(.activo) .tira::-webkit-scrollbar { display: none; }
  .serie:not(.activo) .tira li { scroll-snap-align: start; scroll-margin-left: var(--margen); }

  /* Con el efecto: la serie se queda fija mientras la tira se mueve */
  .serie.activo .pegajoso {
    position: sticky;
    top: var(--alto-cabecera, 72px);
    height: calc(100vh - var(--alto-cabecera, 72px));
    display: flex;
    flex-direction: column;
    justify-content: flex-start; /* el nombre de la serie arriba; las obras ocupan el resto */
    overflow: hidden;
  }
  /* en pantalla fija, las obras aprovechan casi toda la altura disponible */
  .serie.activo .tira { --alto-obra: min(calc(100vh - var(--alto-cabecera, 72px) - 9rem), 760px); }
  .serie.activo .tira { will-change: transform; }

  @media (max-width: 700px) { .tira { --alto-obra: 46vh; } }

  .miniatura {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .miniatura img { height: var(--alto-obra); width: auto; max-width: none; transition: opacity 0.4s; }
  .miniatura:hover img { opacity: 0.8; }
  /* en móvil ninguna obra ocupa más del 82 % del ancho: se intuye que hay más deslizando */
  @media (max-width: 700px) {
    .miniatura img { height: auto; max-height: var(--alto-obra); max-width: 82vw; }
  }

  /* Etiqueta encima de cada obra: número, título y medidas en monoespaciada */
  .pie-obra {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.9rem;
    margin: 0 0 0.6rem;
  }
  .titulo-obra { white-space: nowrap; }
  .numero { color: var(--texto-tenue); }
  .medidas { color: var(--texto-suave); }
  .vendida { color: var(--texto-tenue); }

  /* VISOR */
  .visor {
    width: min(1300px, 94vw);
    max-height: 92vh;
    padding: 0;
    border: 0;
    background: var(--fondo);
    color: var(--texto);
  }
  .visor::backdrop { background: rgba(255, 255, 255, 0.94); }
  .visor-cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(240px, 1fr);
    gap: 2rem;
    padding: clamp(1rem, 3vw, 2.5rem);
    align-items: center;
  }
  @media (max-width: 900px) { .visor-cuerpo { grid-template-columns: 1fr; } }

  .cerrar {
    position: absolute;
    top: 0.4rem;
    right: 0.8rem;
    z-index: 2;
    border: 0;
    background: none;
    font-size: 1.8rem;
    font-weight: 200;
    line-height: 1;
    color: var(--texto);
    cursor: pointer;
  }

  /* Carrusel: una pista horizontal que se desliza (también con el dedo en el móvil) */
  .pista {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .pista::-webkit-scrollbar { display: none; }
  .diapositiva {
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: center;
    display: flex;
    justify-content: center;
  }
  .diapositiva img { max-height: 74vh; width: auto; object-fit: contain; }
  .controles {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1rem;
    font-family: var(--fuente-mono);
    font-size: 0.66rem;
    color: var(--texto-suave);
  }
  .controles button {
    border: 0;
    background: none;
    padding: 0.3rem 0.5rem;
    font-family: var(--fuente-mono);
    font-size: 0.9rem;
    cursor: pointer;
    color: var(--texto-suave);
  }
  .controles button:hover { color: var(--texto); }

  .ficha h3 { font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 300; margin-bottom: 1.6rem; }
  dl {
    margin: 0 0 2rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--linea);
  }
  dt { font-family: var(--fuente-mono); font-size: 0.62rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--texto-suave); padding-top: 0.2rem; }
  dd { margin: 0; font-size: 0.88rem; }
</style>

<script>
  // CARRUSEL QUE SE MUEVE CON EL SCROLL
  // La sección se hace tan alta como larga es la tira; mientras bajas, la tira se desplaza a la izquierda.
  const series = [...document.querySelectorAll<HTMLElement>('[data-carrusel]')];
  const ancho = window.matchMedia('(min-width: 701px)');
  const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');

  function preparar() {
    const cabecera = document.querySelector<HTMLElement>('.cabecera');
    document.documentElement.style.setProperty('--alto-cabecera', `${cabecera?.offsetHeight ?? 72}px`);
    const activo = ancho.matches && !sinMovimiento.matches;
    series.forEach((serie) => {
      const tira = serie.querySelector<HTMLElement>('[data-tira]')!;
      serie.classList.toggle('activo', activo);
      tira.style.transform = '';
      serie.style.height = '';
      if (!activo) return;
      const recorrido = Math.max(0, tira.scrollWidth - window.innerWidth);
      serie.dataset.recorrido = String(recorrido);
      // alto = pantalla + lo que tiene que recorrer la tira
      serie.style.height = `${window.innerHeight + recorrido}px`;
    });
    mover();
  }

  function mover() {
    series.forEach((serie) => {
      if (!serie.classList.contains('activo')) return;
      const recorrido = Number(serie.dataset.recorrido ?? 0);
      const inicio = serie.getBoundingClientRect().top;
      const progreso = Math.min(1, Math.max(0, -inicio / Math.max(1, recorrido)));
      serie.querySelector<HTMLElement>('[data-tira]')!.style.transform = `translate3d(${-progreso * recorrido}px, 0, 0)`;
    });
  }

  let pendiente = false;
  window.addEventListener('scroll', () => {
    if (pendiente) return;
    pendiente = true;
    requestAnimationFrame(() => { mover(); pendiente = false; });
  }, { passive: true });
  window.addEventListener('resize', preparar);
  ancho.addEventListener('change', preparar);
  sinMovimiento.addEventListener('change', preparar);
  window.addEventListener('load', preparar);
  preparar();

  // Abre el visor al pulsar una obra
  document.querySelectorAll<HTMLButtonElement>('[data-abrir]').forEach((boton) => {
    boton.addEventListener('click', () => {
      const visor = document.getElementById(boton.dataset.abrir!) as HTMLDialogElement;
      visor.showModal();
    });
  });

  document.querySelectorAll<HTMLDialogElement>('dialog.visor').forEach((visor) => {
    // Cerrar con la ×, o pulsando fuera de la imagen
    visor.querySelector('[data-cerrar]')?.addEventListener('click', () => visor.close());
    visor.addEventListener('click', (e) => { if (e.target === visor) visor.close(); });

    const pista = visor.querySelector<HTMLElement>('[data-pista]');
    const actual = visor.querySelector('[data-actual]');
    if (!pista) return;
    const mover = (dir: number) => pista.scrollBy({ left: dir * pista.clientWidth, behavior: 'smooth' });
    visor.querySelector('[data-anterior]')?.addEventListener('click', () => mover(-1));
    visor.querySelector('[data-siguiente]')?.addEventListener('click', () => mover(1));
    visor.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') mover(-1);
      if (e.key === 'ArrowRight') mover(1);
    });
    // Actualiza el contador "1 / 2"
    pista.addEventListener('scroll', () => {
      if (actual) actual.textContent = String(Math.round(pista.scrollLeft / pista.clientWidth) + 1);
    });
    // Al cerrar, vuelve a la primera imagen
    visor.addEventListener('close', () => { pista.scrollLeft = 0; });
  });
</script>
