---
// CONFIGURADOR "DISEÑA TU PIEZA"
// Vista previa en vivo (SVG) + pasos: pieza → forma → colores → tamaño → idea.
// Al final, un botón abre WhatsApp con el encargo ya redactado.
import { Image } from 'astro:assets';
import { coloresPieza, modelosPieza } from '../data/proyectos';
import type { Idioma } from '../i18n/textos';
import { contacto, enlaceWhatsApp } from '../utils/enlaces';
import { imagen } from '../utils/imagenes';
import { ojo, labios } from '../utils/formas-pieza';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;

const tx = {
  es: {
    etiqueta: 'Encargo personalizado',
    titulo: 'Diseña tu pieza',
    intro: 'Ojos y labios pintados a mano para decorar tu espacio. Elige la forma, los colores y el tamaño: lo verás al momento y me llegará tu encargo por WhatsApp.',
    paso1: 'Pieza', paso2: 'Forma', paso3: 'Colores', paso4: 'Tamaño', paso5: 'Tu idea (opcional)',
    piezas: { ojo: 'Ojo', labios: 'Labios' },
    formas: { liso: 'Liso', pestanas: 'Pestañas', ondas: 'Ondas', lunares: 'Lunares', corona: 'Corona', sonrisa: 'Sonrisa', cerrados: 'Cerrados' },
    partes: { contorno: 'Contorno', iris: 'Iris', detalles: 'Detalles', labio: 'Labios' },
    ancho: 'de ancho aprox.',
    placeholder: 'Para qué espacio es, otros colores, una forma distinta…',
    boton: 'Enviar encargo por WhatsApp',
    modelos: 'O parte de un modelo',
    usar: 'Usar este modelo',
    saludo: 'Hola Natalia, me gustaría encargar una pieza personalizada:',
    lineaPieza: 'Pieza', lineaForma: 'Forma', lineaTamano: 'Tamaño', lineaIdea: 'Idea', lineaModelo: 'Basada en el modelo',
  },
  en: {
    etiqueta: 'Custom commission',
    titulo: 'Design your piece',
    intro: 'Hand-painted eyes and lips to decorate your space. Choose the shape, colours and size: you will see it instantly and your request will reach me on WhatsApp.',
    paso1: 'Piece', paso2: 'Shape', paso3: 'Colours', paso4: 'Size', paso5: 'Your idea (optional)',
    piezas: { ojo: 'Eye', labios: 'Lips' },
    formas: { liso: 'Plain', pestanas: 'Lashes', ondas: 'Waves', lunares: 'Dots', corona: 'Crown', sonrisa: 'Smile', cerrados: 'Closed' },
    partes: { contorno: 'Outline', iris: 'Iris', detalles: 'Details', labio: 'Lips' },
    ancho: 'wide approx.',
    placeholder: 'The space it is for, other colours, a different shape…',
    boton: 'Send request on WhatsApp',
    modelos: 'Or start from a model',
    usar: 'Use this model',
    saludo: 'Hi Natalia, I would like to commission a custom piece:',
    lineaPieza: 'Piece', lineaForma: 'Shape', lineaTamano: 'Size', lineaIdea: 'Idea', lineaModelo: 'Based on the model',
  },
}[idioma];

const formasOjo = ['liso', 'pestanas', 'ondas', 'lunares', 'corona'] as const;
const formasLabios = ['sonrisa', 'cerrados'] as const;
const hex = (id: string) => coloresPieza.find((c) => c.id === id)!.hex;

// Presets de los modelos reales (forma y colores aproximados)
const presets: Record<string, object> = {
  'ojo-lunares': { pieza: 'ojo', forma: 'lunares', contorno: 'amarillo', iris: 'azul', detalles: 'negro' },
  'ojo-turquesa': { pieza: 'ojo', forma: 'pestanas', contorno: 'turquesa', iris: 'azul', detalles: 'negro' },
  'ojo-pestanas': { pieza: 'ojo', forma: 'corona', contorno: 'azul', iris: 'amarillo', detalles: 'negro' },
  'ojo-morado': { pieza: 'ojo', forma: 'ondas', contorno: 'morado', iris: 'turquesa', detalles: 'negro' },
  labios: { pieza: 'labios', forma: 'sonrisa', labio: 'rojo', detalles: 'negro' },
};
const modelos = modelosPieza.filter((m) => presets[m.id]);
---

<section class="configurador" id="disena-tu-pieza" data-config
  data-numero={contacto.whatsapp}
  data-textos={JSON.stringify(tx)}
  data-colores={JSON.stringify(Object.fromEntries(coloresPieza.map((c) => [c.id, { hex: c.hex, nombre: c.nombre[idioma] }])))}>

  <header class="intro">
    <span class="mono etiqueta">{tx.etiqueta}</span>
    <h2 class="titulo-seccion">{tx.titulo}</h2>
    <p>{tx.intro}</p>
  </header>

  <div class="estudio">
    <!-- VISTA PREVIA -->
    <figure class="vista">
      <svg viewBox="-220 -140 440 280" role="img" aria-label={tx.titulo} data-vista
        style={`--contorno:${hex('turquesa')};--iris:${hex('azul')};--detalles:${hex('negro')};--labio:${hex('rojo')}`}>
        <g data-grupo="ojo">
          {formasOjo.map((f) => <path class="contorno" d={ojo.contornos[f]} data-forma={f} hidden={f !== 'pestanas'} />)}
          <g data-forma="corona" hidden>
            {ojo.corona.map((c) => <circle class="contorno" cx={c.x} cy={c.y} r={c.r} />)}
          </g>
          <path class="blanco" d={ojo.blanco} />
          <g data-forma="lunares" hidden>
            {ojo.lunares.map((c) => <circle class="punto" cx={c.x} cy={c.y} r={c.r} />)}
          </g>
          <circle class="iris" r="40" />
          <circle class="pupila" r="16" />
          <circle class="brillo" cx="10" cy="-12" r="6" />
        </g>
        <g data-grupo="labios" hidden>
          <path class="labio" d={labios.exterior} />
          <g data-forma="sonrisa">
            <path class="boca" d={labios.boca} />
            <path class="dientes" d={labios.dientes} />
          </g>
          <path class="linea" d={labios.linea} data-forma="cerrados" hidden />
        </g>
      </svg>
      <figcaption class="mono resumen" data-resumen></figcaption>
    </figure>

    <!-- PASOS -->
    <form class="pasos" data-form>
      <fieldset>
        <legend class="mono">01 — {tx.paso1}</legend>
        <div class="segmentos">
          {(['ojo', 'labios'] as const).map((p, i) => (
            <label><input type="radio" name="pieza" value={p} checked={i === 0} /><span>{tx.piezas[p]}</span></label>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend class="mono">02 — {tx.paso2}</legend>
        <div class="segmentos" data-formas="ojo">
          {formasOjo.map((f) => (
            <label><input type="radio" name="forma-ojo" value={f} checked={f === 'pestanas'} /><span>{tx.formas[f]}</span></label>
          ))}
        </div>
        <div class="segmentos" data-formas="labios" hidden>
          {formasLabios.map((f, i) => (
            <label><input type="radio" name="forma-labios" value={f} checked={i === 0} /><span>{tx.formas[f]}</span></label>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend class="mono">03 — {tx.paso3}</legend>
        <div class="partes" data-partes="ojo">
          {(['contorno', 'iris', 'detalles'] as const).map((p, i) => (
            <label><input type="radio" name="parte" value={p} checked={i === 0} /><span><i data-muestra={p}></i>{tx.partes[p]}</span></label>
          ))}
        </div>
        <div class="partes" data-partes="labios" hidden>
          {(['labio', 'detalles'] as const).map((p) => (
            <label><input type="radio" name="parte" value={p} /><span><i data-muestra={p}></i>{tx.partes[p]}</span></label>
          ))}
        </div>
        <div class="colores">
          {coloresPieza.map((c) => (
            <button type="button" class="color" data-color={c.id} style={`--c:${c.hex}`} title={c.nombre[idioma]}>
              <span class="solo-lector">{c.nombre[idioma]}</span>
            </button>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend class="mono">04 — {tx.paso4}</legend>
        <div class="tamano">
          <input type="range" name="tamano" min="20" max="120" step="5" value="50" aria-label={tx.paso4} />
          <output class="mono" data-tamano>50 cm {tx.ancho}</output>
        </div>
      </fieldset>

      <fieldset>
        <legend class="mono">05 — {tx.paso5}</legend>
        <textarea name="idea" rows="2" placeholder={tx.placeholder}></textarea>
      </fieldset>

      <a class="boton boton-principal enviar" href={enlaceWhatsApp(tx.saludo)} target="_blank" rel="noopener" data-enviar>{tx.boton} →</a>
    </form>
  </div>

  <!-- MODELOS REALES -->
  <div class="modelos">
    <h3 class="mono">{tx.modelos}</h3>
    <ul>
      {modelos.map((m) => (
        <li>
          <button type="button" data-preset={JSON.stringify({ ...presets[m.id], modelo: m.nombre[idioma] })} aria-label={`${tx.usar}: ${m.nombre[idioma]}`}>
            <Image src={imagen(m.imagen)} alt={m.nombre[idioma]} widths={[300, 500]} sizes="(max-width: 700px) 45vw, 18vw" loading="lazy" />
            <span class="mono">{m.nombre[idioma]}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .configurador { margin-top: clamp(2.5rem, 6vw, 4.5rem); scroll-margin-top: 5rem; }
  .intro { max-width: 560px; margin-bottom: 2rem; }
  .intro .etiqueta { display: block; margin-bottom: 0.8rem; }
  .intro p { margin: 0; color: var(--texto-suave); }

  .estudio {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }
  @media (max-width: 860px) { .estudio { grid-template-columns: 1fr; } }

  /* Vista previa: se queda fija mientras eliges en ordenador */
  .vista {
    position: sticky;
    top: 6rem;
    margin: 0;
    background: var(--fondo-suave);
    aspect-ratio: 4 / 3;
    display: grid;
    grid-template-rows: 1fr auto;
    padding: clamp(1rem, 3vw, 2rem);
  }
  @media (max-width: 860px) { .vista { position: relative; top: 0; } }
  .vista svg { width: 100%; height: 100%; overflow: visible; }
  .vista svg [hidden] { display: none; }
  .resumen { color: var(--texto-suave); text-align: center; padding-top: 0.8rem; }

  /* Colores de la vista previa: cambian con las variables --contorno, --iris, --detalles, --labio */
  .contorno { fill: var(--contorno); stroke: var(--detalles); stroke-width: 3; stroke-linejoin: round; transition: fill 0.3s; }
  .blanco { fill: #fff; stroke: var(--detalles); stroke-width: 3; }
  .punto { fill: var(--detalles); }
  .iris { fill: var(--iris); stroke: var(--detalles); stroke-width: 3; transition: fill 0.3s; }
  .pupila { fill: #161412; }
  .brillo { fill: #fff; opacity: 0.85; }
  .labio { fill: var(--labio); stroke: var(--detalles); stroke-width: 3; stroke-linejoin: round; transition: fill 0.3s; }
  .boca { fill: #1d1715; stroke: var(--detalles); stroke-width: 2.5; }
  .dientes { fill: #fff; }
  .linea { fill: none; stroke: var(--detalles); stroke-width: 4; stroke-linecap: round; }

  /* Pasos */
  .pasos { display: grid; gap: 1.6rem; }
  fieldset { border: 0; margin: 0; padding: 0 0 1.4rem; border-bottom: 1px solid var(--linea); }
  legend { color: var(--texto-suave); margin-bottom: 0.8rem; padding: 0; }

  .segmentos, .partes { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .segmentos input, .partes input { position: absolute; opacity: 0; pointer-events: none; }
  .segmentos span, .partes span {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.95rem; border: 1px solid var(--linea); border-radius: 999px;
    font-size: 0.82rem; cursor: pointer; transition: border-color 0.2s, background 0.2s, color 0.2s;
  }
  .segmentos span:hover, .partes span:hover { border-color: var(--texto); }
  .segmentos input:checked + span, .partes input:checked + span { background: var(--texto); border-color: var(--texto); color: var(--fondo); }
  .segmentos input:focus-visible + span, .partes input:focus-visible + span { outline: 1px solid var(--texto); outline-offset: 2px; }
  .partes i { width: 0.75rem; height: 0.75rem; border-radius: 50%; border: 1px solid rgba(0, 0, 0, 0.15); background: var(--muestra, #ccc); }

  .colores { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 1rem; }
  .color {
    width: 2rem; height: 2rem; border-radius: 50%; padding: 0; cursor: pointer;
    background: var(--c); border: 1px solid rgba(0, 0, 0, 0.12); transition: transform 0.15s;
  }
  .color:hover { transform: scale(1.1); }
  .color[aria-pressed='true'] { outline: 1px solid var(--texto); outline-offset: 3px; }

  .tamano { display: flex; align-items: center; gap: 1.2rem; }
  .tamano input { flex: 1; accent-color: var(--texto); }
  .tamano output { min-width: 11rem; color: var(--texto); }

  textarea {
    width: 100%; padding: 0.7rem 0; font: inherit; resize: vertical;
    background: transparent; color: var(--texto); border: 0; border-bottom: 1px solid var(--linea);
  }
  textarea:focus { outline: none; border-color: var(--texto); }
  .enviar { justify-self: start; }

  /* Modelos */
  .modelos { margin-top: clamp(3rem, 7vw, 5rem); }
  .modelos h3 { color: var(--texto-suave); margin-bottom: 1rem; }
  .modelos ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; }
  @media (max-width: 860px) { .modelos ul { grid-template-columns: repeat(2, 1fr); } }
  .modelos button { display: grid; gap: 0.6rem; width: 100%; padding: 0; border: 0; background: none; cursor: pointer; text-align: left; color: var(--texto); }
  .modelos img { width: 100%; aspect-ratio: 1; object-fit: contain; background: var(--fondo-suave); transition: opacity 0.3s; }
  .modelos button:hover img { opacity: 0.8; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-config]').forEach((raiz) => {
    const tx = JSON.parse(raiz.dataset.textos!);
    const colores: Record<string, { hex: string; nombre: string }> = JSON.parse(raiz.dataset.colores!);
    const form = raiz.querySelector<HTMLFormElement>('[data-form]')!;
    const svg = raiz.querySelector<SVGSVGElement>('[data-vista]')!;
    const enviar = raiz.querySelector<HTMLAnchorElement>('[data-enviar]')!;
    const resumen = raiz.querySelector<HTMLElement>('[data-resumen]')!;
    const salidaTamano = raiz.querySelector<HTMLOutputElement>('[data-tamano]')!;

    // Estado de la pieza
    const estado = {
      pieza: 'ojo', formaOjo: 'pestanas', formaLabios: 'sonrisa',
      color: { contorno: 'turquesa', iris: 'azul', detalles: 'negro', labio: 'rojo' } as Record<string, string>,
      parte: 'contorno', tamano: 50, idea: '', modelo: '',
    };

    const marcar = (nombre: string, valor: string) => {
      const input = form.querySelector<HTMLInputElement>(`input[name="${nombre}"][value="${valor}"]`);
      if (input) input.checked = true;
    };

    function pintar() {
      const esOjo = estado.pieza === 'ojo';
      const forma = esOjo ? estado.formaOjo : estado.formaLabios;
      // qué grupos y formas se ven
      svg.querySelectorAll<SVGElement>('[data-grupo]').forEach((g) => g.toggleAttribute('hidden', g.dataset.grupo !== estado.pieza));
      svg.querySelectorAll<SVGElement>(`[data-grupo="${estado.pieza}"] [data-forma]`).forEach((el) => el.toggleAttribute('hidden', el.dataset.forma !== forma));
      raiz.querySelectorAll<HTMLElement>('[data-formas]').forEach((el) => (el.hidden = el.dataset.formas !== estado.pieza));
      raiz.querySelectorAll<HTMLElement>('[data-partes]').forEach((el) => (el.hidden = el.dataset.partes !== estado.pieza));
      // la corona usa el contorno liso de base
      if (esOjo && forma === 'corona') svg.querySelector<SVGElement>('[data-forma="liso"]')?.removeAttribute('hidden');
      // colores
      for (const [parte, id] of Object.entries(estado.color)) {
        svg.style.setProperty(`--${parte}`, colores[id].hex);
        raiz.querySelectorAll<HTMLElement>(`[data-muestra="${parte}"]`).forEach((m) => m.style.setProperty('--muestra', colores[id].hex));
      }
      raiz.querySelectorAll<HTMLButtonElement>('[data-color]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.color === estado.color[estado.parte])));
      // tamaño
      salidaTamano.textContent = `${estado.tamano} cm ${tx.ancho}`;
      // resumen y mensaje
      const partes = esOjo ? ['contorno', 'iris', 'detalles'] : ['labio', 'detalles'];
      const lineasColor = partes.map((p) => `${tx.partes[p]}: ${colores[estado.color[p]].nombre}`);
      resumen.textContent = `${tx.piezas[estado.pieza]} · ${tx.formas[forma]} · ${estado.tamano} cm`;
      const lineas = [
        tx.saludo,
        `• ${tx.lineaPieza}: ${tx.piezas[estado.pieza]}`,
        `• ${tx.lineaForma}: ${tx.formas[forma]}`,
        ...lineasColor.map((l) => `• ${l}`),
        `• ${tx.lineaTamano}: ${estado.tamano} cm`,
      ];
      if (estado.modelo) lineas.push(`• ${tx.lineaModelo}: ${estado.modelo}`);
      if (estado.idea.trim()) lineas.push(`• ${tx.lineaIdea}: ${estado.idea.trim()}`);
      enviar.href = `https://wa.me/${raiz.dataset.numero}?text=${encodeURIComponent(lineas.join('\n'))}`;
    }

    form.addEventListener('change', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.name === 'pieza') {
        estado.pieza = el.value;
        estado.parte = el.value === 'ojo' ? 'contorno' : 'labio';
        marcar('parte', estado.parte);
      }
      if (el.name === 'forma-ojo') estado.formaOjo = el.value;
      if (el.name === 'forma-labios') estado.formaLabios = el.value;
      if (el.name === 'parte') estado.parte = el.value;
      estado.modelo = el.name === 'parte' ? estado.modelo : '';
      pintar();
    });
    form.addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.name === 'tamano') estado.tamano = Number(el.value);
      if (el.name === 'idea') estado.idea = el.value;
      pintar();
    });
    raiz.querySelectorAll<HTMLButtonElement>('[data-color]').forEach((b) =>
      b.addEventListener('click', () => { estado.color[estado.parte] = b.dataset.color!; estado.modelo = ''; pintar(); }),
    );

    // Pulsar un modelo real carga su forma y sus colores
    raiz.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) =>
      b.addEventListener('click', () => {
        const p = JSON.parse(b.dataset.preset!);
        estado.pieza = p.pieza;
        marcar('pieza', p.pieza);
        if (p.pieza === 'ojo') { estado.formaOjo = p.forma; marcar('forma-ojo', p.forma); estado.parte = 'contorno'; }
        else { estado.formaLabios = p.forma; marcar('forma-labios', p.forma); estado.parte = 'labio'; }
        marcar('parte', estado.parte);
        for (const parte of ['contorno', 'iris', 'detalles', 'labio']) if (p[parte]) estado.color[parte] = p[parte];
        estado.modelo = p.modelo;
        pintar();
        raiz.querySelector('.estudio')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }),
    );

    pintar();
  });
</script>
