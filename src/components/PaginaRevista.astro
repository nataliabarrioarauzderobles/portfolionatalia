---
// UNA PÁGINA DE REVISTA, con el estilo de la revista de Lusilla que maquetó Natalia:
// formato A (vertical), mucho blanco, fotos a sangre y el nombre del proyecto en mayúsculas muy espaciadas.
// Las medidas de dentro van en "cqw" (% del ancho de la página): se ve igual en grande, en pequeño y en el móvil.
import { Image } from 'astro:assets';
import type { Proyecto } from '../data/proyectos';
import type { Pagina, Revista } from '../data/revistas';
import type { Idioma } from '../i18n/textos';
import { contacto } from '../utils/enlaces';
import { imagen } from '../utils/imagenes';

interface Props { pagina: Pagina; proyecto: Proyecto; revista: Revista; idioma: Idioma; numero: number; total: number; miniatura?: boolean }
const { pagina, proyecto, revista, idioma, numero, miniatura = false } = Astro.props;
const titulo = proyecto.titulo[idioma];
const parrafos = proyecto.texto[idioma].split('\n\n');
const anchos = miniatura ? [400, 700] : [700, 1200, 1800];
const sizes = miniatura ? '(max-width: 760px) 45vw, 30vw' : '(max-width: 900px) 92vw, 45vw';
const año = revista.año ?? proyecto.año;
---

<article
  class:list={['pagina', `tipo-${pagina.tipo}`]}
  data-pagina={numero}
  data-doble={pagina.tipo === 'doble' ? '' : undefined}
>
  {pagina.tipo === 'hoja' && (
    <Image class="a-sangre" src={imagen(pagina.imagen)} alt={`${titulo} — ${numero}`} widths={anchos} sizes={sizes} loading={miniatura || numero === 1 ? 'eager' : 'lazy'} />
  )}

  {pagina.tipo === 'portada' && (
    <>
      <Image class:list={["a-sangre", { "portada-encajada": pagina.encajar }]} src={imagen(pagina.imagen)} alt={titulo} widths={anchos} sizes={sizes} loading="eager" />
      <h2 class:list={['nombre', { oscuro: pagina.oscuro }]}>{titulo}</h2>
    </>
  )}

  {pagina.tipo === 'texto' && (
    <div class:list={["texto", { centrado: pagina.centrado }]} lang={idioma}>
      {parrafos.map((p) => <p>{p}</p>)}
    </div>
  )}

  {pagina.tipo === 'imagen' && (
    <Image class="a-sangre" src={imagen(pagina.imagen)} alt={titulo} widths={anchos} sizes={sizes} loading="lazy" />
  )}

  {pagina.tipo === 'doble' && (
    <Image class:list={['a-sangre', { encajar: pagina.encajar }]} src={imagen(pagina.imagen)} alt={titulo} widths={[1200, 2000, 2800]} sizes="(max-width: 900px) 100vw, 90vw" loading="lazy" />
  )}

  {pagina.tipo === 'pequena' && (
    <Image class="pequena" src={imagen(pagina.imagen)} alt={titulo} widths={[400, 800]} sizes="(max-width: 900px) 30vw, 14vw" loading="lazy" />
  )}

  {(pagina.tipo === 'negra' || pagina.tipo === 'par') && (
    <div class="pila">
      {pagina.imagenes.map((ruta) => <Image src={imagen(ruta)} alt={titulo} widths={[500, 900]} sizes="(max-width: 900px) 80vw, 36vw" loading="lazy" />)}
    </div>
  )}

  {pagina.tipo === 'contra' && (
    <div class="contra">
      <p class="cabeza"><span>{titulo}</span>{año && <span>{año}</span>}</p>
      <Image src={imagen(pagina.imagen)} alt={titulo} widths={[400, 800]} sizes="(max-width: 900px) 50vw, 24vw" loading="lazy" />
      <p class="firma">{contacto.nombre}</p>
    </div>
  )}
</article>

<style>
  .pagina { position: relative; container-type: inline-size; overflow: hidden; background: #fff; color: #1a1a1a; }
  .pagina :global(img) { display: block; }
  .a-sangre { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .a-sangre.encajar { object-fit: contain; padding: 8cqw 4cqw; background: #fff; }

  /* PORTADA: el nombre en mayúsculas muy espaciadas, arriba a la izquierda */
  .nombre {
    position: absolute; top: 4.5cqw; left: 5cqw; right: 3cqw; z-index: 2; margin: 0;
    font-family: var(--fuente); font-weight: 300; font-size: 7.4cqw; line-height: 1.1;
    letter-spacing: 0.55em; text-transform: uppercase; color: #fff;
    text-shadow: 0 0 2cqw rgba(0, 0, 0, 0.12);
  }
  .nombre.oscuro { color: #1a1a1a; text-shadow: none; }
  /* portada con un dibujo: entero y más pequeño, debajo del nombre */
  .a-sangre.portada-encajada { object-fit: contain; padding: 22cqw 16cqw 12cqw; background: #fff; }

  /* TEXTO: solo el texto, en una columna estrecha, como en la revista de Lusilla */
  .texto { position: absolute; left: 24%; top: 24%; width: 52%; font-size: 2.15cqw; line-height: 1.38; color: #222; }
  .texto p { margin: 0 0 1.4em; }
  .texto.centrado { left: 50%; top: 50%; width: 58%; transform: translate(-50%, -50%); text-align: center; }
  .texto.centrado p:last-child { margin-bottom: 0; }

  /* IMAGEN PEQUEÑA, centrada sobre blanco */
  .pequena { position: absolute; left: 50%; top: 46%; transform: translate(-50%, -50%); width: 28%; height: auto; }

  /* PÁGINA NEGRA (dibujos) y PAR (dos imágenes sobre blanco), una encima de otra */
  .tipo-negra { background: #141414; }
  .pila { position: absolute; inset: 0; display: grid; align-content: center; justify-items: center; gap: 4cqw; padding: 5cqw; }
  .pila :global(img) { width: 86%; height: auto; max-height: 62cqw; object-fit: contain; }
  .tipo-par .pila { gap: 10cqw; }
  .tipo-par .pila :global(img) { width: 62%; max-height: 56cqw; }

  /* CONTRAPORTADA */
  .contra { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 54%; }
  .cabeza { display: flex; justify-content: space-between; margin: 0 0 2cqw; font-size: 1.6cqw; text-transform: uppercase; letter-spacing: 0.02em; }
  .contra :global(img) { width: 100%; aspect-ratio: 4 / 3; height: auto; object-fit: cover; }
  .firma { margin: 4cqw 0 0; text-align: center; font-size: 1.25cqw; letter-spacing: 0.45em; text-transform: uppercase; }
</style>
