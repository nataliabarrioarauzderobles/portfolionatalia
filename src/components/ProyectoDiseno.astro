---
// UN PROYECTO DE DISEÑO, presentado como un collage (inspirado en blancagtarrio.com):
// imágenes de distintos tamaños, a alturas desiguales y algo solapadas, con mucho aire.
// Cada imagen se puede ampliar (usa el visor compartido de VisorImagen.astro).
import { Image, getImage } from 'astro:assets';
import type { Proyecto } from '../data/proyectos';
import { textos, type Idioma } from '../i18n/textos';
import { imagen } from '../utils/imagenes';

interface Props { proyecto: Proyecto; idioma: Idioma; numero: number }
const { proyecto, idioma, numero } = Astro.props;
const t = textos[idioma];

// Para cada imagen preparamos la miniatura y una versión grande para el visor
const bloques = await Promise.all(
  proyecto.bloques.map(async (b) => ({
    ...b,
    imagenes: await Promise.all(
      b.imagenes.map(async (ruta) => {
        const src = imagen(ruta);
        const grande = await getImage({ src, width: Math.min(src.width, 1800) });
        return { src, grande: grande.src, vertical: src.height > src.width * 1.1 };
      }),
    ),
  })),
);
---

<article class="proyecto contenedor" id={proyecto.id}>
  <header class="encabezado">
    <div class="nombre">
      <span class="mono numero">{String(numero).padStart(2, '0')}</span>
      <h2 class="titulo-seccion">{proyecto.titulo[idioma]}</h2>
    </div>
    <p class="texto">{proyecto.texto[idioma]}</p>
  </header>

  {bloques.map((b) => (
    <section class:list={['bloque', b.disposicion === 'trio' ? 'secuencia' : 'collage']}>
      {b.subtitulo && <h3 class="mono">{b.subtitulo[idioma]}</h3>}
      <ul>
        {b.imagenes.map((img) => (
          <li class:list={{ vertical: img.vertical, ancha: b.disposicion === 'ancho' }}>
            <button type="button" class="ampliar" data-ampliar={img.grande} aria-label={t.verImagen}>
              <Image
                src={img.src}
                alt={`${proyecto.titulo[idioma]}${b.subtitulo ? ' — ' + b.subtitulo[idioma] : ''}`}
                widths={[400, 800, 1400]}
                sizes={b.disposicion === 'ancho' ? '(max-width: 700px) 100vw, 66vw' : '(max-width: 700px) 70vw, 34vw'}
                loading="lazy"
              />
            </button>
          </li>
        ))}
      </ul>
    </section>
  ))}
</article>

<style>
  .proyecto { margin-top: clamp(6rem, 14vw, 11rem); scroll-margin-top: 5rem; }

  /* Encabezado: número y título a la izquierda, texto breve a la derecha */
  .encabezado {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 1.5rem clamp(2rem, 6vw, 6rem);
    align-items: start;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--linea);
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  @media (max-width: 760px) { .encabezado { grid-template-columns: 1fr; } }
  .nombre { display: flex; align-items: baseline; gap: 1rem; }
  .numero { color: var(--texto-tenue); }
  .nombre .titulo-seccion { margin: 0; }
  .texto { margin: 0; max-width: 460px; font-size: 0.86rem; color: var(--texto-suave); }

  .bloque { margin-top: clamp(3rem, 7vw, 5.5rem); }
  .bloque:first-of-type { margin-top: 0; }
  .bloque h3 { color: var(--texto-suave); margin: 0 0 1.5rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { position: relative; transition: z-index 0s 0.3s; }
  li:hover { z-index: 5; transition: z-index 0s; }

  /* COLLAGE: rejilla de 12 columnas; cada imagen cae en una posición distinta (patrón de 7) */
  .collage ul { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: clamp(0.8rem, 2vw, 1.6rem); row-gap: 0; align-items: start; }
  .collage li:nth-child(7n + 1) { grid-column: 1 / span 4; margin-top: 0; }
  .collage li:nth-child(7n + 2) { grid-column: 6 / span 3; margin-top: 7rem; }
  .collage li:nth-child(7n + 3) { grid-column: 10 / span 3; margin-top: 1.5rem; }
  .collage li:nth-child(7n + 4) { grid-column: 2 / span 3; margin-top: -2.5rem; }
  .collage li:nth-child(7n + 5) { grid-column: 5 / span 4; margin-top: 4.5rem; }
  .collage li:nth-child(7n + 6) { grid-column: 9 / span 3; margin-top: -1.5rem; }
  .collage li:nth-child(7n + 7) { grid-column: 3 / span 5; margin-top: 3rem; }
  /* las verticales, un poco más estrechas dentro de su hueco */
  .collage li.vertical { width: 82%; }
  .collage li:nth-child(7n + 3).vertical, .collage li:nth-child(7n + 6).vertical { justify-self: end; }
  /* imagen apaisada protagonista (mural, estantería, troquel de las latas) */
  .collage li.ancha { grid-column: 2 / span 10 !important; margin-top: 0 !important; width: auto; }

  /* SECUENCIA (Wannabes: diseño → mockup → modelo), en fila */
  .secuencia ul { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 3vw, 2.5rem); align-items: center; }

  /* Móvil: dos columnas alternadas */
  @media (max-width: 700px) {
    .collage ul { grid-template-columns: repeat(6, 1fr); row-gap: 1rem; }
    .collage li:nth-child(n) { grid-column: 1 / span 4; margin-top: 0; width: auto; justify-self: stretch; }
    .collage li:nth-child(2n) { grid-column: 3 / span 4; margin-top: -2rem; }
    .collage li.ancha { grid-column: 1 / -1 !important; }
    .secuencia ul { grid-template-columns: repeat(3, 1fr); gap: 0.6rem; }
  }

  .ampliar { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .ampliar img { width: 100%; height: auto; transition: transform 0.4s ease; }
  .ampliar:hover img { transform: scale(1.015); }
</style>
