---
// PINTURA (inspirada en la vista "LIST" de avea.studio)
//  · Los cuadros, uno debajo de otro en una columna en el centro.
//  · A la izquierda, fija, la lista de todos los títulos (el actual en negro; pulsando uno se va a él).
//  · A los lados del cuadro que está en el centro de la pantalla: su serie y sus medidas y técnica.
//  · Al pulsar un cuadro se abre como un proyecto de avea: el texto a la izquierda y, a la derecha,
//    el cuadro y sus mockups, que avanzan de lado al hacer scroll. Al final, "siguiente obra".
//  · Filtros arriba: por serie y "solo disponibles".
import { Image } from 'astro:assets';
import { series } from '../data/obras';
import { textos, type Idioma } from '../i18n/textos';
import { enlaceWhatsApp, rutaIdioma } from '../utils/enlaces';
import { imagenesDe } from '../utils/imagenes';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = textos[idioma];
const tx = {
  es: { obra: 'Obra', siguiente: 'Baja para ver la siguiente obra', anterior: 'Obra anterior', cerrar: 'Cerrar', desliza: 'Desliza' },
  en: { obra: 'Work', siguiente: 'Scroll down for the next work', anterior: 'Previous work', cerrar: 'Close', desliza: 'Swipe' },
}[idioma];

// En DE-formando la imagen de la lista es el mockup; en el visor, primero el cuadro y después los mockups
const conMockupPrimero = new Set(['formas']);
const obras = series.flatMap((serie) =>
  serie.obras.map((obra) => {
    const imagenes = imagenesDe(`pintura/${serie.id}/${obra.id}`);
    const mockup = imagenes.find((img) => img.src.includes('-mockup'));
    const portada = conMockupPrimero.has(serie.id) && mockup ? mockup : imagenes[0];
    return { ...obra, serie, imagenes, portada };
  }),
);
const total = String(obras.length).padStart(2, '0');
const tecnica = (s: (typeof obras)[number]['serie']) => (s.tecnica ? t.tecnicas[s.tecnica] : '');
---

<section class="pintura" data-pintura>
  <!-- capa fija: filtros, lista de títulos y datos de la obra del centro -->
  <div class="capa-fija" aria-hidden="false">
    <div class="filtros">
      <div class="series" role="group" aria-label={t.pinturaTitulo}>
        <button type="button" data-serie="todas" aria-pressed="true">{t.todas}</button>
        {series.map((s) => <button type="button" data-serie={s.id} aria-pressed="false">{t.series[s.id]}</button>)}
      </div>
      <label class="solo-disponibles"><input type="checkbox" data-disponibles /> {t.soloDisponibles}</label>
    </div>

    <ol class="titulos" data-titulos>
      {obras.map((o) => (
        <li data-serie={o.serie.id} data-vendida={o.vendida ? '' : undefined}>
          <button type="button" data-ir={o.id}>{o.titulo}</button>
        </li>
      ))}
    </ol>

    <p class="dato izquierda" data-dato-serie>{t.series[obras[0].serie.id]}</p>
    <p class="dato derecha" data-dato-ficha>{obras[0].medidas ? `${obras[0].medidas.replace(' x ', ' × ')} cm · ` : ''}{tecnica(obras[0].serie)}</p>
    <p class="dato extremo" data-dato-numero>01 / {total}</p>
  </div>

  <!-- la columna de cuadros -->
  <ul class="columna" data-columna>
    {obras.map((o, i) => (
      <li id={`cuadro-${o.id}`} data-cuadro={o.id} data-serie={o.serie.id} data-vendida={o.vendida ? '' : undefined}
        data-nombre-serie={t.series[o.serie.id]}
        data-ficha={`${o.medidas ? `${o.medidas.replace(' x ', ' × ')} cm · ` : ''}${tecnica(o.serie)}`}
        data-numero={String(i + 1).padStart(2, '0')}>
        <button type="button" class="abrir" data-abrir={`obra-${o.id}`} aria-label={`${t.verObra}: ${o.titulo}`}>
          <Image src={o.portada} alt={o.titulo} widths={[400, 700, 1000]} sizes="(max-width: 760px) 80vw, 24vw" loading={i < 4 ? 'eager' : 'lazy'} />
          <span class="ver">{t.verObra}</span>
        </button>
        <!-- en el móvil los datos van debajo de cada cuadro -->
        <p class="pie-movil"><span>{o.titulo}</span><span>{o.vendida ? t.vendida : o.medidas ? `${o.medidas.replace(' x ', ' × ')} cm` : ''}</span></p>
      </li>
    ))}
  </ul>
</section>

<!-- EL VISOR DE CADA OBRA, como un proyecto de avea -->
{obras.map((o, i) => (
  <dialog class="visor" id={`obra-${o.id}`} aria-label={o.titulo} data-visor data-indice={i}>
    <div class="arriba">
      <span>{tx.obra} {String(i + 1).padStart(2, '0')} / {total}</span>
      <button type="button" data-anterior-obra>↑ {tx.anterior}</button>
      <button type="button" data-cerrar>{tx.cerrar}</button>
    </div>

    <div class="texto-obra">
      <h3>{o.titulo}</h3>
      <p class="serie-obra">{t.series[o.serie.id]}{o.serie.año ? `, ${o.serie.año}` : ''}</p>
      {o.texto && <p class="descripcion">{o.texto[idioma]}</p>}
      <dl>
        {o.medidas && (<><dt>{t.medidas}</dt><dd>{o.medidas.replace(' x ', ' × ')} cm</dd></>)}
        {o.serie.tecnica && (<><dt>{t.tecnica}</dt><dd>{t.tecnicas[o.serie.tecnica]}</dd></>)}
        {o.vendida && (<><dt>{t.estado}</dt><dd>{t.vendida}</dd></>)}
      </dl>
      {o.vendida ? (
        <a class="enlace" href={rutaIdioma(idioma, 'encargos')}>{t.encargarParecida} →</a>
      ) : (
        <a class="enlace" href={enlaceWhatsApp(t.mensajeObra(o.titulo, o.medidas))} target="_blank" rel="noopener">{t.botonConsultar} →</a>
      )}
    </div>

    <!-- las imágenes avanzan de lado con el scroll -->
    <div class="pista" data-pista>
      {o.imagenes.map((img, j) => (
        <figure>
          <Image src={img} alt={j === 0 ? o.titulo : `${o.titulo} — mockup`} widths={[700, 1200, 1800]} sizes="(max-width: 760px) 85vw, 50vw" loading="lazy" />
        </figure>
      ))}
      <p class="siguiente" data-siguiente-obra>{tx.siguiente} ↓</p>
    </div>

    <p class="progreso" data-progreso>0%</p>
  </dialog>
))}

<style>
  .pintura { position: relative; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.01em; }

  /* CAPA FIJA: se queda en su sitio mientras los cuadros pasan por debajo */
  .capa-fija { position: sticky; top: 0; height: 100vh; margin-bottom: -100vh; pointer-events: none; z-index: 2; }
  .capa-fija > * { pointer-events: auto; }
  .filtros { position: absolute; top: 4.6rem; left: var(--margen); right: var(--margen); display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .series { display: flex; flex-wrap: wrap; gap: 0.3rem 1.2rem; }
  .series button, .titulos button { padding: 0; border: 0; background: none; font: inherit; text-transform: inherit; color: var(--texto-tenue); cursor: pointer; text-align: left; transition: color 0.25s; }
  .series button:hover, .series button[aria-pressed='true'] { color: var(--texto); }
  .solo-disponibles { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--texto-tenue); cursor: pointer; }
  .solo-disponibles input { accent-color: var(--texto); }

  .titulos { position: absolute; left: var(--margen); top: 50%; transform: translateY(-50%); list-style: none; margin: 0; padding: 0; display: grid; gap: 0.12rem; max-height: 62vh; overflow: hidden; }
  .titulos li[hidden] { display: none; }
  .titulos button:hover, .titulos button.actual { color: var(--texto); }

  .dato { position: absolute; top: 50%; transform: translateY(-50%); margin: 0; }
  .izquierda { right: calc(50% + clamp(140px, 12vw, 200px) + 2rem); text-align: right; }
  .derecha { left: calc(50% + clamp(140px, 12vw, 200px) + 2rem); }
  .extremo { right: var(--margen); font-variant-numeric: tabular-nums; }

  /* LA COLUMNA DE CUADROS */
  .columna { list-style: none; margin: 0 auto; padding: 50vh 0; width: clamp(280px, 24vw, 400px); display: grid; gap: 0; }
  .columna li[hidden] { display: none; }
  .abrir { position: relative; display: block; width: 100%; padding: 0; border: 0; background: none; cursor: pointer; }
  .abrir :global(img) { display: block; width: 100%; height: auto; transition: filter 0.4s; }
  .ver { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); padding: 0.4rem 0.7rem; background: var(--fondo); color: var(--texto); opacity: 0; transition: opacity 0.3s; }
  .abrir:hover .ver, .abrir:focus-visible .ver { opacity: 1; }
  .pie-movil { display: none; }

  /* EL VISOR */
  .visor { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; padding: 0; border: 0; background: var(--fondo); color: var(--texto); overflow: hidden; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.01em; }
  .visor[open] { display: block; animation: abrirVisor 0.5s ease; }
  .visor::backdrop { background: #fff; }
  @keyframes abrirVisor { from { opacity: 0; } to { opacity: 1; } }
  .arriba { position: absolute; top: 0; left: 0; right: 0; z-index: 3; display: grid; grid-template-columns: 1fr auto 1fr; padding: 1.1rem var(--margen); }
  .arriba button { padding: 0; border: 0; background: none; font: inherit; text-transform: inherit; color: var(--texto-tenue); cursor: pointer; }
  .arriba button:hover { color: var(--texto); }
  .arriba [data-cerrar] { justify-self: end; color: var(--texto); }

  /* el texto queda debajo: al avanzar, las imágenes pasan por encima (como en avea) */
  .texto-obra { position: absolute; left: var(--margen); top: 50%; transform: translateY(-50%); width: min(30vw, 360px); z-index: 1; }
  .texto-obra h3 { font-size: 0.95rem; margin: 0 0 0.3rem; text-transform: uppercase; }
  .serie-obra { margin: 0 0 1.4rem; color: var(--texto-tenue); }
  .descripcion { margin: 0 0 1.4rem; text-transform: none; font-size: 0.82rem; line-height: 1.55; color: var(--texto-suave); }
  .texto-obra dl { display: grid; grid-template-columns: auto 1fr; gap: 0.3rem 1rem; margin: 0 0 1.6rem; }
  .texto-obra dt { color: var(--texto-tenue); }
  .texto-obra dd { margin: 0; }
  .enlace { display: inline-block; padding-bottom: 0.2rem; border-bottom: 1px solid var(--texto); }
  .enlace:hover { opacity: 0.6; }

  .pista { position: absolute; z-index: 2; top: 50%; left: 0; display: flex; align-items: center; gap: 1rem; padding-left: max(calc(var(--margen) + 32vw), 380px); height: 64vh; transform: translateY(-50%); will-change: transform; }
  .pista figure { margin: 0; height: 100%; flex: none; }
  .pista :global(img) { height: 100%; width: auto; display: block; }
  .siguiente { flex: none; margin: 0 var(--margen) 0 4rem; white-space: nowrap; }
  .progreso { position: absolute; right: var(--margen); bottom: 1.1rem; margin: 0; font-variant-numeric: tabular-nums; }

  /* MÓVIL: lista sencilla con los datos debajo de cada cuadro; el visor, apilado */
  @media (max-width: 760px) {
    .capa-fija { position: static; height: auto; margin: 0; }
    .filtros { position: static; padding: 1rem var(--margen); }
    .titulos, .dato { display: none; }
    .columna { padding: 1rem var(--margen) 3rem; width: 100%; gap: 2.4rem; }
    .pie-movil { display: flex; justify-content: space-between; gap: 1rem; margin: 0.6rem 0 0; }
    .pie-movil span:last-child { color: var(--texto-tenue); }
    .visor { overflow-y: auto; }
    .texto-obra { position: static; transform: none; width: auto; padding: 4rem var(--margen) 1.5rem; }
    .pista { position: static; transform: none !important; height: 52vh; padding: 0 var(--margen); overflow-x: auto; scroll-snap-type: x mandatory; }
    .pista figure { scroll-snap-align: center; }
    .siguiente { margin-left: 2rem; }
    .progreso { position: fixed; }
  }
</style>

<script>
  const seccion = document.querySelector<HTMLElement>('[data-pintura]')!;
  const cuadros = [...seccion.querySelectorAll<HTMLElement>('[data-cuadro]')];
  const titulos = [...seccion.querySelectorAll<HTMLButtonElement>('[data-ir]')];
  const datoSerie = seccion.querySelector<HTMLElement>('[data-dato-serie]')!;
  const datoFicha = seccion.querySelector<HTMLElement>('[data-dato-ficha]')!;
  const datoNumero = seccion.querySelector<HTMLElement>('[data-dato-numero]')!;
  const total = String(cuadros.length).padStart(2, '0');

  // ── el cuadro que está en el centro de la pantalla manda en los datos y en la lista ──
  let actual = '';
  const marcar = () => {
    const medio = window.innerHeight / 2;
    const visible = cuadros.filter((c) => !c.hidden);
    const centro = visible.find((c) => { const r = c.getBoundingClientRect(); return r.top <= medio && r.bottom >= medio; }) ?? visible[0];
    if (!centro || centro.dataset.cuadro === actual) return;
    actual = centro.dataset.cuadro!;
    datoSerie.textContent = centro.dataset.nombreSerie ?? '';
    datoFicha.textContent = centro.dataset.ficha ?? '';
    datoNumero.textContent = `${centro.dataset.numero} / ${total}`;
    titulos.forEach((b) => b.classList.toggle('actual', b.dataset.ir === actual));
    // la lista se desplaza para que el título actual se vea
    titulos.find((b) => b.dataset.ir === actual)?.scrollIntoView({ block: 'nearest' });
  };
  let pendiente = false;
  window.addEventListener('scroll', () => { if (pendiente) return; pendiente = true; requestAnimationFrame(() => { pendiente = false; marcar(); }); }, { passive: true });
  marcar();
  titulos.forEach((b) => b.addEventListener('click', () => {
    document.getElementById(`cuadro-${b.dataset.ir}`)?.scrollIntoView({ block: 'center', behavior: 'smooth' });
  }));

  // ── filtros ──
  const botonesSerie = [...seccion.querySelectorAll<HTMLButtonElement>('[data-serie]')].filter((b) => b.tagName === 'BUTTON');
  const disponibles = seccion.querySelector<HTMLInputElement>('[data-disponibles]')!;
  let serie = 'todas';
  const filtrar = () => {
    const vale = (el: HTMLElement) => (serie === 'todas' || el.dataset.serie === serie) && !(disponibles.checked && el.hasAttribute('data-vendida'));
    cuadros.forEach((c) => (c.hidden = !vale(c)));
    seccion.querySelectorAll<HTMLElement>('[data-titulos] li').forEach((li) => (li.hidden = !vale(li)));
    actual = '';
    marcar();
  };
  botonesSerie.forEach((b) => b.addEventListener('click', () => {
    serie = b.dataset.serie!;
    botonesSerie.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    filtrar();
  }));
  disponibles.addEventListener('change', filtrar);

  // ── EL VISOR: las imágenes avanzan de lado con la rueda o el trackpad ──
  const visores = [...document.querySelectorAll<HTMLDialogElement>('[data-visor]')];
  const escritorio = matchMedia('(min-width: 761px)');
  const abrirVisor = (v: HTMLDialogElement | undefined) => {
    if (!v) return;
    visores.forEach((x) => x !== v && x.open && x.close());
    if (!v.open) v.showModal();
    v.dispatchEvent(new Event('abierto'));
    document.documentElement.style.overflow = 'hidden';
  };
  document.querySelectorAll<HTMLButtonElement>('[data-abrir]').forEach((b) => b.addEventListener('click', () => abrirVisor(document.getElementById(b.dataset.abrir!) as HTMLDialogElement)));

  visores.forEach((v, i) => {
    const pista = v.querySelector<HTMLElement>('[data-pista]')!;
    const progreso = v.querySelector<HTMLElement>('[data-progreso]')!;
    let x = 0, objetivo = 0, empuje = 0, animando = false;
    const maximo = () => Math.max(0, pista.scrollWidth - window.innerWidth);
    const pintar = () => {
      x += (objetivo - x) * 0.12;
      if (Math.abs(objetivo - x) < 0.5) x = objetivo;
      pista.style.transform = `translate3d(${-x}px, -50%, 0)`;
      progreso.textContent = `${Math.round((x / Math.max(1, maximo())) * 100)}%`;
      if (x !== objetivo) requestAnimationFrame(pintar); else animando = false;
    };
    const mover = () => { if (!animando) { animando = true; requestAnimationFrame(pintar); } };
    v.addEventListener('wheel', (e) => {
      if (!escritorio.matches) return;
      e.preventDefault();
      const d = Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
      objetivo = Math.max(0, Math.min(maximo(), objetivo + d));
      // al llegar al final, seguir bajando lleva a la siguiente obra (y al principio, subir a la anterior)
      if (objetivo >= maximo() && d > 0) { empuje += d; if (empuje > 500) { empuje = 0; abrirVisor(visores[(i + 1) % visores.length]); } }
      else if (objetivo <= 0 && d < 0) { empuje += d; if (empuje < -500) { empuje = 0; abrirVisor(visores[(i - 1 + visores.length) % visores.length]); } }
      else empuje = 0;
      mover();
    }, { passive: false });
    v.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { objetivo = Math.min(maximo(), objetivo + window.innerWidth * 0.5); mover(); }
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { objetivo = Math.max(0, objetivo - window.innerWidth * 0.5); mover(); }
    });
    v.addEventListener('abierto', () => { x = objetivo = empuje = 0; pista.style.transform = ''; progreso.textContent = '0%'; if (escritorio.matches) pista.style.transform = 'translate3d(0, -50%, 0)'; });
    v.querySelector('[data-siguiente-obra]')!.addEventListener('click', () => abrirVisor(visores[(i + 1) % visores.length]));
    v.querySelector('[data-anterior-obra]')!.addEventListener('click', () => abrirVisor(visores[(i - 1 + visores.length) % visores.length]));
    v.querySelector('[data-cerrar]')!.addEventListener('click', () => v.close());
    v.addEventListener('close', () => { if (!visores.some((x) => x.open)) document.documentElement.style.overflow = ''; });
  });

  // si se llega con un enlace a una obra (p. ej. desde el anillo de la home), se abre directamente
  if (location.hash.startsWith('#obra-')) setTimeout(() => abrirVisor(document.getElementById(location.hash.slice(1)) as HTMLDialogElement), 300);
</script>
