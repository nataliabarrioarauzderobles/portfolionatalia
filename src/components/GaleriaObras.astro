---
// PINTURA: una galería pensada para vender, que entre por los ojos.
//  · Debajo, una cuadrícula ordenada: en todas las casillas, el cuadro de cerca, del mismo tamaño (4:5, recortado
//    si hace falta). Al pasar el cursor se ve el cuadro colgado en una casa, si tiene esa foto.
//  · Al pulsar una obra se abre en grande y entera, con su información a la derecha en letra pequeña.
//    Debajo, las otras fotos de esa misma obra para cambiar entre ellas; con las flechas de los lados
//    (o deslizando en el móvil, o con las teclas ← →) se pasa a la obra anterior o siguiente, en el orden de la galería.
//    Pulsando fuera, con Esc o con "Cerrar" se vuelve a la galería.
//  · Filtros arriba: por serie y "solo disponibles".
import { Image } from 'astro:assets';
import { series } from '../data/obras';
import { textos, type Idioma } from '../i18n/textos';
import { enlaceWhatsApp, rutaIdioma } from '../utils/enlaces';
import { imagenesDe } from '../utils/imagenes';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = textos[idioma];
const tx = {
  es: { siguiente: 'Siguiente obra', anterior: 'Obra anterior', cerrar: 'Cerrar', disponible: 'Disponible', foto: 'Ver foto' },
  en: { siguiente: 'Next work', anterior: 'Previous work', cerrar: 'Close', disponible: 'Available', foto: 'View photo' },
}[idioma];

// vendidas que se enseñan pronto en la galería (después de las primeras disponibles), no al final;
// las de DE-formando van juntas
const vendidasDestacadas = new Set(['principio-de-la-forma', 'arquitectura-del-abrazo', 'distorsion-de-la-forma', 'mascara', 'masa', 'open-i', 'open-ii']);
// obras cuya foto tiene margen blanco: en la cuadrícula se acercan un poco más, para que todas se vean igual de cerca
const acercar: Record<string, number> = { nudo: 1.14 };
const obras = series.flatMap((serie) =>
  serie.obras.map((obra) => {
    const imagenes = imagenesDe(`pintura/${serie.id}/${obra.id}`);
    // en la cuadrícula, siempre el cuadro (la primera imagen); al pasar el cursor, el cuadro en una casa
    const mockup = imagenes.find((img) => img.src.includes('-mockup'));
    return { ...obra, serie, imagenes, portada: imagenes[0], segunda: mockup };
  }),
);
// en la galería: primero toda la serie DE-formando (en el orden de obras.ts), luego toda la serie Open;
// del resto, seis disponibles, las vendidas destacadas, el resto de disponibles y al final las demás vendidas
const delaSerie = (id: string) => obras.filter((o) => o.serie.id === id);
const resto = obras.filter((o) => o.serie.id !== 'formas' && o.serie.id !== 'open');
const disponibles = resto.filter((o) => !o.vendida);
const galeria = [
  ...delaSerie('formas'),
  ...delaSerie('open'),
  ...disponibles.slice(0, 6),
  ...resto.filter((o) => vendidasDestacadas.has(o.id)),
  ...disponibles.slice(6),
  ...resto.filter((o) => o.vendida && !vendidasDestacadas.has(o.id)),
];
const ficha = (o: (typeof obras)[number]) => [o.medidas && `${o.medidas.replace(' x ', ' × ')} cm`, (o.tecnica ?? o.serie.tecnica) && t.tecnicas[(o.tecnica ?? o.serie.tecnica)!]].filter(Boolean).join(' · ');
---

<section class="pintura" data-pintura>
  <!-- FILTROS -->
  <div class="filtros">
    <div class="series" role="group" aria-label={t.pinturaTitulo}>
      <button type="button" data-serie="todas" aria-pressed="true">{t.todas}</button>
      {series.map((s) => <button type="button" data-serie={s.id} aria-pressed="false">{t.series[s.id]}</button>)}
    </div>
    <!-- "solo disponibles": una palabra más, como las series; se enciende al pulsarla (sin cuadradito) -->
    <label class="solo-disponibles"><input type="checkbox" class="solo-lector" data-disponibles /><span>{t.soloDisponibles}</span></label>
  </div>

  <!-- LA GALERÍA -->
  <ul class="galeria">
    {galeria.map((o, i) => (
      <li class="cuadro" data-cuadro data-obra={`obra-${o.id}`} data-serie={o.serie.id} data-vendida={o.vendida ? '' : undefined}>
        <button type="button" class="abrir" data-abrir={`obra-${o.id}`} aria-label={`${t.verObra}: ${o.titulo}`}>
          <Image class="una" style={acercar[o.id] ? `--zoom:${acercar[o.id]}` : undefined} src={o.portada} alt={o.titulo} widths={[400, 700, 1000]} sizes="(max-width: 760px) 50vw, 31vw" loading={i < 6 ? 'eager' : 'lazy'} />
          {o.segunda && <Image class="otra" src={o.segunda} alt="" widths={[400, 700, 1000]} sizes="(max-width: 760px) 50vw, 31vw" loading="lazy" />}
        </button>
        <div class="pie">
          <p class="titulo">{o.titulo}</p>
          <p class="datos">{ficha(o)}</p>
          {o.vendida
            ? <p class="estado vendida">{t.vendida}</p>
            : <p class="estado">{tx.disponible}</p>}
        </div>
      </li>
    ))}
  </ul>
</section>

<!-- velo: tapa la galería mientras se ve una obra; pulsarlo cierra -->
<div class="velo" data-velo hidden></div>

<!-- LA FICHA DE CADA OBRA, debajo de la barra de secciones (en el mismo orden que la galería) -->
{galeria.map((o) => (
  <dialog class="visor" id={`obra-${o.id}`} aria-label={o.titulo} data-visor>
    <button type="button" class="cerrar" data-cerrar>{tx.cerrar} ×</button>

    <!-- la obra entera; las flechas pasan a la obra anterior o siguiente -->
    <div class="escena" data-escena>
      <button type="button" class="flecha izquierda" data-anterior-obra aria-label={tx.anterior}>←</button>
      <div class="lienzo">
        {o.imagenes.map((img, j) => (
          <Image class:list={{ activa: j === 0 }} data-foto={j} src={img} alt={j === 0 ? o.titulo : `${o.titulo} — ${j + 1}`}
            widths={[700, 1200, 1800]} sizes="(max-width: 760px) 92vw, 62vw" loading="lazy" />
        ))}
      </div>
      <button type="button" class="flecha derecha" data-siguiente-obra aria-label={tx.siguiente}>→</button>
    </div>

    <!-- las otras fotos de esta misma obra -->
    {o.imagenes.length > 1 && (
      <div class="miniaturas">
        {o.imagenes.map((img, j) => (
          <button type="button" data-ver-foto={j} aria-label={`${tx.foto} ${j + 1}`} aria-pressed={j === 0 ? 'true' : 'false'}>
            <Image src={img} alt="" widths={[160]} sizes="64px" loading="lazy" />
          </button>
        ))}
      </div>
    )}

    <!-- la información, a la derecha, en letra pequeña -->
    <div class="info">
      <p class="contador" data-contador></p>
      <h3>{o.titulo}</h3>
      <p class="serie-obra">{t.series[o.serie.id]}{o.serie.año ? `, ${o.serie.año}` : ''}</p>
      {o.vendida
        ? <p class="estado vendida precio">{t.vendida}</p>
        : <p class="estado precio">{tx.disponible}</p>}
      <dl>
        {o.medidas && (<><dt>{t.medidas}</dt><dd>{o.medidas.replace(' x ', ' × ')} cm</dd></>)}
        {(o.tecnica ?? o.serie.tecnica) && (<><dt>{t.tecnica}</dt><dd>{t.tecnicas[(o.tecnica ?? o.serie.tecnica)!]}</dd></>)}
      </dl>
      {o.texto && <p class="descripcion">{o.texto[idioma]}</p>}
      {o.vendida ? (
        <a class="enlace" href={rutaIdioma(idioma, 'encargos')}>{t.encargarParecida} →</a>
      ) : (
        <a class="enlace" href={enlaceWhatsApp(t.mensajeObra(o.titulo, o.medidas))} target="_blank" rel="noopener">{t.botonConsultar} →</a>
      )}
    </div>
  </dialog>
))}

<style>
  .pintura { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.01em; }


  .estado { display: inline-flex; align-items: center; gap: 0.45rem; margin: 0; }
  .vendida { color: var(--texto-tenue); }

  /* FILTROS */
  .filtros { display: flex; justify-content: space-between; gap: 0.6rem 1rem; flex-wrap: wrap; margin: 0 max(var(--margen), 5vw) clamp(2.4rem, 6vh, 3.6rem); padding-top: clamp(2rem, 7vh, 4rem); }
  .series { display: flex; flex-wrap: wrap; gap: 0.3rem 1.2rem; }
  .series button { padding: 0; border: 0; background: none; font: inherit; text-transform: inherit; color: var(--texto-tenue); cursor: pointer; transition: color 0.25s; }
  .series button:hover, .series button[aria-pressed='true'] { color: var(--texto); }
  .solo-disponibles { position: relative; display: inline-flex; align-items: center; color: var(--texto-tenue); cursor: pointer; }
  .solo-disponibles span { transition: color 0.25s; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .solo-disponibles:hover span { color: var(--texto); }
  .solo-disponibles input:checked + span { color: var(--texto); text-decoration-line: underline; }
  .solo-disponibles input:focus-visible + span { outline: 1px solid var(--texto); outline-offset: 3px; }

  /* LA GALERÍA: el cuadro de cerca, todas las casillas iguales */
  /* cuatro por fila, con aire entre obras */
  .galeria { list-style: none; margin: 0; padding: 0 max(var(--margen), 5vw); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(3rem, 6vw, 5.5rem) clamp(1.6rem, 3.6vw, 3.6rem); }
  .cuadro[hidden] { display: none; }
  .abrir { position: relative; display: block; width: 100%; aspect-ratio: 4 / 5; padding: 0; border: 0; background: var(--fondo); cursor: pointer; overflow: hidden; }
  .abrir :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(var(--zoom, 1)); transition: opacity 0.6s ease, transform 1s cubic-bezier(0.2, 0.7, 0.2, 1); }
  /* al pasar el cursor: el cuadro colgado en una casa */
  .abrir :global(img.otra) { opacity: 0; }
  .abrir:hover :global(img.otra), .abrir:focus-visible :global(img.otra) { opacity: 1; }
  .abrir:hover :global(img) { transform: scale(calc(var(--zoom, 1) * 1.03)); }
  .pie { display: grid; grid-template-columns: 1fr auto; gap: 0.15rem 1rem; margin-top: 0.8rem; }
  .pie p { margin: 0; }
  .titulo { font-size: 0.8rem; }
  .datos { grid-column: 1; color: var(--texto-tenue); }
  .pie .estado { grid-column: 2; grid-row: 1; justify-self: end; }

  @media (max-width: 1100px) { .galeria { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 860px) { .galeria { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .galeria { gap: 2rem 0.8rem; }
    .pie { grid-template-columns: 1fr; }
    .pie .estado { grid-column: 1; grid-row: auto; justify-self: start; }
  }

  /* VELO Y FICHA: debajo de la barra de secciones, que sigue visible */
  .velo { position: fixed; inset: var(--alto-cabecera, 64px) 0 0; z-index: 14; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); animation: aparecer 0.35s ease; }
  .visor {
    position: fixed; inset: calc(var(--alto-cabecera, 64px) + 0.8rem) var(--margen) 0.8rem; z-index: 15;
    width: auto; height: auto; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: var(--fondo); color: var(--texto); overflow: hidden;
    box-shadow: 0 20px 60px -30px rgba(0, 0, 0, 0.35);
    font-size: 0.72rem; letter-spacing: 0.01em;
  }
  /* la obra a la izquierda, ocupando todo lo posible; la información a la derecha */
  .visor[open] {
    display: grid; grid-template-columns: minmax(0, 1fr) min(300px, 26vw); grid-template-rows: minmax(0, 1fr) auto;
    grid-template-areas: "escena info" "miniaturas info"; animation: aparecer 0.4s ease;
  }
  @keyframes aparecer { from { opacity: 0; } to { opacity: 1; } }

  .cerrar { position: absolute; top: 1rem; right: 1.4rem; z-index: 3; padding: 0; border: 0; background: none; font: inherit; text-transform: uppercase; color: var(--texto); cursor: pointer; }
  .cerrar:hover { opacity: 0.55; }

  .escena { grid-area: escena; position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; min-height: 0; padding: 1.4rem 0; }
  .lienzo { position: relative; height: 100%; min-height: 0; cursor: pointer; }
  .lienzo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; opacity: 0; transition: opacity 0.35s ease; }
  .lienzo :global(img.activa) { opacity: 1; }
  .flecha { width: 3.2rem; height: 3.2rem; margin: 0 0.6rem; padding: 0; border: 0; border-radius: 50%; background: none; font: inherit; font-size: 1.2rem; color: var(--texto); cursor: pointer; transition: background 0.2s; }
  .flecha:hover { background: rgba(0, 0, 0, 0.05); }

  .miniaturas { grid-area: miniaturas; display: flex; justify-content: center; gap: 0.5rem; padding: 0 1rem 1.2rem; }
  .miniaturas button { width: 52px; height: 52px; padding: 0; border: 1px solid transparent; background: none; cursor: pointer; opacity: 0.5; transition: opacity 0.2s, border-color 0.2s; }
  .miniaturas button:hover, .miniaturas button[aria-pressed='true'] { opacity: 1; border-color: var(--texto); }
  .miniaturas :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* la información: letra pequeña, con jerarquía (título, serie, precio; después los datos y el texto) */
  .info { grid-area: info; align-self: center; max-height: 100%; overflow-y: auto; padding: 3.4rem 1.6rem 1.6rem 0.6rem; }
  .contador { margin: 0 0 1.2rem; color: var(--texto-tenue); font-variant-numeric: tabular-nums; }
  .info h3 { margin: 0 0 0.25rem; font-size: 0.95rem; text-transform: uppercase; }
  .serie-obra { margin: 0 0 0.9rem; color: var(--texto-tenue); text-transform: uppercase; }
  .info .precio { margin: 0 0 1.2rem; font-size: 0.82rem; }
  .info .precio.vendida { font-size: 0.72rem; text-transform: uppercase; }
  .info dl { display: grid; grid-template-columns: auto 1fr; gap: 0.25rem 0.9rem; margin: 0 0 1.2rem; padding-top: 0.9rem; border-top: 1px solid var(--linea); }
  .info dt { color: var(--texto-tenue); text-transform: uppercase; }
  .info dd { margin: 0; }
  .descripcion { margin: 0 0 1.4rem; font-size: 0.76rem; line-height: 1.6; color: var(--texto-suave); }
  .enlace { display: inline-block; padding-bottom: 0.2rem; border-bottom: 1px solid var(--texto); text-transform: uppercase; }
  .enlace:hover { opacity: 0.6; }

  @media (max-width: 760px) {
    .visor { inset: calc(var(--alto-cabecera, 64px) + 0.4rem) 0.4rem 0.4rem; overflow-y: auto; }
    .visor[open] { display: block; }
    .cerrar { top: 0.8rem; right: 1rem; }
    .escena { height: 58svh; padding: 2.6rem 0 0.6rem; grid-template-columns: auto minmax(0, 1fr) auto; }
    .flecha { width: 2.4rem; height: 2.4rem; margin: 0 0.2rem; font-size: 1rem; }
    .miniaturas { padding: 0.4rem 1rem 0.4rem; }
    .info { padding: 1rem 1.2rem 1.6rem; max-height: none; overflow: visible; }
  }
</style>

<script>
  const html = document.documentElement;
  // la altura de la barra de arriba (para colocar la ficha justo debajo)
  const medirCabecera = () => html.style.setProperty('--alto-cabecera', `${document.querySelector<HTMLElement>('.cabecera')?.offsetHeight ?? 64}px`);
  medirCabecera();
  window.addEventListener('resize', medirCabecera);

  const seccion = document.querySelector<HTMLElement>('[data-pintura]')!;
  const cuadros = [...seccion.querySelectorAll<HTMLElement>('[data-cuadro]')];

  // ── LA FICHA DE CADA OBRA ──
  const visores = [...document.querySelectorAll<HTMLDialogElement>('[data-visor]')];
  const velo = document.querySelector<HTMLElement>('[data-velo]')!;
  const visorAbierto = () => visores.find((v) => v.open);
  // las obras que se ven en la galería (según los filtros), en su orden: por ellas se pasa con las flechas
  const visibles = () => cuadros.filter((li) => !li.hidden).map((li) => document.getElementById(li.dataset.obra!) as HTMLDialogElement);

  function mostrarFoto(v: HTMLDialogElement, n: number) {
    const fotos = [...v.querySelectorAll<HTMLElement>('[data-foto]')];
    const i = (n + fotos.length) % fotos.length;
    fotos.forEach((f, j) => f.classList.toggle('activa', j === i));
    v.querySelectorAll<HTMLButtonElement>('[data-ver-foto]').forEach((b, j) => b.setAttribute('aria-pressed', String(j === i)));
    v.dataset.foto = String(i);
  }

  function abrirVisor(v: HTMLDialogElement | undefined) {
    if (!v) return;
    visores.forEach((x) => x !== v && x.open && x.close());
    // las fotos de esta obra se cargan ahora (y se empieza por el cuadro)
    v.querySelectorAll<HTMLImageElement>('img').forEach((img) => (img.loading = 'eager'));
    mostrarFoto(v, 0);
    const lista = visibles();
    const pos = lista.indexOf(v);
    v.querySelector<HTMLElement>('[data-contador]')!.textContent = pos >= 0 ? `${String(pos + 1).padStart(2, '0')} / ${String(lista.length).padStart(2, '0')}` : '';
    // sin "modal": así la barra de secciones de arriba sigue funcionando
    if (!v.open) v.show();
    velo.hidden = false;
  }
  const pasar = (paso: number) => {
    const v = visorAbierto();
    if (!v) return;
    const lista = visibles();
    const pos = lista.indexOf(v);
    abrirVisor(lista[(pos + paso + lista.length) % lista.length]);
  };
  const cerrarTodo = () => { visores.forEach((v) => v.open && v.close()); velo.hidden = true; };
  velo.addEventListener('click', cerrarTodo);
  document.addEventListener('keydown', (e) => {
    if (!visorAbierto()) return;
    if (e.key === 'Escape') cerrarTodo();
    if (e.key === 'ArrowRight') pasar(1);
    if (e.key === 'ArrowLeft') pasar(-1);
  });

  visores.forEach((v) => {
    v.querySelector('[data-siguiente-obra]')!.addEventListener('click', () => pasar(1));
    v.querySelector('[data-anterior-obra]')!.addEventListener('click', () => pasar(-1));
    v.querySelector('[data-cerrar]')!.addEventListener('click', cerrarTodo);
    // las otras fotos de la obra: con las miniaturas, o pulsando sobre la imagen
    v.querySelectorAll<HTMLButtonElement>('[data-ver-foto]').forEach((b) => b.addEventListener('click', () => mostrarFoto(v, Number(b.dataset.verFoto))));
    v.querySelector('.lienzo')!.addEventListener('click', () => mostrarFoto(v, Number(v.dataset.foto ?? 0) + 1));
    // en el móvil: deslizar a los lados pasa de obra
    const escena = v.querySelector<HTMLElement>('[data-escena]')!;
    let x0 = 0, y0 = 0;
    escena.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
    escena.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) pasar(dx < 0 ? 1 : -1);
    });
  });

  // ── filtros ──
  const botonesSerie = [...seccion.querySelectorAll<HTMLButtonElement>('[data-serie]')].filter((b) => b.tagName === 'BUTTON');
  const disponibles = seccion.querySelector<HTMLInputElement>('[data-disponibles]')!;
  let serie = 'todas';
  const filtrar = () => {
    cuadros.forEach((li) => (li.hidden = !((serie === 'todas' || li.dataset.serie === serie) && !(disponibles.checked && li.hasAttribute('data-vendida')))));
  };
  botonesSerie.forEach((b) => b.addEventListener('click', () => {
    serie = b.dataset.serie!;
    botonesSerie.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    filtrar();
  }));
  disponibles.addEventListener('change', filtrar);

  // botones de la galería
  seccion.querySelectorAll<HTMLButtonElement>('[data-abrir]').forEach((b) => b.addEventListener('click', () => abrirVisor(document.getElementById(b.dataset.abrir!) as HTMLDialogElement)));

  // si se llega con un enlace a una obra (p. ej. desde la home), se abre directamente
  if (location.hash.startsWith('#obra-')) setTimeout(() => abrirVisor(document.getElementById(location.hash.slice(1)) as HTMLDialogElement), 300);
</script>
