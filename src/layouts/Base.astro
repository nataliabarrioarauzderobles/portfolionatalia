---
// PLANTILLA BASE: todas las páginas se construyen dentro de esta.
// Aquí está lo que comparten: <head>, tipografías, cabecera y pie.
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import Cargador from '../components/Cargador.astro';
import { textos, type Idioma } from '../i18n/textos';
import { url } from '../utils/enlaces';

interface Props {
  idioma: Idioma;
  pagina: '' | 'pintura' | 'diseno' | 'encargos' | 'contacto'; // para el menú y el cambio de idioma
  titulo?: string;
}
const { idioma, pagina, titulo } = Astro.props;
const t = textos[idioma];
const tituloCompleto = titulo ? `${titulo} — Natalia Barrio Araúz de Robles` : 'Natalia Barrio Araúz de Robles';
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={t.descripcionWeb} />
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Instrument+Serif:ital@0;1&display=swap"
    />
    <!-- marca que hay JavaScript: solo entonces se ocultan los elementos que "aparecen" al hacer scroll -->
    <script is:inline>
      document.documentElement.classList.add('js');
      // la pantalla de entrada (contador) solo sale la primera vez en la visita
      try { if (sessionStorage.getItem('natalia-visto')) document.documentElement.classList.add('sin-cargador'); else document.documentElement.classList.add('cargando'); } catch (e) { document.documentElement.classList.add('sin-cargador'); }
    </script>
  </head>
  <body>
    <Cargador />
    <Cabecera idioma={idioma} pagina={pagina} />
    <main>
      <slot />
    </main>
    <Pie idioma={idioma} />
  </body>
</html>

<script>
  // APARECER: los elementos con data-aparece se muestran suavemente al entrar en pantalla
  const elementos = document.querySelectorAll<HTMLElement>('[data-aparece]');
  if (!('IntersectionObserver' in window)) {
    elementos.forEach((el) => el.classList.add('visible'));
  } else {
    const observador = new IntersectionObserver(
      (entradas) => entradas.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('visible'); observador.unobserve(e.target); }
      }),
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );
    elementos.forEach((el) => observador.observe(el));
  }
</script>
