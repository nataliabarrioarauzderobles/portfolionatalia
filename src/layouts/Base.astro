---
// PLANTILLA BASE: todas las páginas se construyen dentro de esta.
// Aquí está lo que comparten: <head>, tipografías, cabecera y pie.
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { textos, type Idioma } from '../i18n/textos';
import { url } from '../utils/enlaces';

interface Props {
  idioma: Idioma;
  pagina: '' | 'pintura' | 'diseno' | 'contacto'; // para el menú y el cambio de idioma
  titulo?: string;
}
const { idioma, pagina, titulo } = Astro.props;
const t = textos[idioma];
const tituloCompleto = titulo ? `${titulo} — Natalia Barrio Araúz de Robles` : 'Natalia Barrio Araúz de Robles';
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={t.descripcionWeb} />
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500&family=Geist+Mono:wght@400&family=Schibsted+Grotesk:wght@400;500&display=swap"
    />
  </head>
  <body>
    <Cabecera idioma={idioma} pagina={pagina} />
    <main>
      <slot />
    </main>
    <Pie idioma={idioma} />
  </body>
</html>
